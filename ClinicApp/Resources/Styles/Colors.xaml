<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

	<!-- ═══════════════════════════════════════════════════════════
	     BRAND COLORS — MLC Clinic (Green + Gold)
	     Primary   = Forest green  #2E7D32
	     Secondary = Pale green tint  #EEF5EE  (replaces pink wash)
	     Tertiary  = Deep green  #1B5E20
	═══════════════════════════════════════════════════════════ -->

	<!-- Brand colors -->
	<Color x:Key="Primary">#2E7D32</Color>
	<Color x:Key="PrimaryDark">#1B5E20</Color>
	<Color x:Key="PrimaryDarkText">#242424</Color>
	<Color x:Key="Secondary">#EEF5EE</Color>
	<Color x:Key="SecondaryDarkText">#2E7D32</Color>
	<Color x:Key="Tertiary">#1B5E20</Color>

	<!-- Alias used by FormStyles.xaml. NOTE: PatientStyles.xaml used to
	     define its OWN PrimaryGreen at #1A6B2F — a second, slightly
	     different green under the same key name. Removed there; #2E7D32
	     (this one) is now the single source of truth app-wide. -->
	<Color x:Key="PrimaryGreen">#2E7D32</Color>

	<!-- Accent gold (from logo) — use sparingly for highlights -->
	<Color x:Key="Gold">#C8A84B</Color>
	<Color x:Key="GoldLight">#FBF4E0</Color>

	<!-- Neutral card background for Appointment list cards (test — was per-status StatusBgColor) -->
	<Color x:Key="AppointmentCardBg">#F5F0D0</Color>

	<!-- ═══════════════════════════════════════════════════════════
	     SEMANTIC TEXT COLORS — moved here from PatientStyles.xaml.
	     FormStyles.xaml, PatientStyles.xaml, and (formerly) SupplyStyles
	     all referenced TextPrimary/TextMuted, but they only actually
	     existed in PatientStyles.xaml — meaning any page using
	     FormStyles.xaml without PatientStyles.xaml also merged would
	     throw a "resource not found" exception. Promoting them here
	     (values unchanged) fixes that hidden dependency for good.
	═══════════════════════════════════════════════════════════ -->
	<Color x:Key="TextPrimary">#1A1A2E</Color>
	<Color x:Key="TextSecondary">#6B7280</Color>
	<Color x:Key="TextMuted">#B0B7C3</Color>
	<Color x:Key="TextOnPrimary">#FFFFFF</Color>

	<!-- Page background used across Patient/Supply pages — same story as
	     TextPrimary/TextMuted above, promoted here so it's safely
	     available regardless of which feature dictionaries are merged. -->
	<Color x:Key="PageBg">#FFFFFF</Color>

	<!-- ═══════════════════════════════════════════════════════════
	     STATUS COLORS — moved here from SupplyStyles.xaml (now removed).
	     Not actually supply-specific: "good / low / out" is a generic
	     3-state status pattern any module can use.
	═══════════════════════════════════════════════════════════ -->
	<Color x:Key="StatusGood">#388E3C</Color>
	<Color x:Key="StatusLow">#F57C00</Color>
	<Color x:Key="StatusOut">#D32F2F</Color>

	<!-- Base -->
	<Color x:Key="White">White</Color>
	<Color x:Key="Black">Black</Color>
	<Color x:Key="Magenta">#D600AA</Color>
	<Color x:Key="MidnightBlue">#190649</Color>
	<Color x:Key="OffBlack">#1f1f1f</Color>

	<!-- Full gray scale — no gaps -->
	<Color x:Key="Gray100">#E1E1E1</Color>
	<Color x:Key="Gray200">#C8C8C8</Color>
	<Color x:Key="Gray300">#ACACAC</Color>
	<Color x:Key="Gray400">#919191</Color>
	<Color x:Key="Gray500">#6E6E6E</Color>
	<Color x:Key="Gray600">#404040</Color>
	<Color x:Key="Gray700">#2E2E2E</Color>
	<Color x:Key="Gray800">#1A1A1A</Color>
	<Color x:Key="Gray900">#212121</Color>
	<Color x:Key="Gray950">#141414</Color>

	<!-- Brushes -->
	<SolidColorBrush x:Key="PrimaryBrush"   Color="{StaticResource Primary}"/>
	<SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
	<SolidColorBrush x:Key="TertiaryBrush"  Color="{StaticResource Tertiary}"/>
	<SolidColorBrush x:Key="GoldBrush"      Color="{StaticResource Gold}"/>
	<SolidColorBrush x:Key="WhiteBrush"     Color="{StaticResource White}"/>
	<SolidColorBrush x:Key="BlackBrush"     Color="{StaticResource Black}"/>
	<SolidColorBrush x:Key="Gray100Brush"   Color="{StaticResource Gray100}"/>
	<SolidColorBrush x:Key="Gray200Brush"   Color="{StaticResource Gray200}"/>
	<SolidColorBrush x:Key="Gray300Brush"   Color="{StaticResource Gray300}"/>
	<SolidColorBrush x:Key="Gray400Brush"   Color="{StaticResource Gray400}"/>
	<SolidColorBrush x:Key="Gray500Brush"   Color="{StaticResource Gray500}"/>
	<SolidColorBrush x:Key="Gray600Brush"   Color="{StaticResource Gray600}"/>
	<SolidColorBrush x:Key="Gray700Brush"   Color="{StaticResource Gray700}"/>
	<SolidColorBrush x:Key="Gray800Brush"   Color="{StaticResource Gray800}"/>
	<SolidColorBrush x:Key="Gray900Brush"   Color="{StaticResource Gray900}"/>
	<SolidColorBrush x:Key="Gray950Brush"   Color="{StaticResource Gray950}"/>

</ResourceDictionary>
