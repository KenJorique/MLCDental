<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<!-- ══════════════════════════════════════════
	     MLC CLINIC — GREEN PALETTE
	     Used across all pages. Keep in sync with Colors.xaml.
	     NOTE: PrimaryGreen, TextPrimary/TextSecondary/TextMuted/
	     TextOnPrimary, and PageBg used to be defined here — moved to
	     Colors.xaml since FormStyles.xaml (and other pages) depended on
	     them but they weren't safely available unless PatientStyles.xaml
	     happened to be merged too. PrimaryGreen was also defined here at
	     a DIFFERENT value (#1A6B2F) than Colors.xaml's (#2E7D32) — that
	     conflict is now resolved; #2E7D32 is the only definition,
	     app-wide.

	     CardBorder / BorderColor (identical value, #C4DEC9) have been
	     consolidated into one shared CardBorderColor key in Styles.xaml.
	══════════════════════════════════════════════ -->

	<!-- Brand greens specific to Patient screens -->
	<Color x:Key="LightGreen">#EAF4EC</Color>
	<Color x:Key="MediumGreen">#B8DEC0</Color>

	<!-- Backgrounds -->
	<!-- SurfaceBg used to be its own near-duplicate pale green (#F0F7F1),
	     visually indistinguishable from Colors.xaml's Secondary
	     (#EEF5EE). Per your preference, it's now the same value as
	     Secondary rather than a second, separately-maintained tone —
	     kept as its own key (rather than deleted outright) since I don't
	     have visibility into every page that references "SurfaceBg" by
	     name; this avoids a broken StaticResource lookup while still
	     eliminating the two-nearly-identical-colors problem. If you'd
	     rather fully remove the key, a project-wide find of "SurfaceBg"
	     → replace with "Secondary" is all that's left to do. -->
	<Color x:Key="SurfaceBg">#EEF5EE</Color>
	<Color x:Key="CardBg">#FFFFFF</Color>
	<Color x:Key="Divider">#DCF0E2</Color>

	<!-- ══════════════════════════════════════════
	     TYPOGRAPHY
	══════════════════════════════════════════════ -->
	<Style x:Key="SectionTitleStyle" TargetType="Label">
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontAttributes" Value="Bold"/>
		<Setter Property="TextColor" Value="{StaticResource PrimaryGreen}"/>
		<Setter Property="Margin" Value="0,0,0,12"/>
	</Style>

	<Style x:Key="RowLabelStyle" TargetType="Label">
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
		<Setter Property="VerticalOptions" Value="Center"/>
	</Style>

	<Style x:Key="RowValueStyle" TargetType="Label">
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
		<Setter Property="FontAttributes" Value="Bold"/>
		<Setter Property="VerticalOptions" Value="Center"/>
		<Setter Property="HorizontalTextAlignment" Value="End"/>
		<Setter Property="LineBreakMode" Value="WordWrap"/>
	</Style>

	<Style x:Key="BodyStyle" TargetType="Label">
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
	</Style>

	<Style x:Key="CaptionStyle" TargetType="Label">
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="TextColor" Value="{StaticResource TextMuted}"/>
	</Style>

	<!-- ══════════════════════════════════════════
	     CARDS
	══════════════════════════════════════════════ -->
	<Style x:Key="CardStyle" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource CardBg}"/>
		<Setter Property="Stroke" Value="{StaticResource CardBorderColor}"/>
		<Setter Property="StrokeThickness" Value="1"/>
		<Setter Property="Padding" Value="16"/>
		<Setter Property="Margin" Value="0,0,0,12"/>
	</Style>

	<Style x:Key="DetailCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}"/>

	<!-- ══════════════════════════════════════════
	     INPUTS
	══════════════════════════════════════════════ -->
	<Style x:Key="EntryStyle" TargetType="Entry">
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
		<Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}"/>
		<Setter Property="MinimumHeightRequest" Value="44"/>
		<Setter Property="BackgroundColor" Value="Transparent"/>
		<Setter Property="Keyboard" Value="Text"/>
	</Style>

	<!-- ══════════════════════════════════════════
	     BUTTONS
	══════════════════════════════════════════════ -->
	<Style x:Key="PrimaryButtonStyle" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{StaticResource PrimaryGreen}"/>
		<Setter Property="TextColor" Value="{StaticResource TextOnPrimary}"/>
		<Setter Property="FontSize" Value="16"/>
		<Setter Property="FontAttributes" Value="Bold"/>
		<Setter Property="CornerRadius" Value="14"/>
		<Setter Property="HeightRequest" Value="52"/>
		<Setter Property="HorizontalOptions" Value="Fill"/>
	</Style>

	<Style x:Key="FabStyle" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{StaticResource PrimaryGreen}"/>
		<Setter Property="TextColor" Value="{StaticResource TextOnPrimary}"/>
		<Setter Property="CornerRadius" Value="28"/>
		<Setter Property="Padding" Value="20,12"/>
		<Setter Property="FontAttributes" Value="Bold"/>
		<Setter Property="FontSize" Value="14"/>
	</Style>

	<Style x:Key="SortButtonStyle" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{StaticResource CardBg}"/>
		<Setter Property="TextColor" Value="{StaticResource PrimaryGreen}"/>
		<Setter Property="BorderColor" Value="{StaticResource CardBorderColor}"/>
		<Setter Property="BorderWidth" Value="1"/>
		<Setter Property="CornerRadius" Value="12"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="FontAttributes" Value="Bold"/>
	</Style>

	<!-- ══════════════════════════════════════════
	     PATIENT LIST
	══════════════════════════════════════════════ -->
	<Style x:Key="PatientNameStyle" TargetType="Label">
		<Setter Property="FontSize" Value="15"/>
		<Setter Property="FontAttributes" Value="Bold"/>
		<Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
		<Setter Property="LineBreakMode" Value="TailTruncation"/>
	</Style>

	<Style x:Key="PatientCardStyle" TargetType="Frame">
		<Setter Property="BackgroundColor" Value="{StaticResource CardBg}"/>
		<Setter Property="BorderColor" Value="{StaticResource CardBorderColor}"/>
		<Setter Property="CornerRadius" Value="12"/>
		<Setter Property="HasShadow" Value="False"/>
		<Setter Property="Padding" Value="16"/>
		<Setter Property="Margin" Value="0"/>
	</Style>

	<Style x:Key="SectionButtonStyle" TargetType="Frame">
		<Setter Property="BackgroundColor" Value="{StaticResource LightGreen}"/>
		<Setter Property="BorderColor" Value="{StaticResource MediumGreen}"/>
		<Setter Property="CornerRadius" Value="10"/>
		<Setter Property="HasShadow" Value="False"/>
		<Setter Property="Padding" Value="12,10"/>
		<Setter Property="HeightRequest" Value="52"/>
	</Style>

	<Style x:Key="SectionButtonLabelStyle" TargetType="Label">
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="TextColor" Value="{StaticResource PrimaryGreen}"/>
		<Setter Property="FontAttributes" Value="Bold"/>
		<Setter Property="LineBreakMode" Value="WordWrap"/>
		<Setter Property="VerticalOptions" Value="Center"/>
	</Style>

</ResourceDictionary>
