<?xml version="1.0" encoding="utf-8" ?>
 
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             xmlns:converters="clr-namespace:ClinicApp.Converters"
             x:Class="ClinicApp.Views.ReportRelated.ReportsPage"
             Title="Reports"
             Shell.TabBarIsVisible="False"
             Shell.BackgroundColor="{StaticResource Primary}"
             Shell.TitleColor="White"
             Shell.ForegroundColor="White"
             BackgroundColor="{StaticResource PageBg}">

	<Grid RowDefinitions="Auto,Auto,*">

		<!-- ── PERIOD TABS ── -->
		<Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" BackgroundColor="{StaticResource PageBg}">

			<VerticalStackLayout Grid.Column="0" Spacing="0">
				<VerticalStackLayout.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding SetPeriodCommand}" CommandParameter="Daily"/>
				</VerticalStackLayout.GestureRecognizers>
				<Label Text="Daily" Padding="0,12" FontSize="14" HorizontalTextAlignment="Center"
                       TextColor="{StaticResource Gray500}">
					<Label.Triggers>
						<DataTrigger TargetType="Label" Binding="{Binding SelectedPeriod}" Value="Daily">
							<Setter Property="FontAttributes" Value="Bold"/>
							<Setter Property="TextColor" Value="{StaticResource Primary}"/>
						</DataTrigger>
					</Label.Triggers>
				</Label>
				<BoxView HeightRequest="2.5" Color="{StaticResource Gray100}">
					<BoxView.Triggers>
						<DataTrigger TargetType="BoxView" Binding="{Binding SelectedPeriod}" Value="Daily">
							<Setter Property="Color" Value="{StaticResource Primary}"/>
						</DataTrigger>
					</BoxView.Triggers>
				</BoxView>
			</VerticalStackLayout>

			<VerticalStackLayout Grid.Column="1" Spacing="0">
				<VerticalStackLayout.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding SetPeriodCommand}" CommandParameter="Weekly"/>
				</VerticalStackLayout.GestureRecognizers>
				<Label Text="Weekly" Padding="0,12" FontSize="14" HorizontalTextAlignment="Center"
                       TextColor="{StaticResource Gray500}">
					<Label.Triggers>
						<DataTrigger TargetType="Label" Binding="{Binding SelectedPeriod}" Value="Weekly">
							<Setter Property="FontAttributes" Value="Bold"/>
							<Setter Property="TextColor" Value="{StaticResource Primary}"/>
						</DataTrigger>
					</Label.Triggers>
				</Label>
				<BoxView HeightRequest="2.5" Color="{StaticResource Gray100}">
					<BoxView.Triggers>
						<DataTrigger TargetType="BoxView" Binding="{Binding SelectedPeriod}" Value="Weekly">
							<Setter Property="Color" Value="{StaticResource Primary}"/>
						</DataTrigger>
					</BoxView.Triggers>
				</BoxView>
			</VerticalStackLayout>

			<VerticalStackLayout Grid.Column="2" Spacing="0">
				<VerticalStackLayout.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding SetPeriodCommand}" CommandParameter="Monthly"/>
				</VerticalStackLayout.GestureRecognizers>
				<Label Text="Monthly" Padding="0,12" FontSize="14" HorizontalTextAlignment="Center"
                       TextColor="{StaticResource Gray500}">
					<Label.Triggers>
						<DataTrigger TargetType="Label" Binding="{Binding SelectedPeriod}" Value="Monthly">
							<Setter Property="FontAttributes" Value="Bold"/>
							<Setter Property="TextColor" Value="{StaticResource Primary}"/>
						</DataTrigger>
					</Label.Triggers>
				</Label>
				<BoxView HeightRequest="2.5" Color="{StaticResource Gray100}">
					<BoxView.Triggers>
						<DataTrigger TargetType="BoxView" Binding="{Binding SelectedPeriod}" Value="Monthly">
							<Setter Property="Color" Value="{StaticResource Primary}"/>
						</DataTrigger>
					</BoxView.Triggers>
				</BoxView>
			</VerticalStackLayout>

			<!-- Custom — opens the range-picker bottom sheet (code-behind) instead of loading immediately, since there's no default range to show until the user picks one -->
			<VerticalStackLayout Grid.Column="3" Spacing="0">
				<VerticalStackLayout.GestureRecognizers>
					<TapGestureRecognizer Tapped="OnCustomTabTapped"/>
				</VerticalStackLayout.GestureRecognizers>
				<Label Text="Custom" Padding="0,12" FontSize="14" HorizontalTextAlignment="Center"
                       TextColor="{StaticResource Gray500}">
					<Label.Triggers>
						<DataTrigger TargetType="Label" Binding="{Binding SelectedPeriod}" Value="Custom">
							<Setter Property="FontAttributes" Value="Bold"/>
							<Setter Property="TextColor" Value="{StaticResource Primary}"/>
						</DataTrigger>
					</Label.Triggers>
				</Label>
				<BoxView HeightRequest="2.5" Color="{StaticResource Gray100}">
					<BoxView.Triggers>
						<DataTrigger TargetType="BoxView" Binding="{Binding SelectedPeriod}" Value="Custom">
							<Setter Property="Color" Value="{StaticResource Primary}"/>
						</DataTrigger>
					</BoxView.Triggers>
				</BoxView>
			</VerticalStackLayout>

		</Grid>

		<!-- ── DATE RANGE PICKER — Daily/Weekly/Monthly only ── -->
		<Border Grid.Row="1" Style="{StaticResource FormInputBox}" Margin="16,12,16,0"
                IsVisible="{Binding IsCustomPeriodActive, Converter={StaticResource InvertedBoolConverter}}">
			<Picker ItemsSource="{Binding DateOptions}"
                    ItemDisplayBinding="{Binding Label}"
                    SelectedItem="{Binding SelectedDateOption}"
                    TextColor="{StaticResource TextPrimary}"
                    TitleColor="{StaticResource TextMuted}"
                    BackgroundColor="Transparent"
                    FontSize="14"
                    VerticalOptions="Center"/>
		</Border>

		<!-- ── CUSTOM RANGE ROW — shown once a custom range is applied; tap to reopen the picker and choose a different range ── -->
		<Border Grid.Row="1" Style="{StaticResource FormInputBox}" Margin="16,12,16,0"
                IsVisible="{Binding IsCustomPeriodActive}">
			<Border.GestureRecognizers>
				<TapGestureRecognizer Tapped="OnCustomTabTapped"/>
			</Border.GestureRecognizers>
			<Label Text="{Binding DateRangeLabel}" TextColor="{StaticResource TextPrimary}" FontSize="14" VerticalOptions="Center"/>
		</Border>

		<!-- ── REPORT CONTENT ── -->
		<ScrollView Grid.Row="2">
			<VerticalStackLayout Padding="16" Spacing="14">

				<ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}" Margin="0,20,0,0"/>

				<VerticalStackLayout Spacing="14"
                        IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">

					<!-- ══════════════════════════════════════════════════
                         APPOINTMENTS — Summary → Chart → Insight → Table/List
                         ══════════════════════════════════════════════════ -->
					<Border Style="{StaticResource ElevatedCardStyle}">
						<VerticalStackLayout Spacing="10">
							<Label Text="Appointments" Style="{StaticResource CardSectionTitleStyle}"/>

							<!-- Summary — Completed / Pending / Cancelled counts are tappable, each opens an alert listing the specific patients -->
							<Grid ColumnDefinitions="*,*,*,*">
								<VerticalStackLayout>
									<Label Text="{Binding CurrentReport.TotalAppointments}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Center"/>
									<Label Text="Total" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="Center"/>
								</VerticalStackLayout>
								<VerticalStackLayout Grid.Column="1">
									<VerticalStackLayout.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding ShowAppointmentListCommand}" CommandParameter="Completed"/>
									</VerticalStackLayout.GestureRecognizers>
									<Label Text="{Binding CurrentReport.CompletedAppointments}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Center"/>
									<Label Text="Done" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="Center"/>
								</VerticalStackLayout>
								<VerticalStackLayout Grid.Column="2">
									<VerticalStackLayout.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding ShowAppointmentListCommand}" CommandParameter="Pending"/>
									</VerticalStackLayout.GestureRecognizers>
									<Label Text="{Binding CurrentReport.PendingAppointments}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Center"/>
									<Label Text="Pending" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="Center"/>
								</VerticalStackLayout>
								<VerticalStackLayout Grid.Column="3">
									<VerticalStackLayout.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding ShowAppointmentListCommand}" CommandParameter="Cancelled"/>
									</VerticalStackLayout.GestureRecognizers>
									<Label Text="{Binding CurrentReport.CancelledAppointments}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Center"/>
									<Label Text="Cancelled" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="Center"/>
								</VerticalStackLayout>
							</Grid>

							<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

							<!-- Chart -->
							<chart:SfCircularChart HeightRequest="220">
								<chart:SfCircularChart.Legend>
									<chart:ChartLegend Placement="Bottom"/>
								</chart:SfCircularChart.Legend>
								<chart:DoughnutSeries x:Name="AppointmentSeries"
                                                       ItemsSource="{Binding AppointmentChartData}"
                                                       XBindingPath="Label" YBindingPath="Value"
                                                       ShowDataLabels="True">
									<chart:DoughnutSeries.DataLabelSettings>
										<chart:CircularDataLabelSettings LabelPlacement="Outer"/>
									</chart:DoughnutSeries.DataLabelSettings>
								</chart:DoughnutSeries>
							</chart:SfCircularChart>

							<!-- Insight — empty (and hidden) on Daily, where the list below stands in for it -->
							<Border BackgroundColor="{StaticResource Secondary}" Padding="10,8" StrokeThickness="0"
                                    IsVisible="{Binding CurrentReport.AppointmentsInsight, Converter={StaticResource StringNotEmptyConverter}}">
								<Border.StrokeShape>
									<RoundRectangle CornerRadius="8"/>
								</Border.StrokeShape>
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
									<Label Grid.Column="0" Text="&#xe0f0;" FontFamily="MaterialSymbolsRounded" FontSize="16" TextColor="{StaticResource Primary}" VerticalOptions="Start"/>
									<Label Grid.Column="1" Text="{Binding CurrentReport.AppointmentsInsight}" FontSize="12" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" VerticalOptions="Center" LineBreakMode="WordWrap"/>
								</Grid>
							</Border>

							<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

							<!-- DAILY: combined, time-ordered list (Completed/Pending/No-show/Cancelled)-->
							<VerticalStackLayout Spacing="0" IsVisible="{Binding ShowDailyAppointmentList}">
								<Label Text="Today's Appointments" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray500}" Margin="0,0,0,4"/>
								<CollectionView ItemsSource="{Binding TodayAppointmentRows}">
									<CollectionView.EmptyView>
										<Label Text="No appointment activity for this day." Style="{StaticResource MutedCaptionStyle}" Margin="0,10"/>
									</CollectionView.EmptyView>
									<CollectionView.ItemTemplate>
										<DataTemplate>
											<VerticalStackLayout>
												<Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="8" Padding="0,8">
													<Label Grid.Column="0" Text="{Binding TimeLabel}" FontSize="12" TextColor="{StaticResource Gray500}" VerticalOptions="Center"/>
													<Label Grid.Column="1" Text="{Binding PatientName}" FontSize="13" TextColor="{StaticResource Gray900}" VerticalOptions="Center" LineBreakMode="WordWrap"/>
													<Border Grid.Column="2" BackgroundColor="{Binding StatusBgColor}" Padding="8,3" StrokeThickness="0" VerticalOptions="Center">
														<Border.StrokeShape>
															<RoundRectangle CornerRadius="10"/>
														</Border.StrokeShape>
														<Label Text="{Binding StatusLabel}" FontSize="10" FontAttributes="Bold" TextColor="{Binding StatusColor}"/>
													</Border>
												</Grid>
												<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>
											</VerticalStackLayout>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>
							</VerticalStackLayout>

							<!-- WEEKLY: Day | Completed | Cancelled — one row per specific calendar day, Mon–Sat -->
							<VerticalStackLayout Spacing="0" IsVisible="{Binding ShowWeeklyAppointmentTable}">
								<Grid ColumnDefinitions="2*,1*,1*" Padding="0,0,0,6">
									<Label Grid.Column="0" Text="Day" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}"/>
									<Label Grid.Column="1" Text="Completed" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="End"/>
									<Label Grid.Column="2" Text="Cancelled" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="End"/>
								</Grid>
								<BoxView HeightRequest="1" Color="{StaticResource Gray200}"/>
								<CollectionView ItemsSource="{Binding AppointmentWeeklyRows}">
									<CollectionView.EmptyView>
										<Label Text="No appointment activity yet this week." Style="{StaticResource MutedCaptionStyle}" Margin="0,10"/>
									</CollectionView.EmptyView>
									<CollectionView.ItemTemplate>
										<DataTemplate>
											<VerticalStackLayout>
												<Grid ColumnDefinitions="2*,1*,1*" Padding="0,8">
													<Label Grid.Column="0" Text="{Binding DayLabel}" FontSize="13" TextColor="{StaticResource Gray900}" LineBreakMode="WordWrap" VerticalOptions="Center"/>
													<Label Grid.Column="1" Text="{Binding Completed}" FontSize="13" TextColor="{StaticResource Primary}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
													<Label Grid.Column="2" Text="{Binding Cancelled}" FontSize="13" TextColor="{StaticResource StatusOut}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
												</Grid>
												<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>
											</VerticalStackLayout>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>
							</VerticalStackLayout>

							<!-- MONTHLY: Day | Completed | Cancelled — but "Day" is a WEEKDAY NAME, totals summed across the whole month. Fixed 6 rows (Mon–Sat), same column layout as Weekly above. -->
							<VerticalStackLayout Spacing="0" IsVisible="{Binding ShowMonthlyAppointmentTable}">
								<Grid ColumnDefinitions="2*,1*,1*" Padding="0,0,0,6">
									<Label Grid.Column="0" Text="Day" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}"/>
									<Label Grid.Column="1" Text="Completed" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="End"/>
									<Label Grid.Column="2" Text="Cancelled" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="End"/>
								</Grid>
								<BoxView HeightRequest="1" Color="{StaticResource Gray200}"/>
								<CollectionView ItemsSource="{Binding AppointmentMonthlyRows}">
									<CollectionView.EmptyView>
										<Label Text="No appointment activity yet this month." Style="{StaticResource MutedCaptionStyle}" Margin="0,10"/>
									</CollectionView.EmptyView>
									<CollectionView.ItemTemplate>
										<DataTemplate>
											<VerticalStackLayout>
												<Grid ColumnDefinitions="2*,1*,1*" Padding="0,8">
													<Label Grid.Column="0" Text="{Binding DayLabel}" FontSize="13" TextColor="{StaticResource Gray900}" LineBreakMode="WordWrap" VerticalOptions="Center"/>
													<Label Grid.Column="1" Text="{Binding Completed}" FontSize="13" TextColor="{StaticResource Primary}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
													<Label Grid.Column="2" Text="{Binding Cancelled}" FontSize="13" TextColor="{StaticResource StatusOut}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
												</Grid>
												<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>
											</VerticalStackLayout>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>
							</VerticalStackLayout>

						</VerticalStackLayout>
					</Border>

					<!-- ══════════════════════════════════════════════════
                         TREATMENTS — Summary → Chart → Insight → Table
                         ══════════════════════════════════════════════════ -->
					<Border Style="{StaticResource ElevatedCardStyle}">
						<VerticalStackLayout Spacing="10">
							<Label Text="Treatments" Style="{StaticResource CardSectionTitleStyle}"/>

							<!-- Summary — just the total; "most common" now lives in the insight below instead of being duplicated here -->
							<VerticalStackLayout HorizontalOptions="Start">
								<Label Text="{Binding CurrentReport.TotalTreatments}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Start"/>
								<Label Text="Total Treatments" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="Start"/>
							</VerticalStackLayout>

							<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

							<!-- Chart -->
							<chart:SfCartesianChart HeightRequest="{Binding TreatmentsChartHeight}" IsTransposed="True">
								<chart:SfCartesianChart.XAxes>
									<!-- Long service names wrap onto a 2nd line instead of stretching the axis wide -->
									<chart:CategoryAxis LabelsIntersectAction="Wrap">
										<chart:CategoryAxis.LabelStyle>
											<chart:ChartAxisLabelStyle MaxWidth="110"/>
										</chart:CategoryAxis.LabelStyle>
									</chart:CategoryAxis>
								</chart:SfCartesianChart.XAxes>
								<chart:SfCartesianChart.YAxes>
									<chart:NumericalAxis>
										<chart:NumericalAxis.Title>
											<chart:ChartAxisTitle Text="Count"/>
										</chart:NumericalAxis.Title>
									</chart:NumericalAxis>
								</chart:SfCartesianChart.YAxes>
								<chart:ColumnSeries ItemsSource="{Binding TreatmentChartData}"
                                                  XBindingPath="Label" YBindingPath="Value"
                                                  ShowDataLabels="True">
									<chart:ColumnSeries.Fill>
										<SolidColorBrush Color="{StaticResource Primary}"/>
									</chart:ColumnSeries.Fill>
								</chart:ColumnSeries>
							</chart:SfCartesianChart>

							<!-- Insight -->
							<Border BackgroundColor="{StaticResource Secondary}" Padding="10,8" StrokeThickness="0"
                                    IsVisible="{Binding CurrentReport.TreatmentsInsight, Converter={StaticResource StringNotEmptyConverter}}">
								<Border.StrokeShape>
									<RoundRectangle CornerRadius="8"/>
								</Border.StrokeShape>
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
									<Label Grid.Column="0" Text="&#xe0f0;" FontFamily="MaterialSymbolsRounded" FontSize="16" TextColor="{StaticResource Primary}" VerticalOptions="Start"/>
									<Label Grid.Column="1" Text="{Binding CurrentReport.TreatmentsInsight}" FontSize="12" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" VerticalOptions="Center" LineBreakMode="WordWrap"/>
								</Grid>
							</Border>

							<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

							<!-- Table: Treatment | Count | % of Total — capped to the top 10 categories by count -->
							<VerticalStackLayout Spacing="0">
								<Label Text="Top 10 Treatments" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray500}" Margin="0,0,0,6"/>
								<Grid ColumnDefinitions="2*,1*,1*" Padding="0,0,0,6">
									<Label Grid.Column="0" Text="Treatment" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}"/>
									<Label Grid.Column="1" Text="Count" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="End"/>
									<Label Grid.Column="2" Text="% of Total" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="End"/>
								</Grid>
								<BoxView HeightRequest="1" Color="{StaticResource Gray200}"/>
								<CollectionView ItemsSource="{Binding TreatmentTableRows}">
									<CollectionView.EmptyView>
										<Label Text="No treatments logged yet this period." Style="{StaticResource MutedCaptionStyle}" Margin="0,10"/>
									</CollectionView.EmptyView>
									<CollectionView.ItemTemplate>
										<DataTemplate>
											<VerticalStackLayout>
												<Grid ColumnDefinitions="2*,1*,1*" Padding="0,8">
													<Label Grid.Column="0" Text="{Binding Treatment}" FontSize="13" TextColor="{StaticResource Gray900}" LineBreakMode="WordWrap" VerticalOptions="Center"/>
													<Label Grid.Column="1" Text="{Binding Count}" FontSize="13" TextColor="{StaticResource Gray900}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
													<Label Grid.Column="2" Text="{Binding PercentOfTotal, StringFormat='{0:N0}%'}" FontSize="13" TextColor="{StaticResource Gray900}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
												</Grid>
												<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>
											</VerticalStackLayout>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>
							</VerticalStackLayout>

						</VerticalStackLayout>
					</Border>

					<!-- ══════════════════════════════════════════════════
                         BILLING — Summary → Chart → Insight → Table
                         ══════════════════════════════════════════════════ -->
					<Border Style="{StaticResource ElevatedCardStyle}">
						<VerticalStackLayout Spacing="10">
							<Label Text="Billing" Style="{StaticResource CardSectionTitleStyle}"/>

							<!-- Summary -->
							<Grid ColumnDefinitions="*,*">
								<VerticalStackLayout>
									<Label Text="{Binding CurrentReport.TotalRevenue, StringFormat='₱{0:N2}'}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Start" TextColor="{StaticResource Primary}"/>
									<Label Text="Collected" Style="{StaticResource MutedCaptionStyle}"/>
								</VerticalStackLayout>
								<VerticalStackLayout Grid.Column="1">
									<Label Text="{Binding CurrentReport.OutstandingBalance, StringFormat='₱{0:N2}'}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="End" TextColor="{StaticResource StatusOut}"/>
									<Label Text="Outstanding" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="End"/>
								</VerticalStackLayout>
							</Grid>

							<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

							<!-- Chart — hidden on Daily; with one dentist, revenue-per-hour doesn't show a meaningful trend, just which treatment landed in which hour. Weekly/Monthly keep it since day-to-day revenue trend is meaningful. -->
							<chart:SfCartesianChart HeightRequest="220" IsVisible="{Binding ShowBillingChart}">
								<!-- Tooltip content shown on tap: date/hour + peso amount, styled green to match the line -->
								<chart:SfCartesianChart.Resources>
									<converters:ZeroAmountToVisibilityConverter x:Key="ZeroAmountToVisibilityConverter"/>
									<DataTemplate x:Key="billingTooltipTemplate">
										<Border BackgroundColor="{StaticResource Primary}" Padding="10,6" StrokeThickness="0">
											<Border.StrokeShape>
												<RoundRectangle CornerRadius="8"/>
											</Border.StrokeShape>
											<VerticalStackLayout Spacing="2">
												<Label Text="{Binding Item.Label}" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center"/>
												<Label Text="{Binding Item.Value, StringFormat='₱{0:N0}'}" TextColor="White" FontSize="12" HorizontalTextAlignment="Center"/>
											</VerticalStackLayout>
										</Border>
									</DataTemplate>
									<!-- Same green pill look as the default data label, but IsVisible is bound so ₱0 points render nothing -->
									<DataTemplate x:Key="billingLabelTemplate">
										<Border BackgroundColor="{StaticResource Primary}" Padding="8,3" StrokeThickness="0"
                                                IsVisible="{Binding Item.Value, Converter={StaticResource ZeroAmountToVisibilityConverter}}">
											<Border.StrokeShape>
												<RoundRectangle CornerRadius="10"/>
											</Border.StrokeShape>
											<Label Text="{Binding Item.Value, StringFormat='₱{0:N0}'}" TextColor="White" FontSize="11" FontAttributes="Bold"/>
										</Border>
									</DataTemplate>
								</chart:SfCartesianChart.Resources>
								<!-- Transparent so only our green Border template shows, not Syncfusion's default backdrop -->
								<chart:SfCartesianChart.TooltipBehavior>
									<chart:ChartTooltipBehavior Background="Transparent"/>
								</chart:SfCartesianChart.TooltipBehavior>
								<chart:SfCartesianChart.XAxes>
									<chart:CategoryAxis>
										<chart:CategoryAxis.Title>
											<!-- Says "Hour" on Daily, "Date" on Weekly/Monthly -->
											<chart:ChartAxisTitle Text="{Binding BillingAxisTitle}"/>
										</chart:CategoryAxis.Title>
									</chart:CategoryAxis>
								</chart:SfCartesianChart.XAxes>
								<chart:SfCartesianChart.YAxes>
									<chart:NumericalAxis>
										<chart:NumericalAxis.Title>
											<chart:ChartAxisTitle Text="Amount Collected (₱)"/>
										</chart:NumericalAxis.Title>
									</chart:NumericalAxis>
								</chart:SfCartesianChart.YAxes>
								<chart:LineSeries ItemsSource="{Binding BillingChartData}"
								   XBindingPath="Label" YBindingPath="Value"
								   Fill="{StaticResource Primary}"
								   StrokeWidth="3"
								   ShowMarkers="True"
								   EnableTooltip="True"
								   TooltipTemplate="{StaticResource billingTooltipTemplate}"
								   LabelTemplate="{StaticResource billingLabelTemplate}"
								   ShowDataLabels="{Binding ShowBillingDataLabels}"/>
							</chart:SfCartesianChart>

							<!-- Insight -->
							<Border BackgroundColor="{StaticResource Secondary}" Padding="10,8" StrokeThickness="0"
                                    IsVisible="{Binding CurrentReport.BillingInsight, Converter={StaticResource StringNotEmptyConverter}}">
								<Border.StrokeShape>
									<RoundRectangle CornerRadius="8"/>
								</Border.StrokeShape>
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
									<Label Grid.Column="0" Text="&#xe0f0;" FontFamily="MaterialSymbolsRounded" FontSize="16" TextColor="{StaticResource Primary}" VerticalOptions="Start"/>
									<Label Grid.Column="1" Text="{Binding CurrentReport.BillingInsight}" FontSize="12" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" VerticalOptions="Center" LineBreakMode="WordWrap"/>
								</Grid>
							</Border>

							<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

							<!-- Table: Top 5 Services by Revenue — the only Billing table; runs every period since it isn't day-bucketed -->
							<VerticalStackLayout Spacing="0">
								<Label Text="Top Services by Revenue" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray500}" Margin="0,0,0,6"/>
								<Grid ColumnDefinitions="2*,1*,1.2*" Padding="0,0,0,6">
									<Label Grid.Column="0" Text="Service" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}"/>
									<Label Grid.Column="1" Text="Times" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="End"/>
									<Label Grid.Column="2" Text="Revenue" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="End"/>
								</Grid>
								<BoxView HeightRequest="1" Color="{StaticResource Gray200}"/>
								<CollectionView ItemsSource="{Binding TopServiceRows}">
									<CollectionView.EmptyView>
										<Label Text="No billed services yet this period." Style="{StaticResource MutedCaptionStyle}" Margin="0,10"/>
									</CollectionView.EmptyView>
									<CollectionView.ItemTemplate>
										<DataTemplate>
											<VerticalStackLayout>
												<Grid ColumnDefinitions="2*,1*,1.2*" Padding="0,8">
													<Label Grid.Column="0" Text="{Binding Service}" FontSize="13" TextColor="{StaticResource Gray900}" LineBreakMode="WordWrap" VerticalOptions="Center"/>
													<Label Grid.Column="1" Text="{Binding TimesBilled}" FontSize="13" TextColor="{StaticResource Gray900}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
													<Label Grid.Column="2" Text="{Binding Revenue, StringFormat='₱{0:N0}'}" FontSize="13" TextColor="{StaticResource Primary}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
												</Grid>
												<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>
											</VerticalStackLayout>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>
							</VerticalStackLayout>

						</VerticalStackLayout>
					</Border>

					<!-- ══════════════════════════════════════════════════
                         MEDICAL SUPPLIES — Summary → Chart → Insight → Table
                         ══════════════════════════════════════════════════ -->
					<Border Style="{StaticResource ElevatedCardStyle}">
						<VerticalStackLayout Spacing="10">
							<Label Text="Medical Supplies" Style="{StaticResource CardSectionTitleStyle}"/>

							<!-- Summary — In Stock / Low / Out of Stock counts are tappable, each opens an alert listing the specific supplies -->
							<Grid ColumnDefinitions="*,*,*,*">
								<VerticalStackLayout>
									<Label Text="{Binding CurrentReport.TotalSupplies}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Center"/>
									<Label Text="Total" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="Center"/>
								</VerticalStackLayout>
								<VerticalStackLayout Grid.Column="1">
									<VerticalStackLayout.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding ShowSupplyListCommand}" CommandParameter="In Stock"/>
									</VerticalStackLayout.GestureRecognizers>
									<Label Text="{Binding CurrentReport.InStockCount}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Center" TextColor="{StaticResource Primary}"/>
									<Label Text="In Stock" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="Center"/>
								</VerticalStackLayout>
								<VerticalStackLayout Grid.Column="2">
									<VerticalStackLayout.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding ShowSupplyListCommand}" CommandParameter="Low Stock"/>
									</VerticalStackLayout.GestureRecognizers>
									<Label Text="{Binding CurrentReport.LowStockItemCount}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Center" TextColor="{StaticResource StatusLow}"/>
									<Label Text="Low" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="Center"/>
								</VerticalStackLayout>
								<VerticalStackLayout Grid.Column="3">
									<VerticalStackLayout.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding ShowSupplyListCommand}" CommandParameter="Out of Stock"/>
									</VerticalStackLayout.GestureRecognizers>
									<Label Text="{Binding CurrentReport.OutOfStockCount}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Center" TextColor="{StaticResource StatusOut}"/>
									<Label Text="Out" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="Center"/>
								</VerticalStackLayout>
							</Grid>

							<!-- Movement THIS period, from supply_stock_logs -->
							<Grid ColumnDefinitions="*,*">
								<VerticalStackLayout>
									<Label Text="{Binding CurrentReport.PiecesRestocked, StringFormat='+{0}'}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Start" TextColor="{StaticResource Primary}"/>
									<Label Text="Restocked this period" Style="{StaticResource MutedCaptionStyle}"/>
								</VerticalStackLayout>
								<VerticalStackLayout Grid.Column="1">
									<Label Text="{Binding CurrentReport.PiecesUsed, StringFormat='-{0}'}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="End" TextColor="{StaticResource StatusOut}"/>
									<Label Text="Used this period" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="End"/>
								</VerticalStackLayout>
							</Grid>

							<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

							<!-- Chart -->
							<chart:SfCircularChart HeightRequest="220">
								<chart:SfCircularChart.Legend>
									<chart:ChartLegend Placement="Bottom"/>
								</chart:SfCircularChart.Legend>
								<chart:DoughnutSeries x:Name="SupplyChartSeries"
                                                       ItemsSource="{Binding SupplyChartData}"
                                                       XBindingPath="Label" YBindingPath="Value"
                                                       ShowDataLabels="True">
									<chart:DoughnutSeries.DataLabelSettings>
										<chart:CircularDataLabelSettings LabelPlacement="Outer"/>
									</chart:DoughnutSeries.DataLabelSettings>
								</chart:DoughnutSeries>
							</chart:SfCircularChart>

							<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

							<!-- Insight -->
							<Border BackgroundColor="{StaticResource Secondary}" Padding="10,8" StrokeThickness="0"
                                    IsVisible="{Binding CurrentReport.SuppliesInsight, Converter={StaticResource StringNotEmptyConverter}}">
								<Border.StrokeShape>
									<RoundRectangle CornerRadius="8"/>
								</Border.StrokeShape>
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
									<Label Grid.Column="0" Text="&#xe0f0;" FontFamily="MaterialSymbolsRounded" FontSize="16" TextColor="{StaticResource Primary}" VerticalOptions="Start"/>
									<Label Grid.Column="1" Text="{Binding CurrentReport.SuppliesInsight}" FontSize="12" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" VerticalOptions="Center" LineBreakMode="WordWrap"/>
								</Grid>
							</Border>

							<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

							<!-- Table: Name | Used | Restocked, ranked by most used -->
							<VerticalStackLayout Spacing="0">
								<Label Text="Most Used Supplies" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray500}" Margin="0,0,0,6"/>
								<Grid ColumnDefinitions="2*,1*,1*" Padding="0,0,0,6">
									<Label Grid.Column="0" Text="Name" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}"/>
									<Label Grid.Column="1" Text="Used" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="End"/>
									<Label Grid.Column="2" Text="Restocked" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="End"/>
								</Grid>
								<BoxView HeightRequest="1" Color="{StaticResource Gray200}"/>
								<CollectionView ItemsSource="{Binding SupplyUsageRows}">
									<CollectionView.EmptyView>
										<Label Text="No supply movement recorded yet this period." Style="{StaticResource MutedCaptionStyle}" Margin="0,10"/>
									</CollectionView.EmptyView>
									<CollectionView.ItemTemplate>
										<DataTemplate>
											<VerticalStackLayout>
												<Grid ColumnDefinitions="2*,1*,1*" Padding="0,8">
													<Label Grid.Column="0" Text="{Binding Name}" FontSize="13" TextColor="{StaticResource Gray900}" LineBreakMode="WordWrap" VerticalOptions="Center"/>
													<Label Grid.Column="1" Text="{Binding Used}" FontSize="13" TextColor="{StaticResource StatusOut}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
													<Label Grid.Column="2" Text="{Binding Restocked}" FontSize="13" TextColor="{StaticResource Primary}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
												</Grid>
												<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>
											</VerticalStackLayout>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>
							</VerticalStackLayout>

						</VerticalStackLayout>
					</Border>

				</VerticalStackLayout>
			</VerticalStackLayout>
		</ScrollView>

	</Grid>
</ContentPage>
