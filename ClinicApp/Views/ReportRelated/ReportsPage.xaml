<?xml version="1.0" encoding="utf-8" ?>
<!--
  HOW THIS PAGE IS LAID OUT
  1. Tab bar at top (Daily / Weekly / Monthly) — tapping one calls
     SetPeriodCommand, which rebuilds the dropdown below it.
  2. Dropdown (Picker) — shows the periods actually available for the
     selected tab (e.g. "Aug 20", "This Week"), capped by how much
     real data exists. Picking one loads that period's report.
  3. Five report cards, each: title, a real Syncfusion chart (with its
     own legend/axes/data labels — nothing hand-drawn), then a compact
     number summary row below. All reuse the app's existing
     ElevatedCardStyle/CardSectionTitleStyle/etc. from Styles.xaml
     rather than defining new card styles here.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             x:Class="ClinicApp.Views.ReportRelated.ReportsPage"
             Title="Reports"
             BackgroundColor="{StaticResource PageBg}">

	<Grid RowDefinitions="Auto,Auto,*">

		<!-- ── PERIOD TABS ── -->
		<Grid Grid.Row="0" ColumnDefinitions="*,*,*" BackgroundColor="{StaticResource Primary}">

			<VerticalStackLayout Grid.Column="0" Padding="0,14,0,10" Spacing="6">
				<VerticalStackLayout.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding SetPeriodCommand}" CommandParameter="Daily"/>
				</VerticalStackLayout.GestureRecognizers>
				<Label Text="DAILY" FontSize="13" FontAttributes="Bold"
                       TextColor="White" HorizontalTextAlignment="Center"/>
				<BoxView HeightRequest="3" Color="Transparent">
					<BoxView.Triggers>
						<DataTrigger TargetType="BoxView" Binding="{Binding SelectedPeriod}" Value="Daily">
							<Setter Property="Color" Value="{StaticResource Gold}"/>
						</DataTrigger>
					</BoxView.Triggers>
				</BoxView>
			</VerticalStackLayout>

			<VerticalStackLayout Grid.Column="1" Padding="0,14,0,10" Spacing="6">
				<VerticalStackLayout.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding SetPeriodCommand}" CommandParameter="Weekly"/>
				</VerticalStackLayout.GestureRecognizers>
				<Label Text="WEEKLY" FontSize="13" FontAttributes="Bold"
                       TextColor="White" HorizontalTextAlignment="Center"/>
				<BoxView HeightRequest="3" Color="Transparent">
					<BoxView.Triggers>
						<DataTrigger TargetType="BoxView" Binding="{Binding SelectedPeriod}" Value="Weekly">
							<Setter Property="Color" Value="{StaticResource Gold}"/>
						</DataTrigger>
					</BoxView.Triggers>
				</BoxView>
			</VerticalStackLayout>

			<VerticalStackLayout Grid.Column="2" Padding="0,14,0,10" Spacing="6">
				<VerticalStackLayout.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding SetPeriodCommand}" CommandParameter="Monthly"/>
				</VerticalStackLayout.GestureRecognizers>
				<Label Text="MONTHLY" FontSize="13" FontAttributes="Bold"
                       TextColor="White" HorizontalTextAlignment="Center"/>
				<BoxView HeightRequest="3" Color="Transparent">
					<BoxView.Triggers>
						<DataTrigger TargetType="BoxView" Binding="{Binding SelectedPeriod}" Value="Monthly">
							<Setter Property="Color" Value="{StaticResource Gold}"/>
						</DataTrigger>
					</BoxView.Triggers>
				</BoxView>
			</VerticalStackLayout>

		</Grid>

		<!-- ── DATE RANGE PICKER ── -->
		<Border Grid.Row="1"
                BackgroundColor="{StaticResource White}"
                Stroke="{StaticResource Gray100}"
                StrokeThickness="1"
                Padding="16,10"
                Margin="16,12,16,0">
			<Border.StrokeShape>
				<RoundRectangle CornerRadius="12"/>
			</Border.StrokeShape>
			<Picker ItemsSource="{Binding DateOptions}"
                    ItemDisplayBinding="{Binding Label}"
                    SelectedItem="{Binding SelectedDateOption}"
                    TextColor="{StaticResource TextPrimary}"
                    FontAttributes="Bold"
                    FontSize="14"/>
		</Border>

		<!-- ── REPORT CONTENT ── -->
		<ScrollView Grid.Row="2">
			<VerticalStackLayout Padding="16" Spacing="14">

				<ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}" Margin="0,20,0,0"/>

				<VerticalStackLayout Spacing="14"
                        IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">

					<!-- ── APPOINTMENTS — donut, legend + data labels built in ── -->
					<Border Style="{StaticResource ElevatedCardStyle}">
						<VerticalStackLayout Spacing="10">
							<Label Text="Appointments" Style="{StaticResource CardSectionTitleStyle}"/>

							<chart:SfCircularChart HeightRequest="220">
								<chart:SfCircularChart.Legend>
									<chart:ChartLegend Placement="Bottom"/>
								</chart:SfCircularChart.Legend>
								<chart:DoughnutSeries ItemsSource="{Binding AppointmentChartData}"
                                                       XBindingPath="Label" YBindingPath="Value"
                                                       ShowDataLabels="True">
									<chart:DoughnutSeries.PaletteBrushes>
										<SolidColorBrush Color="{StaticResource Primary}"/>
										<SolidColorBrush Color="{StaticResource StatusLow}"/>
										<SolidColorBrush Color="{StaticResource StatusOut}"/>
									</chart:DoughnutSeries.PaletteBrushes>
									<chart:DoughnutSeries.DataLabelSettings>
										<chart:CircularDataLabelSettings LabelPlacement="Outer"/>
									</chart:DoughnutSeries.DataLabelSettings>
								</chart:DoughnutSeries>
							</chart:SfCircularChart>

							<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

							<!-- Compact summary -->
							<Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto">
								<Label Grid.Row="0" Grid.Column="0" Text="{Binding CurrentReport.TotalAppointments}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Center"/>
								<Label Grid.Row="0" Grid.Column="1" Text="{Binding CurrentReport.CompletedAppointments}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Center"/>
								<Label Grid.Row="0" Grid.Column="2" Text="{Binding CurrentReport.PendingAppointments}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Center"/>
								<Label Grid.Row="0" Grid.Column="3" Text="{Binding CurrentReport.CancelledAppointments}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Center"/>

								<Label Grid.Row="1" Grid.Column="0" Text="Total" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="Center"/>
								<Label Grid.Row="1" Grid.Column="1" Text="Done" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="Center"/>
								<Label Grid.Row="1" Grid.Column="2" Text="Pending" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="Center"/>
								<Label Grid.Row="1" Grid.Column="3" Text="Cancelled" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="Center"/>
							</Grid>
						</VerticalStackLayout>
					</Border>

					<!-- ── TREATMENTS — real horizontal bar chart via IsTransposed ── -->
					<Border Style="{StaticResource ElevatedCardStyle}">
						<VerticalStackLayout Spacing="10">
							<Label Text="Treatments" Style="{StaticResource CardSectionTitleStyle}"/>

							<chart:SfCartesianChart HeightRequest="240" IsTransposed="True">
								<chart:SfCartesianChart.XAxes>
									<chart:CategoryAxis/>
								</chart:SfCartesianChart.XAxes>
								<chart:SfCartesianChart.YAxes>
									<chart:NumericalAxis>
										<chart:NumericalAxis.Title>
											<chart:ChartAxisTitle Text="Count"/>
										</chart:NumericalAxis.Title>
									</chart:NumericalAxis>
								</chart:SfCartesianChart.YAxes>
								<chart:ColumnSeries ItemsSource="{Binding TreatmentChartData}"
                                                  XBindingPath="Label" YBindingPath="Value"
                                                  ShowDataLabels="True">
									<chart:ColumnSeries.Fill>
										<SolidColorBrush Color="{StaticResource Primary}"/>
									</chart:ColumnSeries.Fill>
								</chart:ColumnSeries>
							</chart:SfCartesianChart>

							<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

							<Grid ColumnDefinitions="*,*">
								<VerticalStackLayout>
									<Label Text="{Binding CurrentReport.TotalTreatments}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Start"/>
									<Label Text="Total Treatments" Style="{StaticResource MutedCaptionStyle}"/>
								</VerticalStackLayout>
								<VerticalStackLayout Grid.Column="1">
									<Label Text="{Binding CurrentReport.MostCommonTreatment}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="End" LineBreakMode="TailTruncation"/>
									<Label Text="Most Common" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="End"/>
								</VerticalStackLayout>
							</Grid>
						</VerticalStackLayout>
					</Border>

					<!-- ── BILLING — line chart, real X (date) / Y (amount) axes ── -->
					<Border Style="{StaticResource ElevatedCardStyle}">
						<VerticalStackLayout Spacing="10">
							<Label Text="Billing" Style="{StaticResource CardSectionTitleStyle}"/>

							<chart:SfCartesianChart HeightRequest="220">
								<chart:SfCartesianChart.XAxes>
									<chart:CategoryAxis>
										<chart:CategoryAxis.Title>
											<chart:ChartAxisTitle Text="Date"/>
										</chart:CategoryAxis.Title>
									</chart:CategoryAxis>
								</chart:SfCartesianChart.XAxes>
								<chart:SfCartesianChart.YAxes>
									<chart:NumericalAxis>
										<chart:NumericalAxis.Title>
											<chart:ChartAxisTitle Text="Amount Collected (₱)"/>
										</chart:NumericalAxis.Title>
									</chart:NumericalAxis>
								</chart:SfCartesianChart.YAxes>
								<chart:LineSeries ItemsSource="{Binding BillingChartData}"
								   XBindingPath="Label" YBindingPath="Value"
								   Fill="{StaticResource Primary}"
								   StrokeWidth="3"
								   ShowMarkers="True"
								   ShowDataLabels="True"/>
							</chart:SfCartesianChart>

							<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

							<Grid ColumnDefinitions="*,*">
								<VerticalStackLayout>
									<Label Text="{Binding CurrentReport.TotalRevenue, StringFormat='₱{0:N2}'}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Start" TextColor="{StaticResource Primary}"/>
									<Label Text="Collected" Style="{StaticResource MutedCaptionStyle}"/>
								</VerticalStackLayout>
								<VerticalStackLayout Grid.Column="1">
									<Label Text="{Binding CurrentReport.OutstandingBalance, StringFormat='₱{0:N2}'}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="End" TextColor="{StaticResource StatusOut}"/>
									<Label Text="Outstanding" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="End"/>
								</VerticalStackLayout>
							</Grid>
						</VerticalStackLayout>
					</Border>

					<!-- ── MEDICAL SUPPLIES — donut, legend + data labels built in ── -->
					<Border Style="{StaticResource ElevatedCardStyle}">
						<VerticalStackLayout Spacing="10">
							<Label Text="Medical Supplies" Style="{StaticResource CardSectionTitleStyle}"/>

							<chart:SfCircularChart HeightRequest="220">
								<chart:SfCircularChart.Legend>
									<chart:ChartLegend Placement="Bottom"/>
								</chart:SfCircularChart.Legend>
								<chart:DoughnutSeries ItemsSource="{Binding SupplyChartData}"
                                                       XBindingPath="Label" YBindingPath="Value"
                                                       ShowDataLabels="True">
									<chart:DoughnutSeries.PaletteBrushes>
										<SolidColorBrush Color="{StaticResource Primary}"/>
										<SolidColorBrush Color="{StaticResource StatusLow}"/>
										<SolidColorBrush Color="{StaticResource StatusOut}"/>
									</chart:DoughnutSeries.PaletteBrushes>
									<chart:DoughnutSeries.DataLabelSettings>
										<chart:CircularDataLabelSettings LabelPlacement="Outer"/>
									</chart:DoughnutSeries.DataLabelSettings>
								</chart:DoughnutSeries>
							</chart:SfCircularChart>

							<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

							<Grid ColumnDefinitions="*,*,*,*">
								<VerticalStackLayout>
									<Label Text="{Binding CurrentReport.TotalSupplies}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Center"/>
									<Label Text="Total" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="Center"/>
								</VerticalStackLayout>
								<VerticalStackLayout Grid.Column="1">
									<Label Text="{Binding CurrentReport.InStockCount}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Center" TextColor="{StaticResource Primary}"/>
									<Label Text="In Stock" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="Center"/>
								</VerticalStackLayout>
								<VerticalStackLayout Grid.Column="2">
									<Label Text="{Binding CurrentReport.LowStockItemCount}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Center" TextColor="{StaticResource StatusLow}"/>
									<Label Text="Low" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="Center"/>
								</VerticalStackLayout>
								<VerticalStackLayout Grid.Column="3">
									<Label Text="{Binding CurrentReport.OutOfStockCount}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Center" TextColor="{StaticResource StatusOut}"/>
									<Label Text="Out" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="Center"/>
								</VerticalStackLayout>
							</Grid>

							<!-- Movement THIS period, from supply_stock_logs -->
							<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>
							<Grid ColumnDefinitions="*,*">
								<VerticalStackLayout>
									<Label Text="{Binding CurrentReport.PiecesRestocked, StringFormat='+{0}'}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="Start" TextColor="{StaticResource Primary}"/>
									<Label Text="Restocked this period" Style="{StaticResource MutedCaptionStyle}"/>
								</VerticalStackLayout>
								<VerticalStackLayout Grid.Column="1">
									<Label Text="{Binding CurrentReport.PiecesUsed, StringFormat='-{0}'}" Style="{StaticResource CardRowValueStyle}" HorizontalTextAlignment="End" TextColor="{StaticResource StatusOut}"/>
									<Label Text="Used this period" Style="{StaticResource MutedCaptionStyle}" HorizontalTextAlignment="End"/>
								</VerticalStackLayout>
							</Grid>
						</VerticalStackLayout>
					</Border>

				</VerticalStackLayout>
			</VerticalStackLayout>
		</ScrollView>

	</Grid>
</ContentPage>
