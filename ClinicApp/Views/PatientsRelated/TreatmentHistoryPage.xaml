<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ClinicApp.ViewModels.PatientsRelatedVM"
    xmlns:models="clr-namespace:ClinicApp.Models"
    x:Class="ClinicApp.Views.PatientsRelated.TreatmentHistoryPage"
    x:DataType="vm:TreatmentHistoryViewModel"
    Title="Treatment History"
    Shell.TabBarIsVisible="False"
    BackgroundColor="#F5F7FB">

    <Grid RowDefinitions="Auto,*">

        <!-- ===================================================== -->
        <!-- PATIENT HEADER -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="18,16">

            <Border.Shadow>
                <Shadow Brush="#18000000"
                        Offset="0,2"
                        Radius="8"
                        Opacity="0.18"/>
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="14">

                <!-- Patient avatar -->
                <Border WidthRequest="48"
                        HeightRequest="48"
                        StrokeThickness="0"
                        BackgroundColor="#E8F0FF"
                        StrokeShape="RoundRectangle 24"
                        VerticalOptions="Center">

                    <Label Text="{Binding PatientInitials}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#2563EB"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                </Border>

                <!-- Patient information -->
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="3"
                                     VerticalOptions="Center">

                    <Label Text="{Binding PatientName}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#172B4D"
                           LineBreakMode="TailTruncation"/>

                    <Label Text="{Binding PatientId, StringFormat='Patient ID • {0}'}"
                           FontSize="12"
                           TextColor="#7A869A"/>
                </VerticalStackLayout>

                <!-- Record count -->
                <Border Grid.Column="2"
                        BackgroundColor="#EFF6FF"
                        Stroke="#BFDBFE"
                        StrokeThickness="1"
                        Padding="10,7"
                        StrokeShape="RoundRectangle 12"
                        VerticalOptions="Center">

                    <VerticalStackLayout Spacing="0"
                                         HorizontalOptions="Center">

                        <Label Text="{Binding HistoryCountText}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#2563EB"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>
        </Border>


        <!-- ===================================================== -->
        <!-- BODY -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1">

            <!-- Loading -->
            <VerticalStackLayout
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Spacing="12">

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    Color="#2563EB"
                    WidthRequest="36"
                    HeightRequest="36"/>

                <Label Text="Loading treatment history..."
                       FontSize="13"
                       TextColor="#64748B"/>
            </VerticalStackLayout>


            <!-- ================================================= -->
            <!-- EMPTY STATE -->
            <!-- ================================================= -->

            <VerticalStackLayout
                IsVisible="{Binding IsHistoryEmpty}"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Spacing="10"
                Padding="30">

                <Border WidthRequest="72"
                        HeightRequest="72"
                        BackgroundColor="#EAF2FF"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 36">

                    <Label Text="⌁"
                           FontSize="38"
                           TextColor="#3B82F6"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                </Border>

                <Label Text="No treatment history"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#1E293B"
                       HorizontalTextAlignment="Center"/>

                <Label Text="Treatment records and services rendered will appear here after a visit."
                       FontSize="13"
                       TextColor="#64748B"
                       HorizontalTextAlignment="Center"
                       LineHeight="1.3"/>
            </VerticalStackLayout>


            <!-- ================================================= -->
            <!-- VISITS -->
            <!-- ================================================= -->

            <CollectionView
                ItemsSource="{Binding Visits}"
                SelectionMode="None"
                IsVisible="{Binding IsHistoryEmpty, Converter={StaticResource InvertedBoolConverter}}"
                Margin="14,14,14,0">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="14"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>

                    <DataTemplate x:DataType="models:TreatmentVisitGroup">

                        <VerticalStackLayout Spacing="8">

                            <!-- ================================= -->
                            <!-- VISIT HEADER -->
                            <!-- ================================= -->

                            <Border
                                BackgroundColor="White"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                Padding="14"
                                StrokeShape="RoundRectangle 14">

                                <Border.Shadow>
                                    <Shadow Brush="#12000000"
                                            Offset="0,2"
                                            Radius="6"
                                            Opacity="0.12"/>
                                </Border.Shadow>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                          Path=BindingContext.OpenVisitCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="12">

                                    <!-- Calendar icon -->
                                    <Border
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        BackgroundColor="#EEF4FF"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 11"
                                        VerticalOptions="Center">

                                        <Label Text="▣"
                                               FontSize="20"
                                               TextColor="#4F46E5"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"/>
                                    </Border>

                                    <!-- Visit information -->
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="3"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding VisitDate, StringFormat='{0:MMMM dd, yyyy}'}"
                                            FontSize="15"
                                            FontAttributes="Bold"
                                            TextColor="#1E293B"/>

                                        <Label
                                            Text="{Binding VisitTitle}"
                                            FontSize="12"
                                            TextColor="#64748B"/>

                                    </VerticalStackLayout>

                                    <!-- Treatment count + chevron -->
                                    <HorizontalStackLayout
                                        Grid.Column="2"
                                        Spacing="8"
                                        VerticalOptions="Center">

                                        <Border
                                            BackgroundColor="#EEF2FF"
                                            StrokeThickness="0"
                                            Padding="9,5"
                                            StrokeShape="RoundRectangle 10">

                                            <Label
                                                Text="{Binding Treatments.Count, StringFormat='{0} items'}"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="#4F46E5"/>
                                        </Border>

                                        <Label
                                            Text="›"
                                            FontSize="24"
                                            TextColor="#94A3B8"
                                            VerticalTextAlignment="Center"/>
                                    </HorizontalStackLayout>

                                </Grid>
                            </Border>


                            <!-- ================================= -->
                            <!-- TREATMENTS -->
                            <!-- ================================= -->

                            <!--<CollectionView
                                ItemsSource="{Binding Treatments}"
                                SelectionMode="None">

                                <CollectionView.ItemTemplate>

                                    <DataTemplate
                                        x:DataType="vm:TreatmentHistoryItemViewModel">

                                        <Border
                                            Margin="8,0,8,0"
                                            BackgroundColor="White"
                                            Stroke="#E8ECF2"
                                            StrokeThickness="1"
                                            Padding="12"
                                            StrokeShape="RoundRectangle 12">

                                            <Grid
                                                ColumnDefinitions="4,*,Auto"
                                                ColumnSpacing="12">

                                                --><!-- Status indicator --><!--
                                                <BoxView
                                                    Grid.Column="0"
                                                    WidthRequest="4"
                                                    CornerRadius="2"
                                                    Color="{Binding ConditionColor}"
                                                    VerticalOptions="Fill"/>


                                                --><!-- ================================= -->
                                                <!-- MAIN DETAILS -->
                                                <!-- ================================= --><!--

                                                <VerticalStackLayout
                                                    Grid.Column="1"
                                                    Spacing="4">

                                                    --><!-- Tooth / service --><!--
                                                    <Label
                                                        Text="{Binding ToothLabel}"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        TextColor="#64748B"/>

                                                    <Label
                                                        Text="{Binding ToothName}"
                                                        FontSize="15"
                                                        FontAttributes="Bold"
                                                        TextColor="#1E293B"
                                                        LineBreakMode="TailTruncation"/>

                                                    --><!-- Condition --><!--
                                                    <HorizontalStackLayout
                                                        Spacing="6"
                                                        IsVisible="{Binding IsGeneralService, Converter={StaticResource InvertedBoolConverter}}">

                                                        <Border
                                                            BackgroundColor="#F8FAFC"
                                                            StrokeThickness="0"
                                                            Padding="7,3"
                                                            StrokeShape="RoundRectangle 7">

                                                            <Label
                                                                Text="{Binding Condition}"
                                                                FontSize="11"
                                                                TextColor="#475569"/>
                                                        </Border>

                                                    </HorizontalStackLayout>


                                                    --><!-- Previous condition --><!--
                                                    <Label
                                                        Text="{Binding PreviousConditionDisplay}"
                                                        FontSize="11"
                                                        TextColor="#D97706"
                                                        IsVisible="{Binding HasPreviousCondition}"/>


                                                    --><!-- Notes --><!--
                                                    <Label
                                                        Text="{Binding Notes}"
                                                        FontSize="11"
                                                        TextColor="#94A3B8"
                                                        IsVisible="{Binding HasNotes}"
                                                        MaxLines="2"
                                                        LineBreakMode="TailTruncation"/>

                                                </VerticalStackLayout>


                                                --><!-- ================================= -->
                                                <!-- TIME / ACTION -->
                                                <!-- ================================= --><!--

                                                <VerticalStackLayout
                                                    Grid.Column="2"
                                                    Spacing="6"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="Start">

                                                    <Label
                                                        Text="{Binding TimeDisplay}"
                                                        FontSize="10"
                                                        TextColor="#94A3B8"
                                                        HorizontalTextAlignment="End"/>

                                                    <Border
                                                        BackgroundColor="{Binding ActionBadgeColor}"
                                                        StrokeThickness="0"
                                                        Padding="8,4"
                                                        StrokeShape="RoundRectangle 8">

                                                        <Label
                                                            Text="{Binding ActionType}"
                                                            FontSize="9"
                                                            FontAttributes="Bold"
                                                            TextColor="White"
                                                            HorizontalTextAlignment="Center"/>
