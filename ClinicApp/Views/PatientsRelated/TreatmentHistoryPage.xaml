<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ClinicApp.ViewModels.PatientsRelatedVM"
    xmlns:models="clr-namespace:ClinicApp.Models.TreatmentModels"
    x:Class="ClinicApp.Views.PatientsRelated.TreatmentHistoryPage"
    x:DataType="vm:TreatmentHistoryViewModel"
    Title="Treatment Record"
    Shell.TabBarIsVisible="False"
    Shell.BackgroundColor="{StaticResource Primary}"
    Shell.TitleColor="White"
    Shell.ForegroundColor="White"
    BackgroundColor="{StaticResource PageBg}">

	<Grid RowDefinitions="Auto,*">

		<!-- ── PATIENT SUMMARY ── -->
		<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,16,20,0" BackgroundColor="{StaticResource White}">
			<Label Grid.Column="0" Text="{Binding PatientName}" FontSize="20" FontAttributes="Bold"
                   TextColor="{StaticResource Gray900}" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
			<Border Grid.Column="1" BackgroundColor="{StaticResource Secondary}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 999" Padding="10,4" VerticalOptions="Center">
				<Label Text="{Binding HistoryCountText}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
			</Border>
		</Grid>

		<Grid Grid.Row="1">

			<!-- Loading -->
			<VerticalStackLayout IsVisible="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
				<ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" WidthRequest="36" HeightRequest="36"/>
				<Label Text="Loading treatment history..." Style="{StaticResource MutedCaptionStyle}"/>
			</VerticalStackLayout>

			<!-- Empty state -->
			<VerticalStackLayout IsVisible="{Binding IsHistoryEmpty}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="30">
				<Label Text="No treatment history" Style="{StaticResource EmptyStateTitleStyle}" HorizontalTextAlignment="Center"/>
				<Label Text="Treatment records and services rendered will appear here after a visit."
                       Style="{StaticResource EmptyStateSubtitleStyle}" HorizontalTextAlignment="Center"/>
			</VerticalStackLayout>

			<!-- ── VISIT CARDS — newest first, one card per visit date, each listing every treatment/service done that day ── -->
			<CollectionView ItemsSource="{Binding VisitGroups}" SelectionMode="None"
                            IsVisible="{Binding IsHistoryEmpty, Converter={StaticResource InvertedBoolConverter}}"
                            Margin="20,14,20,0">
				<CollectionView.ItemsLayout>
					<LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
				</CollectionView.ItemsLayout>
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="models:TreatmentVisitGroup">
						<Border Style="{StaticResource ElevatedCardStyle}" Padding="0">
							<Grid ColumnDefinitions="4,*">

								<!-- Left accent bar — the one deliberate brand-color touch on the card -->
								<BoxView Grid.Column="0" Color="{StaticResource Primary}"/>

								<VerticalStackLayout Grid.Column="1" Padding="16,14,16,14" Spacing="0">

									<!-- Date + time, once per visit, single line -->
									<Label Text="{Binding DateTimeDisplay}" FontSize="12" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" Margin="0,0,0,8"/>

									<!-- One block per treatment/service performed at this visit -->
									<VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="0">
										<BindableLayout.ItemTemplate>
											<DataTemplate x:DataType="models:TreatmentRowItem">
												<VerticalStackLayout>

													<!-- Divider between rows — hidden above the first row in the card -->
													<BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray100}"
                                                             Margin="0,10,0,10"
                                                             IsVisible="{Binding IsFirst, Converter={StaticResource InvertedBoolConverter}}"/>

													<Label Text="{Binding Description}" Style="{StaticResource CardSectionTitleStyle}"/>

													<!-- Tooth color dot + tooth label, hidden for general services -->
													<HorizontalStackLayout Spacing="6" Margin="0,3,0,0" IsVisible="{Binding HasTooth}">
														<BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="{Binding ToothColor}"/>
														<Label Text="{Binding ToothDisplay}" FontSize="12" TextColor="{StaticResource Gray400}"/>
													</HorizontalStackLayout>

												</VerticalStackLayout>
											</DataTemplate>
										</BindableLayout.ItemTemplate>
									</VerticalStackLayout>

									<!-- One genuine (non-auto-generated) note per visit, shown once for the whole card -->
									<Label Text="{Binding SharedNotes}" FontSize="12" TextColor="{StaticResource Gray500}"
                                           FontAttributes="Italic" Margin="0,10,0,0" IsVisible="{Binding HasNotes}"/>

								</VerticalStackLayout>
							</Grid>
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>

		</Grid>

	</Grid>

</ContentPage>
