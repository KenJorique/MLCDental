<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ClinicApp.ViewModels.PatientsRelatedVM"
    xmlns:models="clr-namespace:ClinicApp.Models.TreatmentModels"
    x:Class="ClinicApp.Views.PatientsRelated.TreatmentHistoryPage"
    x:DataType="vm:TreatmentHistoryViewModel"
    Title="Treatment Record"
    Shell.TabBarIsVisible="False"
    Shell.BackgroundColor="{StaticResource Primary}"
    Shell.TitleColor="White"
    Shell.ForegroundColor="White"
    BackgroundColor="{StaticResource PageBg}">

	<Grid RowDefinitions="Auto,*">

		<!-- ── PATIENT SUMMARY ── -->
		<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,14" BackgroundColor="{StaticResource White}">
			<Label Grid.Column="0" Text="{Binding PatientName}" Style="{StaticResource CardSectionTitleStyle}"
                   VerticalOptions="Center" LineBreakMode="TailTruncation"/>
			<Label Grid.Column="1" Text="{Binding HistoryCountText}" Style="{StaticResource MutedCaptionStyle}" VerticalOptions="Center"/>
		</Grid>

		<Grid Grid.Row="1">

			<!-- Loading -->
			<VerticalStackLayout IsVisible="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
				<ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" WidthRequest="36" HeightRequest="36"/>
				<Label Text="Loading treatment history..." Style="{StaticResource MutedCaptionStyle}"/>
			</VerticalStackLayout>

			<!-- Empty state -->
			<VerticalStackLayout IsVisible="{Binding IsHistoryEmpty}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="30">
				<Label Text="No treatment history" Style="{StaticResource EmptyStateTitleStyle}" HorizontalTextAlignment="Center"/>
				<Label Text="Treatment records and services rendered will appear here after a visit."
                       Style="{StaticResource EmptyStateSubtitleStyle}" HorizontalTextAlignment="Center"/>
			</VerticalStackLayout>

			<!-- ── VISIT CARDS — newest first, one card per visit date, each listing every treatment/service done that day ── -->
			<CollectionView ItemsSource="{Binding VisitGroups}" SelectionMode="None"
                            IsVisible="{Binding IsHistoryEmpty, Converter={StaticResource InvertedBoolConverter}}"
                            Margin="16,14,16,0">
				<CollectionView.ItemsLayout>
					<LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
				</CollectionView.ItemsLayout>
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="models:TreatmentVisitGroup">
						<Border Style="{StaticResource ElevatedCardStyle}" Padding="0">
							<VerticalStackLayout Spacing="0">

								<!-- Date + Time — separate labels, each with its own caption -->
								<VerticalStackLayout Padding="16,14,16,10" Spacing="8">
									<Grid ColumnDefinitions="*,*">
										<VerticalStackLayout Grid.Column="0" Spacing="1">
											<Label Text="Date" Style="{StaticResource MutedCaptionStyle}"/>
											<Label Text="{Binding DateDisplay}" Style="{StaticResource CardRowLabelStyle}" TextColor="{StaticResource Gray900}"/>
										</VerticalStackLayout>
										<VerticalStackLayout Grid.Column="1" Spacing="1">
											<Label Text="Time" Style="{StaticResource MutedCaptionStyle}"/>
											<Label Text="{Binding TimeDisplay}" Style="{StaticResource CardRowLabelStyle}" TextColor="{StaticResource Gray900}"/>
										</VerticalStackLayout>
									</Grid>

									<!-- One block per treatment/service performed at this visit -->
									<VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="8" Margin="0,4,0,0">
										<BindableLayout.ItemTemplate>
											<DataTemplate x:DataType="models:TreatmentRowItem">
												<VerticalStackLayout Spacing="1">
													<Label Text="{Binding Description}" Style="{StaticResource CardSectionTitleStyle}"/>
													<Label Text="{Binding ToothDisplay, StringFormat='Teeth: {0}'}"
                                                           Style="{StaticResource MutedCaptionStyle}" IsVisible="{Binding HasTooth}"/>
												</VerticalStackLayout>
											</DataTemplate>
										</BindableLayout.ItemTemplate>
									</VerticalStackLayout>
								</VerticalStackLayout>

								<!-- Notes -->
								<VerticalStackLayout Padding="16,10" BackgroundColor="{StaticResource Gray100}" IsVisible="{Binding HasNotes}">
									<Label Style="{StaticResource CardRowLabelStyle}" TextColor="{StaticResource Gray900}">
										<Label.FormattedText>
											<FormattedString>
												<Span Text="Notes: " FontAttributes="Bold"/>
												<Span Text="{Binding SharedNotes}"/>
											</FormattedString>
										</Label.FormattedText>
									</Label>
								</VerticalStackLayout>

							</VerticalStackLayout>
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>

		</Grid>

	</Grid>

</ContentPage>
