<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ClinicApp.ViewModels.PatientsRelatedVM"
    xmlns:models="clr-namespace:ClinicApp.Models"
    x:Class="ClinicApp.Views.PatientsRelated.TreatmentHistoryPage"
    x:DataType="vm:TreatmentHistoryViewModel"
    Title="Treatment History"
    Shell.TabBarIsVisible="False"
    BackgroundColor="#F0F4F8">

    <Grid RowDefinitions="Auto,*">

        <!-- Patient header -->
        <Frame Grid.Row="0"
               BackgroundColor="White"
               CornerRadius="0"
               HasShadow="True"
               Padding="16,14"
               Margin="0">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{Binding PatientName}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1A2B4A"/>
                    <Label Text="{Binding PatientId, StringFormat='Patient ID: {0}'}"
                           FontSize="12"
                           TextColor="#6B7A9A"/>
                </VerticalStackLayout>

                <Frame Grid.Column="1"
                       BackgroundColor="#EFF6FF"
                       Padding="10,4"
                       CornerRadius="10"
                       HasShadow="False"
                       BorderColor="#BFDBFE"
                       VerticalOptions="Center">
                    <Label Text="{Binding HistoryCountText}"
                           FontSize="12"
                           TextColor="#2563EB"
                           FontAttributes="Bold"/>
                </Frame>
            </Grid>
        </Frame>

        <!-- Body -->
        <Grid Grid.Row="1">

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#2563EB"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>

            <VerticalStackLayout IsVisible="{Binding IsHistoryEmpty}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12"
                                 Margin="0,-80,0,0"
                                 Padding="20,0">
                <Label Text="Treatment Record"
                       FontSize="48"
                       HorizontalTextAlignment="Center"
                       TextColor="Black"/>
                <Label Text="No treatment history yet"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#374151"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- Visits -->
            <CollectionView ItemsSource="{Binding Visits}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TreatmentVisitGroup">
                        <VerticalStackLayout Margin="0,0,0,18"
                                             Spacing="8">

                            <!-- Visit Header -->
                            <Frame BackgroundColor="#EEF4FF"
                                   BorderColor="#D7E6FF"
                                   CornerRadius="12"
                                   Padding="12"
                                   HasShadow="False">

                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenVisitCommand}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>

                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding VisitDate, StringFormat='{0:MMMM dd, yyyy}'}"
                                               FontAttributes="Bold"
                                               FontSize="16"/>
                                        <Label Text="{Binding VisitTitle}"
                                               FontSize="12"
                                               TextColor="#666"/>
                                    </VerticalStackLayout>

                                    <Frame Grid.Column="1"
                                           BackgroundColor="#4F46E5"
                                           CornerRadius="20"
                                           Padding="8,4"
                                           HasShadow="False">
                                        <Label Text="{Binding Treatments.Count}"
                                               TextColor="White"/>
                                    </Frame>
                                </Grid>
                            </Frame>

                            <!-- Treatments -->
                            <CollectionView ItemsSource="{Binding Treatments}"
                                            SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TreatmentHistoryItemViewModel">
                                        <Frame Margin="12,0"
                                               CornerRadius="10"
                                               BorderColor="#ECECEC"
                                               Padding="12"
                                               HasShadow="False">

                                            <Grid ColumnDefinitions="Auto,*,Auto">

                                                <!-- colored dot -->
                                                <BoxView WidthRequest="10"
                                                         HeightRequest="10"
                                                         CornerRadius="5"
                                                         Color="{Binding ConditionColor}"
                                                         VerticalOptions="Start"/>

                                                <!-- Details -->
                                                <VerticalStackLayout Grid.Column="1"
                                                                     Margin="12,0">

                                                    <Label Text="{Binding ToothLabel}"
                                                           FontAttributes="Bold"
                                                           FontSize="14"/>

                                                    <Label Text="{Binding ToothName}"
                                                           FontSize="13"/>

                                                    <Label Text="{Binding Condition}"
                                                           FontSize="12"
                                                           TextColor="#666"/>

                                                    <Label Text="{Binding PreviousConditionDisplay}"
                                                           FontSize="11"
                                                           TextColor="#D97706"
                                                           IsVisible="{Binding HasPreviousCondition}"/>

                                                    <Label Text="{Binding Notes}"
                                                           FontSize="11"
                                                           TextColor="#888"
                                                           IsVisible="{Binding HasNotes}"/>

                                                </VerticalStackLayout>

                                                <!-- time -->
                                                <VerticalStackLayout Grid.Column="2">

                                                    <Label Text="{Binding TimeDisplay}"
                                                           FontSize="11"
                                                           TextColor="#666"/>

                                                    <Frame BackgroundColor="{Binding ActionBadgeColor}"
                                                           CornerRadius="20"
                                                           Padding="6,2"
                                                           Margin="0,6,0,0"
                                                           HasShadow="False">
                                                        <Label Text="{Binding ActionType}"
                                                               FontSize="10"
                                                               TextColor="White"/>
                                                    </Frame>

                                                </VerticalStackLayout>

                                            </Grid>

                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </Grid>
</ContentPage>