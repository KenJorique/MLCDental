<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClinicApp.ViewModels.PatientsRelatedVM"
             xmlns:models="clr-namespace:ClinicApp.Models"
             x:Class="ClinicApp.Views.PatientsRelated.TreatmentHistoryPage"
             x:DataType="vm:TreatmentHistoryViewModel"
             Title="Treatment Record"
             Shell.NavBarIsVisible="True"
             Shell.BackgroundColor="{StaticResource PrimaryGreen}"
             Shell.TitleColor="White"
             Shell.ForegroundColor="White"
             Shell.TabBarIsVisible="False"
             BackgroundColor="White">

	<Grid RowDefinitions="Auto,*">

		<!-- ── Patient header ── -->
		<Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Padding="16,12"
              BackgroundColor="{StaticResource PrimaryGreen}">
			<Label Grid.Column="0"
                   Text="{Binding PatientName}"
                   FontSize="17" FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"/>
			<Border Grid.Column="1"
                    BackgroundColor="{StaticResource Gold}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="10,4"
                    VerticalOptions="Center">
				<Label FontSize="13" FontAttributes="Bold" TextColor="White">
					<Label.FormattedText>
						<FormattedString>
							<Span Text="{Binding TreatmentCount}"/>
							<Span Text=" services"/>
						</FormattedString>
					</Label.FormattedText>
				</Label>
			</Border>
		</Grid>

		<!-- ── Treatment cards list ── -->
		<CollectionView Grid.Row="1"
                        ItemsSource="{Binding VisitGroups}"
                        SelectionMode="None"
                        Margin="14,12,14,12">

			<CollectionView.EmptyView>
				<VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="8"
                                     Margin="0,60,0,0">
					<Label Text="No treatment records yet."
                           FontSize="15" TextColor="{StaticResource Gray400}"
                           HorizontalTextAlignment="Center"/>
				</VerticalStackLayout>
			</CollectionView.EmptyView>

			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="models:TreatmentVisitGroup">

					<!-- One card per visit date -->
					<Border BackgroundColor="#F5F0D0"
                            Stroke="{StaticResource Gold}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="14,12"
                            Margin="0,0,0,12">

						<VerticalStackLayout Spacing="0">

							<!-- Date | Time row -->
							<HorizontalStackLayout Spacing="8" Margin="0,0,0,8">
								<Label Text="{Binding DateDisplay}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"/>
								<Label Text="|"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray400}"/>
								<Label Text="{Binding TimeDisplay}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"/>
							</HorizontalStackLayout>

							<!-- Services list -->
							<CollectionView ItemsSource="{Binding Items}"
                                            SelectionMode="None">
								<CollectionView.ItemTemplate>
									<DataTemplate x:DataType="models:TreatmentRowItem">
										<VerticalStackLayout Spacing="2"
                                                             Margin="0,0,0,10">
											<!-- Service name -->
											<Label Text="{Binding Description}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="Black"/>
											<!-- Teeth -->
											<HorizontalStackLayout Spacing="6"
                                                IsVisible="{Binding HasTooth}">
												<Label Text="Teeth"
                                                       FontSize="12"
                                                       TextColor="{StaticResource Gray500}"/>
												<Border BackgroundColor="{StaticResource Gray200}"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 6"
                                                        Padding="8,2">
													<Label Text="{Binding ToothDisplay}"
                                                           FontSize="12"
                                                           TextColor="{StaticResource Gray700}"/>
												</Border>
											</HorizontalStackLayout>
										</VerticalStackLayout>
									</DataTemplate>
								</CollectionView.ItemTemplate>
							</CollectionView>

							<!-- Divider before notes -->
							<BoxView HeightRequest="1"
                                     Color="{StaticResource Gold}"
                                     Opacity="0.4"
                                     Margin="0,0,0,8"/>

							<!-- Shared Notes -->
							<HorizontalStackLayout Spacing="8"
                                IsVisible="{Binding HasNotes}">
								<Border BackgroundColor="{StaticResource Gray300}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 4"
                                        WidthRequest="18" HeightRequest="18"/>
								<VerticalStackLayout Spacing="2" HorizontalOptions="Fill">
									<Label Text="Notes:"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="Black"/>
									<Label Text="{Binding SharedNotes}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray600}"
                                           LineBreakMode="WordWrap"/>
								</VerticalStackLayout>
							</HorizontalStackLayout>

						</VerticalStackLayout>
					</Border>

				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

	</Grid>
</ContentPage>
