<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ClinicApp.ViewModels.DentalChart"
    x:Class="ClinicApp.Views.DentalChart.DentalChartPage"
    x:DataType="vm:DentalChartViewModel"
    xmlns:dc="clr-namespace:ClinicApp.Graphics.DentalChart"
    Title="Dental Chart"
    Shell.TabBarIsVisible="False"
    Shell.BackgroundColor="{StaticResource Primary}"
    Shell.TitleColor="{StaticResource TextOnPrimary}"
    Shell.ForegroundColor="{StaticResource TextOnPrimary}"
    BackgroundColor="{StaticResource Secondary}">

	<Grid>
		<!-- ── Main scrollable content ── -->
		<ScrollView>
			<VerticalStackLayout Padding="12,10,12,30" Spacing="0">

				<!-- ── Patient header ── -->
				<Frame BackgroundColor="{StaticResource White}"
                       BorderColor="{StaticResource CardBorderColor}"
                       CornerRadius="12"
                       HasShadow="True" Padding="16,12" Margin="0,0,0,12">
					<Grid ColumnDefinitions="*,Auto">
						<VerticalStackLayout Grid.Column="0">
							<Label Text="{Binding PatientName}"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
							<Label Text="{Binding PatientId, StringFormat='Patient ID: {0}'}"
                                   FontSize="12" TextColor="{StaticResource TextSecondary}"/>
						</VerticalStackLayout>
						<ActivityIndicator Grid.Column="1"
                                           IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource Primary}"
                                           WidthRequest="26" HeightRequest="26"
                                           VerticalOptions="Center"/>
					</Grid>
				</Frame>

				<!-- ── Chart card ── -->
				<Frame BackgroundColor="{StaticResource White}"
                       BorderColor="{StaticResource CardBorderColor}"
                       CornerRadius="14"
                       HasShadow="True" Padding="15,15" Margin="0,0,0,15">
					<VerticalStackLayout Spacing="4">

						<!-- Header row -->
						<Grid ColumnDefinitions="*,Auto,*" Margin="4,0,4,6">
							<Label Grid.Column="0" Text="RIGHT" FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="Start"
                                   VerticalTextAlignment="Center"/>
							<Label Grid.Column="1" Text="DENTAL CHART"
                                   Style="{StaticResource CardSectionTitleStyle}"
                                   FontSize="14"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalTextAlignment="Center"/>
							<Label Grid.Column="2" Text="LEFT" FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="End"
                                   VerticalTextAlignment="Center"/>
						</Grid>

						<!-- UPPER arch label -->
						<Label Text="UPPER ARCH" FontSize="10" FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center"
                               Margin="0,2,0,4"/>

						<!-- Upper teeth 1–16 — arch layout -->
						<dc:DentalArchCanvasView Arch="Upper"
                                                  TeethSource="{Binding UpperTeeth}"
                                                  TappedCommand="{Binding ToothTappedCommand}"
                                                  HeightRequest="200"
                                                  HorizontalOptions="Fill"/>

						<!-- Gum divider -->
						<Grid HeightRequest="22" Margin="0,6">
							<BoxView HeightRequest="1"
                                     BackgroundColor="{StaticResource CardBorderColor}"
                                     VerticalOptions="Center"/>
							<Frame BackgroundColor="{StaticResource White}" Padding="10,2"
                                   CornerRadius="8" HasShadow="False"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   BorderColor="{StaticResource CardBorderColor}">
								<Label Text="— gum line —" FontSize="9"
                                       TextColor="{StaticResource TextSecondary}"
                                       HorizontalTextAlignment="Center"/>
							</Frame>
						</Grid>

						<!-- Lower teeth 17–32 — arch layout -->
						<dc:DentalArchCanvasView Arch="Lower"
                                                  TeethSource="{Binding LowerTeeth}"
                                                  TappedCommand="{Binding ToothTappedCommand}"
                                                  HeightRequest="200"
                                                  HorizontalOptions="Fill"/>

						<!-- LOWER arch label -->
						<Label Text="LOWER ARCH" FontSize="10" FontAttributes="Bold"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center"
                               Margin="0,4,0,2"/>

					</VerticalStackLayout>
				</Frame>

				<!-- ── Legend card ── -->
				<Frame BackgroundColor="{StaticResource White}"
                       BorderColor="{StaticResource CardBorderColor}"
                       CornerRadius="12"
                       HasShadow="True"
                       Padding="16,14"
                       Margin="0,0,0,12">

					<VerticalStackLayout Spacing="10">

						<Label Text="LEGEND"
                               Style="{StaticResource CardSectionTitleStyle}"
                               FontSize="12"/>

						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
							<Ellipse WidthRequest="16" HeightRequest="16"
                                     Fill="{StaticResource White}"
                                     Stroke="{StaticResource TextSecondary}"
                                     StrokeThickness="1.5"/>
							<Label Grid.Column="1" Text="Normal / Untreated"
                                   FontSize="13" TextColor="{StaticResource TextSecondary}"/>
						</Grid>

						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
							<Ellipse WidthRequest="16" HeightRequest="16" Fill="#0000FF"/>
							<Label Grid.Column="1" Text="Filling / Restoration"
                                   FontSize="13" TextColor="{StaticResource TextSecondary}"/>
						</Grid>

						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
							<Ellipse WidthRequest="16" HeightRequest="16" Fill="#FF0000"/>
							<Label Grid.Column="1" Text="Active Decay / Caries"
                                   FontSize="13" TextColor="{StaticResource TextSecondary}"/>
						</Grid>

						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
							<!-- Was #00AA00 — now matches the actual "Completed" color (#00FF00)
                                 applied by DentalChartViewModel.ConditionColors, so the swatch
                                 you see here is the color that really lands on the tooth. -->
							<Ellipse WidthRequest="16" HeightRequest="16" Fill="#00FF00"/>
							<Label Grid.Column="1" Text="Completed Treatment"
                                   FontSize="13" TextColor="{StaticResource TextSecondary}"/>
						</Grid>

						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
							<Ellipse WidthRequest="16" HeightRequest="16" Fill="#000000"/>
							<Label Grid.Column="1" Text="Missing / Extracted"
                                   FontSize="13" TextColor="{StaticResource TextSecondary}"/>
						</Grid>

						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
							<!-- Was #F97316 — now matches the actual "Root Canal" color
                                 (#FF7A00) from ConditionColors. -->
							<Ellipse WidthRequest="16" HeightRequest="16" Fill="#FF7A00"/>
							<Label Grid.Column="1" Text="Root Canal Treatment"
                                   FontSize="13" TextColor="{StaticResource TextSecondary}"/>
						</Grid>

						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
							<Ellipse WidthRequest="16" HeightRequest="16" Fill="#A855F7"/>
							<Label Grid.Column="1" Text="Crown / Bridge / Prosthetic"
                                   FontSize="13" TextColor="{StaticResource TextSecondary}"/>
						</Grid>

					</VerticalStackLayout>
				</Frame>

				<!-- ── Status message ── -->
				<Label Text="{Binding StatusMessage}"
                       Style="{StaticResource MutedCaptionStyle}"
                       HorizontalTextAlignment="Center"
                       Margin="0,4"
                       IsVisible="{Binding StatusMessage,
                           Converter={StaticResource StringNotEmptyConverter}}"/>

			</VerticalStackLayout>
		</ScrollView>

		<!-- ── Loading overlay ──
             Shown whenever IsBusy is true, so tapping a tooth gives
             immediate feedback instead of feeling like a lag/freeze while
             the chart/tooth data is fetched. Uses the app's default
             ActivityIndicator style (Primary green) from Styles.xaml.
             NOTE: this reuses the same IsBusy flag as the patient-header
             spinner above — if ToothTappedCommand doesn't currently toggle
             IsBusy while it loads, this won't show for tooth taps yet;
             it just needs IsBusy = true/false set around that command. -->
		<Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="#66000000"
              ZIndex="8">
			<Frame BackgroundColor="{StaticResource White}"
                   BorderColor="{StaticResource CardBorderColor}"
                   CornerRadius="12"
                   HasShadow="True"
                   Padding="24,18"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
				<VerticalStackLayout Spacing="8" HorizontalOptions="Center">
					<ActivityIndicator IsRunning="{Binding IsBusy}"
                                       Color="{StaticResource Primary}"
                                       WidthRequest="32" HeightRequest="32"/>
					<Label Text="Loading…" FontSize="12"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalTextAlignment="Center"/>
				</VerticalStackLayout>
			</Frame>
		</Grid>

		<!-- ═══════════════════════════════════════════════════════════
             TOOTH DETAIL MODAL OVERLAY
             Shown when IsModalVisible = true
        ════════════════════════════════════════════════════════════════ -->
		<Grid IsVisible="{Binding IsModalVisible}"
              BackgroundColor="#80000000"
              ZIndex="10">
			<Grid.GestureRecognizers>
				<!-- Tap backdrop to dismiss -->
				<TapGestureRecognizer Command="{Binding CloseModalCommand}"/>
			</Grid.GestureRecognizers>

			<!-- Modal panel — centered, max 480 wide.
                 Border (not Frame) is used here on purpose: Frame does not
                 reliably clip a colored child (like the green header below)
                 to its own rounded corners on Android, which is what was
                 causing the jagged/broken-looking edges. Border clips its
                 content to StrokeShape properly on every platform. -->
			<Border BackgroundColor="{StaticResource White}"
                    Stroke="{StaticResource CardBorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="0"
                    WidthRequest="360"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Margin="20,0">
				<Border.Shadow>
					<Shadow Brush="Black" Opacity="0.25" Radius="16" Offset="0,6"/>
				</Border.Shadow>
				<Border.GestureRecognizers>
					<!-- Prevent backdrop tap propagating through panel -->
					<TapGestureRecognizer/>
				</Border.GestureRecognizers>

				<VerticalStackLayout Spacing="0">

					<!-- ── Modal header ──
                         Title/close row, tooth name, and the condition +
                         last-updated summary all live here now, per request,
                         instead of the condition row sitting separately
                         below the header. -->
					<VerticalStackLayout BackgroundColor="{StaticResource Primary}"
                                         Padding="16,14" Spacing="10">

						<Grid ColumnDefinitions="*,Auto">
							<VerticalStackLayout Grid.Column="0">
								<Label Text="{Binding ModalToothTitle}"
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="{StaticResource TextOnPrimary}"/>
								<Label Text="{Binding ModalToothName}"
                                       FontSize="12" TextColor="{StaticResource GoldLight}"/>
							</VerticalStackLayout>
							<!-- Close × button -->
							<Button Grid.Column="1"
                                    Text="✕"
                                    TextColor="{StaticResource TextOnPrimary}"
                                    BackgroundColor="Transparent"
                                    FontSize="18"
                                    WidthRequest="36" HeightRequest="36"
                                    Padding="0"
                                    VerticalOptions="Start"
                                    Command="{Binding CloseModalCommand}"/>
						</Grid>

						<!-- Condition badge + last-updated, now inside the header -->
						<Grid ColumnDefinitions="*,Auto">
							<HorizontalStackLayout Grid.Column="0" Spacing="8"
                                                   VerticalOptions="Center">
								<Ellipse WidthRequest="14" HeightRequest="14"
                                         Fill="{Binding ModalConditionColor}"
                                         Stroke="{StaticResource TextOnPrimary}"
                                         StrokeThickness="1"/>
								<Label Text="{Binding ModalCondition}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextOnPrimary}"
                                       VerticalTextAlignment="Center"/>
							</HorizontalStackLayout>
							<Label Grid.Column="1"
                                   Text="{Binding ModalLastUpdated}"
                                   FontSize="11" TextColor="{StaticResource GoldLight}"
                                   VerticalTextAlignment="Center"/>
						</Grid>
					</VerticalStackLayout>

					<!-- ── Body ── -->
					<VerticalStackLayout Padding="16,14" Spacing="12">

						<!-- ── View mode ── -->
						<VerticalStackLayout IsVisible="{Binding IsEditMode,
                                                         Converter={StaticResource InvertedBoolConverter}}"
                                             Spacing="8">
							<Label Text="NOTES" FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}"/>
							<Label Text="{Binding ModalNotes}"
                                   FontSize="13" TextColor="{StaticResource TextPrimary}"
                                   LineBreakMode="WordWrap"/>
							<Label Text="No notes recorded."
                                   FontSize="13" TextColor="{StaticResource TextSecondary}"
                                   FontAttributes="Italic"
                                   IsVisible="{Binding ModalNotes,
                                       Converter={StaticResource StringEmptyConverter}}"/>
						</VerticalStackLayout>

						<!-- ── Edit mode ── -->
						<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="10">

							<!-- Condition picker -->
							<Label Text="CONDITION" FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}"/>
							<Picker ItemsSource="{Binding ConditionOptions}"
                                    SelectedItem="{Binding EditCondition}"
                                    FontSize="14" TextColor="{StaticResource TextPrimary}"
                                    BackgroundColor="{StaticResource Secondary}"/>

							<!-- Notes editor -->
							<Label Text="NOTES" FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
							<Editor Text="{Binding EditNotes}"
                                    Placeholder="Add clinical notes…"
                                    PlaceholderColor="{StaticResource TextSecondary}"
                                    FontSize="13"
                                    BackgroundColor="{StaticResource Secondary}"
                                    TextColor="{StaticResource TextPrimary}"
                                    MinimumHeightRequest="80"
                                    AutoSize="TextChanges"/>
						</VerticalStackLayout>

						<!-- ── Action buttons ── -->
						<Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">

							<!-- View mode: Edit + Clear -->
							<Button Grid.Column="0"
                                    IsVisible="{Binding IsEditMode,
                                        Converter={StaticResource InvertedBoolConverter}}"
                                    Text="Edit"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="{StaticResource TextOnPrimary}"
                                    CornerRadius="8" FontSize="14"
                                    Command="{Binding EnterEditModeCommand}"/>
							<Button Grid.Column="1"
                                    IsVisible="{Binding IsEditMode,
                                        Converter={StaticResource InvertedBoolConverter}}"
                                    Text="Clear"
                                    BackgroundColor="#FEE2E2"
                                    TextColor="{StaticResource StatusOut}"
                                    CornerRadius="8" FontSize="14"
                                    Command="{Binding ClearToothFromModalCommand}"/>

							<!-- Edit mode: Save + Cancel -->
							<Button Grid.Column="0"
                                    IsVisible="{Binding IsEditMode}"
                                    Text="Save"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="{StaticResource TextOnPrimary}"
                                    CornerRadius="8" FontSize="14"
                                    Command="{Binding SaveEditCommand}"/>
							<Button Grid.Column="1"
                                    IsVisible="{Binding IsEditMode}"
                                    Text="Cancel"
                                    BackgroundColor="{StaticResource Secondary}"
                                    TextColor="{StaticResource Primary}"
                                    CornerRadius="8" FontSize="14"
                                    Command="{Binding CancelEditCommand}"/>
						</Grid>

					</VerticalStackLayout>
				</VerticalStackLayout>
			</Border>
		</Grid>

	</Grid>
</ContentPage>
