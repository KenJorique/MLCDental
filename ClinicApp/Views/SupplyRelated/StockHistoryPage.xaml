<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ClinicApp.ViewModels.SupplyVM"
    x:Class="ClinicApp.Views.SupplyRelated.StockHistoryPage"
    x:DataType="vm:StockHistoryViewModel"
    Title="Stock History"
    Shell.BackgroundColor="{StaticResource Primary}"
    Shell.TitleColor="White"
    Shell.ForegroundColor="White"
    Shell.TabBarIsVisible="False"
    BackgroundColor="{StaticResource PageBg}">

	<ScrollView>
		<VerticalStackLayout Padding="16" Spacing="12">

			<!-- Supply name | status badge | qty — one line; name shrinks to fit via NameFontSize -->
			<Border Style="{StaticResource ElevatedCardStyle}">
				<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
					<Label Grid.Column="0"
                           Text="{Binding SupplyName}"
                           FontSize="{Binding NameFontSize}"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           VerticalOptions="Center"/>
					<Border Grid.Column="1"
                            Style="{StaticResource StatusBadgeStyle}"
                            BackgroundColor="{Binding StockStatusColor}"
                            VerticalOptions="Center">
						<Label Text="{Binding StockStatus}"
                               Style="{StaticResource StatusBadgeLabelStyle}"
                               TextColor="{Binding StockStatusTextColor}"/>
					</Border>
					<Label Grid.Column="2"
                           Text="{Binding StockDisplay}"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}"
                           VerticalOptions="Center"/>
				</Grid>
			</Border>

			<!-- Full history table -->
			<Border Style="{StaticResource ElevatedCardStyle}">
				<VerticalStackLayout Spacing="10">

					<!-- Table header -->
					<Grid ColumnDefinitions="*,*,*">
						<Label Grid.Column="0" Text="Change"
                               Style="{StaticResource MutedCaptionStyle}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"/>
						<Label Grid.Column="1" Text="Type"
                               Style="{StaticResource MutedCaptionStyle}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"/>
						<Label Grid.Column="2" Text="Date"
                               Style="{StaticResource MutedCaptionStyle}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"/>
					</Grid>
					<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

					<CollectionView ItemsSource="{Binding Logs}" SelectionMode="None">
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="vm:StockLogRowViewModel">
								<Grid ColumnDefinitions="*,*,*" Padding="0,7">
									<Label Grid.Column="0"
                                           IsVisible="{Binding IsIncrease}"
                                           Text="{Binding ChangeDisplay}"
                                           FontAttributes="Bold" FontSize="13"
                                           TextColor="{StaticResource StatusGood}"
                                           HorizontalTextAlignment="Center"/>
									<Label Grid.Column="0"
                                           IsVisible="{Binding IsIncrease, Converter={StaticResource InvertedBoolConverter}}"
                                           Text="{Binding ChangeDisplay}"
                                           FontAttributes="Bold" FontSize="13"
                                           TextColor="{StaticResource StatusOut}"
                                           HorizontalTextAlignment="Center"/>
									<Label Grid.Column="1" Text="{Binding TypeDisplay}"
                                           Style="{StaticResource MutedCaptionStyle}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
									<Label Grid.Column="2" Text="{Binding DateDisplay}"
                                           Style="{StaticResource MutedCaptionStyle}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
								</Grid>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>

					<VerticalStackLayout IsVisible="{Binding Logs.Count, Converter={StaticResource IntEqualZeroConverter}}"
                                          Spacing="4" Margin="0,20">
						<Label Text="No stock history yet." Style="{StaticResource EmptyStateTitleStyle}"/>
						<Label Text="Restock or reduce this item to see activity here."
                               Style="{StaticResource EmptyStateSubtitleStyle}"/>
					</VerticalStackLayout>

				</VerticalStackLayout>
			</Border>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
