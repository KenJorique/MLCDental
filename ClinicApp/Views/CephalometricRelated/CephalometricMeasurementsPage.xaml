<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClinicApp.Views.CephalometricRelated.CephalometricMeasurementsPage"
             Title="Cephalometric Measurements"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#FAFAFA">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0" RowSpacing="0">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="16" BackgroundColor="#2563EB" Spacing="6">
            <Label Text="{Binding PatientName, StringFormat='Patient: {0}'}"
                   FontSize="18" FontAttributes="Bold" TextColor="White"/>
            <Label Text="{Binding MeasurementDate, StringFormat='Measured: {0:MMM dd, yyyy}'}"
                   FontSize="12" TextColor="#E0E7FF"/>
            <Label Text="Value looks off? Tap Edit to correct it, or go back and drag the landmarks."
                   FontSize="11" TextColor="#E0E7FF"/>
        </VerticalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- Calibration / skipped-measurement notice -->
                <Label Text="{Binding InfoMessage}"
                       IsVisible="{Binding HasInfoMessage}"
                       FontSize="12" TextColor="#B45309"/>

                <!-- Empty state -->
                <VerticalStackLayout IsVisible="{Binding ShowEmptyState}" Padding="20" Spacing="8">
                    <Label Text="📋" FontSize="40" HorizontalTextAlignment="Center"/>
                    <Label Text="No measurements to show" FontSize="15" FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Go back, analyze the X-ray, then tap 'Confirm &amp; Calculate Measurements'."
                           FontSize="12" TextColor="#666" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <Label Text="Skeletal Measurements" FontSize="16" FontAttributes="Bold"
                       IsVisible="{Binding HasMeasurements}"/>

                <!-- Measurement cards -->
                <VerticalStackLayout Spacing="10"
                                     IsVisible="{Binding HasMeasurements}"
                                     BindableLayout.ItemsSource="{Binding Measurements}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="12" CornerRadius="10" HasShadow="False"
                                   BackgroundColor="White" BorderColor="#E5E7EB">
                                <VerticalStackLayout Spacing="8">

                                    <!-- Name + value -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Name}" FontSize="14"
                                                   FontAttributes="Bold" TextColor="#1F2937"/>
                                            <Label Text="{Binding Description}" FontSize="11" TextColor="#666"/>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                                            <Label Text="{Binding ValueText}" FontSize="18"
                                                   FontAttributes="Bold" TextColor="{Binding StatusColor}"
                                                   HorizontalTextAlignment="End"/>
                                            <Frame Padding="8,2" CornerRadius="4" HasShadow="False"
                                                   HorizontalOptions="End"
                                                   BorderColor="{Binding StatusColor}"
                                                   BackgroundColor="{Binding StatusBackground}">
                                                <Label Text="{Binding Status}" FontSize="11"
                                                       FontAttributes="Bold" TextColor="{Binding StatusColor}"/>
                                            </Frame>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Normal range + bar -->
                                    <Label Text="{Binding NormalRangeText}" FontSize="10" TextColor="#999"/>
                                    <ProgressBar Progress="{Binding NormalizedValue}"
                                                 ProgressColor="{Binding StatusColor}"
                                                 HeightRequest="8"/>

                                    <!-- Edited note -->
                                    <Label Text="{Binding EditedNote}" IsVisible="{Binding IsEdited}"
                                           FontSize="11" TextColor="#7C3AED"/>

                                    <!-- Actions -->
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Text="✏️ Edit value"
                                                Command="{Binding BindingContext.EditMeasurementCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#DBEAFE" TextColor="#1E40AF"
                                                CornerRadius="6" FontSize="12" Padding="12,4"
                                                HeightRequest="36"/>
                                        <Button Text="Reset"
                                                IsVisible="{Binding IsEdited}"
                                                Command="{Binding BindingContext.ResetMeasurementCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#F5F5F5" TextColor="#333"
                                                CornerRadius="6" FontSize="12" Padding="12,4"
                                                HeightRequest="36"/>
                                    </HorizontalStackLayout>

                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Summary -->
                <VerticalStackLayout Padding="12" BackgroundColor="#F0F9FF" Spacing="4"
                                     IsVisible="{Binding HasMeasurements}">
                    <Label Text="📋 Summary" FontSize="13" FontAttributes="Bold" TextColor="#2563EB"/>
                    <Label Text="{Binding SummaryText}" FontSize="12" TextColor="#1F2937"/>
                    <Label Text="Green = Normal | Orange = High | Blue = Low"
                           FontSize="11" TextColor="#666"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom bar -->
        <VerticalStackLayout Grid.Row="2" Padding="16" BackgroundColor="White"
                             IsVisible="{Binding HasMeasurements}">
            <Button Text="{Binding SaveButtonText}"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding CanSave}"
                    BackgroundColor="#16A34A" TextColor="White"
                    CornerRadius="8" Padding="14"/>
        </VerticalStackLayout>

    </Grid>

</ContentPage>