<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClinicApp.Views.CephalometricRelated.CephalometricMeasurementsPage"
             Title="Cephalometric Measurements"
             Shell.TabBarIsVisible="False"
             Shell.BackgroundColor="{StaticResource Primary}"
             Shell.TitleColor="{StaticResource TextOnPrimary}"
             Shell.ForegroundColor="{StaticResource TextOnPrimary}"
             BackgroundColor="{StaticResource PageBg}">

	<Grid RowDefinitions="Auto,*" Padding="0" RowSpacing="0">

		<!-- Header: plain white patient-info card, matching BillSummary/Payment/DentalChart -->
		<Border Grid.Row="0" Style="{StaticResource ElevatedCardStyle}" Margin="12,10,12,0">
			<VerticalStackLayout Spacing="2">
				<Label Text="{Binding PatientName, StringFormat='Patient: {0}'}"
                       FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
				<Label Text="{Binding MeasurementDate, StringFormat='Measured: {0:MMM dd, yyyy}'}"
                       FontSize="13" TextColor="{StaticResource TextSecondary}"/>
			</VerticalStackLayout>
		</Border>

		<!-- Measurements List -->
		<ScrollView Grid.Row="1">
			<StackLayout Padding="12,10,12,16" Spacing="12">

				<Label Text="SKELETAL MEASUREMENTS" Style="{StaticResource CardSectionTitleStyle}"
                       FontSize="13" Margin="0,4,0,4"/>

				<CollectionView ItemsSource="{Binding Measurements}" SelectionMode="Single">
					<CollectionView.ItemTemplate>
						<DataTemplate>
							<Border BackgroundColor="{StaticResource White}"
                                    Stroke="{StaticResource Gray100}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="14" Margin="0,0,0,10">
								<VerticalStackLayout Spacing="8">

									<!-- Header: Name and Value -->
									<Grid ColumnDefinitions="*,Auto">
										<StackLayout Grid.Column="0" Spacing="2">
											<Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}"/>
											<Label Text="{Binding Description}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
										</StackLayout>

										<StackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
											<Label FontSize="15" FontAttributes="Bold"
                                                   TextColor="{Binding StatusColor}">
												<Label.FormattedText>
													<FormattedString>
														<Span Text="{Binding Value, StringFormat='{0:F1}'}"
                                                              FontAttributes="Bold"/>
														<Span Text=" "/>
														<Span Text="{Binding Unit}"/>
													</FormattedString>
												</Label.FormattedText>
											</Label>
											<Label Text="{Binding Status}" FontSize="12"
                                                   TextColor="{Binding StatusColor}"/>
										</StackLayout>
									</Grid>

									<!-- Normal Range -->
									<StackLayout Spacing="4">
										<StackLayout Orientation="Horizontal" Spacing="8">
											<Label Text="{Binding Min, StringFormat='Normal: {0:F0}'}"
                                                   FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Start"/>
											<Label Text="{Binding Max, StringFormat='to {0:F0}'}"
                                                   FontSize="11" TextColor="{StaticResource TextSecondary}"/>
										</StackLayout>

										<!-- Progress Bar (visual comparison) -->
										<Grid ColumnDefinitions="*" HeightRequest="24">
											<!-- Normal range background -->
											<ProgressBar Grid.Column="0" Progress="1"
                                                        ProgressColor="{StaticResource Gray200}"
                                                        HeightRequest="6"
                                                        Margin="0,9"/>

											<!-- Value indicator -->
											<ProgressBar Grid.Column="0" Progress="{Binding NormalizedValue}"
                                                        ProgressColor="{Binding StatusColor}"
                                                        HeightRequest="8"
                                                        Margin="0,8"/>
										</Grid>
									</StackLayout>

									<!-- Status Badge -->
									<Frame Padding="8,4" CornerRadius="4" BorderColor="{Binding StatusColor}"
                                          BackgroundColor="{Binding StatusColor, Converter={StaticResource ColorToLight}}"
                                          HasShadow="False" HorizontalOptions="Start">
										<Label Text="{Binding Status}" FontSize="12" FontAttributes="Bold"
                                              TextColor="{Binding StatusColor}"/>
									</Frame>

								</VerticalStackLayout>
							</Border>
						</DataTemplate>
					</CollectionView.ItemTemplate>
				</CollectionView>

				<!-- Summary — legend colors (green/orange/blue) are clinical, documented meaning; left unchanged -->
				<Border BackgroundColor="{StaticResource Secondary}" Stroke="Transparent" StrokeShape="RoundRectangle 12"
                        Padding="14" Margin="0,8,0,0">
					<VerticalStackLayout Spacing="4">
						<Label Text="📋 Summary" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
						<Label Text="Green = Normal | Orange = High | Blue = Low"
                               FontSize="12" TextColor="{StaticResource TextSecondary}"/>
					</VerticalStackLayout>
				</Border>

			</StackLayout>
		</ScrollView>

	</Grid>

</ContentPage>
