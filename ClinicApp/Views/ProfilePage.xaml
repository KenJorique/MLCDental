<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClinicApp.ViewModels"
             x:Class="ClinicApp.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Profile"
             Shell.BackgroundColor="{StaticResource Primary}"
             Shell.TitleColor="White"
             Shell.ForegroundColor="White"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="16">

			<!-- Name + role — the page's visual anchor, same weight as other pages' headers -->
			<VerticalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,8,0,4">
				<Label Text="{Binding FullName}" FontSize="22" FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
				<Label Text="{Binding Role}" FontSize="15" TextColor="{StaticResource Gray600}"
                       HorizontalOptions="Center"/>
			</VerticalStackLayout>

			<!-- ── ACCOUNT INFO — read-only, set by admin ── -->
			<Border Style="{StaticResource ElevatedCardStyle}">
				<VerticalStackLayout Spacing="10">
					<Grid ColumnDefinitions="*,Auto">
						<Label Grid.Column="0" Text="Account Info" Style="{StaticResource CardSectionTitleStyle}"/>
						<Label Grid.Column="1" Text="Set by admin"
                               Style="{StaticResource MutedCaptionStyle}" VerticalOptions="Center"/>
					</Grid>
					<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>
					<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10">
						<Label Grid.Row="0" Grid.Column="0" Text="Full Name"
                               Style="{StaticResource CardRowLabelStyle}"/>
						<Label Grid.Row="0" Grid.Column="1" Text="{Binding FullName}"
                               Style="{StaticResource CardRowValueStyle}"/>
						<Label Grid.Row="1" Grid.Column="0" Text="Role"
                               Style="{StaticResource CardRowLabelStyle}"/>
						<Label Grid.Row="1" Grid.Column="1" Text="{Binding Role}"
                               Style="{StaticResource CardRowValueStyle}"/>
					</Grid>
				</VerticalStackLayout>
			</Border>

			<!-- ── CONTACT INFO — the only fields the staff member can edit themselves ── -->
			<Border Style="{StaticResource ElevatedCardStyle}">
				<VerticalStackLayout Spacing="10">
					<Grid ColumnDefinitions="*,Auto">
						<Label Grid.Column="0" Text="Contact Info" Style="{StaticResource CardSectionTitleStyle}"/>
						<Label Grid.Column="1" FontFamily="MaterialSymbolsRounded" Text="&#xe3c9;"
                               FontSize="18" TextColor="{StaticResource Primary}"
                               IsVisible="{Binding IsEditingContact, Converter={StaticResource InvertedBoolConverter}}">
							<Label.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding EditContactCommand}"/>
							</Label.GestureRecognizers>
						</Label>
					</Grid>
					<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

					<!-- Read view -->
					<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10"
                          IsVisible="{Binding IsEditingContact, Converter={StaticResource InvertedBoolConverter}}">
						<Label Grid.Row="0" Grid.Column="0" Text="Contact Number"
                               Style="{StaticResource CardRowLabelStyle}"/>
						<Label Grid.Row="0" Grid.Column="1" Text="{Binding ContactNo}"
                               Style="{StaticResource CardRowValueStyle}"/>
						<Label Grid.Row="1" Grid.Column="0" Text="Email"
                               Style="{StaticResource CardRowLabelStyle}"/>
						<Label Grid.Row="1" Grid.Column="1" Text="{Binding Email}"
                               Style="{StaticResource CardRowValueStyle}"/>
					</Grid>

					<!-- Edit view -->
					<VerticalStackLayout IsVisible="{Binding IsEditingContact}" Spacing="0">
						<Label Text="Contact Number" Style="{StaticResource FormFieldLabel}" Margin="0,0,0,2"/>
						<Border Style="{StaticResource FormInputBox}">
							<Entry Text="{Binding ContactNo}" Keyboard="Telephone" MaxLength="11"
                                   Style="{StaticResource FormEntry}"/>
						</Border>
						<Label Text="Email" Style="{StaticResource FormFieldLabel}"/>
						<Border Style="{StaticResource FormInputBox}">
							<Entry Text="{Binding Email}" Keyboard="Email" Style="{StaticResource FormEntry}"/>
						</Border>
						<Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,14,0,0">
							<Button Grid.Column="0" Text="Cancel"
                                    Command="{Binding CancelEditContactCommand}"
                                    Style="{StaticResource SecondaryActionButtonStyle}"/>
							<Button Grid.Column="1" Text="Save"
                                    Command="{Binding SaveContactCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"/>
						</Grid>
					</VerticalStackLayout>
				</VerticalStackLayout>
			</Border>

			<!-- ── GOOGLE ACCOUNT — moved from Menu ── -->
			<Border Style="{StaticResource ElevatedCardStyle}">
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
					<!-- Official Google "G" logo asset. -->
					<Image Grid.Column="0" Source="google_logo.png"
                           WidthRequest="24" HeightRequest="24"
                           VerticalOptions="Start" Margin="0,6,0,0"/>
					<VerticalStackLayout Grid.Column="1" Spacing="2">
						<Label Text="Google Account" FontSize="16"
                               FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
						<Label Text="{Binding GoogleEmail}"
                               FontSize="13" TextColor="{StaticResource Gray500}"/>
					</VerticalStackLayout>
					<Button Grid.Column="2"
                            Text="{Binding GoogleButtonText}"
                            BackgroundColor="{StaticResource PrimaryGreen}"
                            TextColor="White" CornerRadius="8"
                            FontSize="12" HeightRequest="36" VerticalOptions="Center"
                            Command="{Binding GoogleSignInCommand}"/>
				</Grid>
			</Border>

			<!-- ── LOG OUT — same card treatment as every other section, red instead of green ── -->
			<Border Style="{StaticResource ElevatedCardStyle}">
				<Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
					<Grid.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding LogoutCommand}"/>
					</Grid.GestureRecognizers>
					<Label Grid.Column="0" FontFamily="MaterialSymbolsRoundedFilled" Text="&#xe9ba;"
                           FontSize="24" TextColor="Crimson" VerticalOptions="Center"/>
					<Label Grid.Column="1" Text="Log Out" FontSize="16" FontAttributes="Bold"
                           TextColor="Crimson" VerticalOptions="Center"/>
				</Grid>
			</Border>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
