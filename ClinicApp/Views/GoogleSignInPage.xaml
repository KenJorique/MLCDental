<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClinicApp.Views.GoogleSignInPage"
             Title="Google Tasks"
             BackgroundColor="{StaticResource PageBg}">

	<VerticalStackLayout Padding="28" Spacing="20"
                         VerticalOptions="Center">

		<!-- Icon badge, matching the circular icon-badge treatment used elsewhere in the app -->
		<Border WidthRequest="84" HeightRequest="84"
                BackgroundColor="{StaticResource Secondary}"
                Stroke="Transparent"
                HorizontalOptions="Center">
			<Border.StrokeShape>
				<RoundRectangle CornerRadius="42"/>
			</Border.StrokeShape>
			<Label Text="&#xe2e6;" FontFamily="MaterialSymbolsRounded"
                   FontSize="40" TextColor="{StaticResource Primary}"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
		</Border>

		<Label Text="Connect Google Tasks"
               FontSize="20" FontAttributes="Bold"
               TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>

		<Label Text="Approved appointments will automatically appear in your Google Tasks so you never miss a scheduled patient."
               FontSize="14" TextColor="{StaticResource Gray500}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               LineHeight="1.4"/>

		<Border BackgroundColor="{StaticResource Secondary}" Stroke="Transparent" Padding="16">
			<Border.StrokeShape>
				<RoundRectangle CornerRadius="14"/>
			</Border.StrokeShape>
			<VerticalStackLayout Spacing="10">
				<HorizontalStackLayout Spacing="8">
					<Label Text="&#xe5ca;" FontFamily="MaterialSymbolsRounded" FontSize="16" TextColor="{StaticResource Primary}"/>
					<Label Text="Tasks created automatically on approval" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
				</HorizontalStackLayout>
				<HorizontalStackLayout Spacing="8">
					<Label Text="&#xe5ca;" FontFamily="MaterialSymbolsRounded" FontSize="16" TextColor="{StaticResource Primary}"/>
					<Label Text="Tasks marked complete when appointment done" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
				</HorizontalStackLayout>
			</VerticalStackLayout>
		</Border>

		<Button x:Name="SignInButton"
                Text="Connect to Google Tasks"
                Style="{StaticResource PrimaryActionButtonStyle}"
                Clicked="OnSignInClicked"/>

		<Button Text="Skip for now"
                Style="{StaticResource SecondaryActionButtonStyle}"
                Clicked="OnSkipClicked"/>

		<!-- Transient in-progress message only — the final result (success/error) now shows as a popup instead. -->
		<Label x:Name="StatusLabel"
               FontSize="12"
               TextColor="{StaticResource TextMuted}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               IsVisible="False"/>

	</VerticalStackLayout>
</ContentPage>
