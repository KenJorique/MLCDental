<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClinicApp.ViewModels.ServicesRelatedVM"
             x:Class="ClinicApp.Views.ServicesRelated.AddServicePage"
             x:DataType="vm:AddServiceViewModel"
             Title="{Binding PageTitle}"
             Shell.NavBarIsVisible="True"
             Shell.BackgroundColor="{StaticResource PrimaryGreen}"
             Shell.TitleColor="White"
             Shell.ForegroundColor="White"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}"
             x:Name="ThisPage">

	<!-- Intercept the nav-bar back arrow so it goes through the same
         discard-confirmation flow as the Cancel button below. -->
	<Shell.BackButtonBehavior>
		<BackButtonBehavior Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.CancelCommand}"/>
	</Shell.BackButtonBehavior>

	<Grid RowDefinitions="*,Auto">

		<ScrollView Grid.Row="0">
			<VerticalStackLayout Padding="20,10,20,24">

				<Label Style="{StaticResource FormFieldLabel}">
					<Label.FormattedText>
						<FormattedString>
							<Span Text="Service Name "/>
							<Span Text="*" TextColor="{StaticResource PrimaryGreen}"/>
						</FormattedString>
					</Label.FormattedText>
				</Label>
				<Border Style="{StaticResource FormInputBox}">
					<Entry Placeholder="Enter service name"
                           Text="{Binding ServiceName}"
                           Style="{StaticResource FormEntry}"/>
				</Border>

				<Label Style="{StaticResource FormFieldLabel}">
					<Label.FormattedText>
						<FormattedString>
							<Span Text="Price "/>
							<Span Text="*" TextColor="{StaticResource PrimaryGreen}"/>
						</FormattedString>
					</Label.FormattedText>
				</Label>
				<Border Style="{StaticResource FormInputBox}">
					<Grid ColumnDefinitions="Auto,*">
						<Label Grid.Column="0" Text="₱"
                               VerticalOptions="Center"
                               Margin="0,0,6,0"
                               FontSize="14"
                               TextColor="{StaticResource TextMuted}"/>
						<Entry Grid.Column="1"
                               Placeholder="0.00"
                               Text="{Binding ServicePrice}"
                               Keyboard="Numeric"
                               Style="{StaticResource FormEntry}"/>
					</Grid>
				</Border>

				<Label Text="Description" Style="{StaticResource FormFieldLabel}"/>
				<Border Style="{StaticResource FormInputBoxTall}">
					<Editor Placeholder="Enter description (optional)"
                            Text="{Binding ServiceDescription}"
                            Style="{StaticResource FormEditor}"/>
				</Border>

				<!-- ══ Multi-session configuration ══ -->
				<BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}" Margin="0,10,0,4"/>

				<Label Text="Multi-Session Treatment" Style="{StaticResource FormSectionHeader}"/>

				<Grid ColumnDefinitions="Auto,Auto,*,Auto">
					<Label Grid.Column="0" Text="Requires Multiple Sessions"
                           Style="{StaticResource FormFieldLabel}"
                           Margin="0"
                           VerticalOptions="Center"/>
					<Label Grid.Column="1"
                           FontFamily="MaterialSymbolsRounded"
                           Text="&#xe88e;"
                           FontSize="19"
                           TextColor="{StaticResource Primary}"
                           VerticalOptions="Center"
                           Margin="6,0,0,0">
						<Label.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding ShowHelpCommand}"
                                CommandParameter="Turn this on for treatments like Dental Crown, Root Canal, or Braces Adjustment that need a follow-up visit."/>
						</Label.GestureRecognizers>
					</Label>
					<Switch Grid.Column="3" IsToggled="{Binding RequiresMultipleSessions}"/>
				</Grid>

				<VerticalStackLayout Spacing="12" IsVisible="{Binding ShowSessionFields}">

					<Grid ColumnDefinitions="Auto,Auto,*">
						<Label Grid.Column="0" Text="Total Sessions" Style="{StaticResource FormFieldLabel}"/>
						<Label Grid.Column="1"
                               FontFamily="MaterialSymbolsRounded"
                               Text="&#xe88e;"
                               FontSize="19"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"
                               Margin="6,10,0,0">
							<Label.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding ShowHelpCommand}"
                                    CommandParameter="Leave as-is for a fixed count (e.g. 2 for Crown). For open-ended/recurring treatments like Braces Adjustment, staff will just keep scheduling follow-ups — set this to 1 session if there's no fixed total."/>
							</Label.GestureRecognizers>
						</Label>
					</Grid>
					<Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="12" HorizontalOptions="Center">
						<Button Grid.Column="0" Text="−"
                                Command="{Binding DecrementTotalSessionsCommand}"
                                FontSize="24" FontAttributes="Bold"
                                WidthRequest="50" HeightRequest="50" Padding="0"
                                CornerRadius="12"
                                BackgroundColor="{StaticResource Secondary}"
                                TextColor="{StaticResource Primary}">
							<Button.Triggers>
								<DataTrigger TargetType="Button" Binding="{Binding CanDecrementTotalSessions}" Value="False">
									<Setter Property="BackgroundColor" Value="{StaticResource Gray200}"/>
									<Setter Property="TextColor" Value="{StaticResource Gray400}"/>
								</DataTrigger>
							</Button.Triggers>
						</Button>
						<Border Grid.Column="1" Style="{StaticResource FormInputBox}" WidthRequest="60">
							<Entry Text="{Binding TotalSessions}"
                                   Keyboard="Numeric"
                                   Placeholder="2"
                                   HorizontalTextAlignment="Center"
                                   Style="{StaticResource FormEntry}"/>
						</Border>
						<Button Grid.Column="2" Text="+"
                                Command="{Binding IncrementTotalSessionsCommand}"
                                FontSize="24" FontAttributes="Bold"
                                WidthRequest="50" HeightRequest="50" Padding="0"
                                CornerRadius="12"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}">
							<Button.Triggers>
								<DataTrigger TargetType="Button" Binding="{Binding CanIncrementTotalSessions}" Value="False">
									<Setter Property="BackgroundColor" Value="{StaticResource Gray200}"/>
									<Setter Property="TextColor" Value="{StaticResource Gray400}"/>
								</DataTrigger>
							</Button.Triggers>
						</Button>
					</Grid>

					<Grid ColumnDefinitions="Auto,Auto,*">
						<Label Grid.Column="0" Text="Recommended Follow-up Interval (days)" Style="{StaticResource FormFieldLabel}"/>
						<Label Grid.Column="1"
                               FontFamily="MaterialSymbolsRounded"
                               Text="&#xe88e;"
                               FontSize="19"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"
                               Margin="6,10,0,0">
							<Label.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding ShowHelpCommand}"
                                    CommandParameter="Used to suggest the next appointment date — staff can still pick a different date manually."/>
							</Label.GestureRecognizers>
						</Label>
					</Grid>
					<Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="12" HorizontalOptions="Center">
						<Button Grid.Column="0" Text="−"
                                Command="{Binding DecrementFollowupIntervalCommand}"
                                FontSize="24" FontAttributes="Bold"
                                WidthRequest="50" HeightRequest="50" Padding="0"
                                CornerRadius="12"
                                BackgroundColor="{StaticResource Secondary}"
                                TextColor="{StaticResource Primary}">
							<Button.Triggers>
								<DataTrigger TargetType="Button" Binding="{Binding CanDecrementFollowupInterval}" Value="False">
									<Setter Property="BackgroundColor" Value="{StaticResource Gray200}"/>
									<Setter Property="TextColor" Value="{StaticResource Gray400}"/>
								</DataTrigger>
							</Button.Triggers>
						</Button>
						<Border Grid.Column="1" Style="{StaticResource FormInputBox}" WidthRequest="60">
							<Entry Text="{Binding FollowupIntervalDays}"
                                   Keyboard="Numeric"
                                   Placeholder="14"
                                   HorizontalTextAlignment="Center"
                                   Style="{StaticResource FormEntry}"/>
						</Border>
						<Button Grid.Column="2" Text="+"
                                Command="{Binding IncrementFollowupIntervalCommand}"
                                FontSize="24" FontAttributes="Bold"
                                WidthRequest="50" HeightRequest="50" Padding="0"
                                CornerRadius="12"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}">
							<Button.Triggers>
								<DataTrigger TargetType="Button" Binding="{Binding CanIncrementFollowupInterval}" Value="False">
									<Setter Property="BackgroundColor" Value="{StaticResource Gray200}"/>
									<Setter Property="TextColor" Value="{StaticResource Gray400}"/>
								</DataTrigger>
							</Button.Triggers>
						</Button>
					</Grid>

				</VerticalStackLayout>

			</VerticalStackLayout>
		</ScrollView>

		<!-- Cancel = Secondary (pale green) style; Save = Primary green — matches the green/red action rule (red is reserved for discard/remove, handled inside CancelCommand's confirmation popup, not this button itself). -->
		<Grid Grid.Row="1" ColumnDefinitions="*,*" Padding="16,12" ColumnSpacing="12"
              BackgroundColor="{StaticResource White}">
			<Button Grid.Column="0" Text="Cancel"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryActionButtonStyle}"/>
			<Button Grid.Column="1" Text="Save"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryActionButtonStyle}"/>
		</Grid>

	</Grid>
</ContentPage>
