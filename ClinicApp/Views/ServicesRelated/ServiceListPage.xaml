<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ClinicApp.ViewModels.ServicesRelatedVM"
    x:Class="ClinicApp.Views.ServicesRelated.ServiceListPage"
    x:DataType="vm:ServiceViewModel"
    Title="Services"
    Shell.NavBarIsVisible="True"
    Shell.BackgroundColor="{StaticResource PrimaryGreen}"
    Shell.TitleColor="White"
    Shell.ForegroundColor="White"
    Shell.TabBarIsVisible="False"
    BackgroundColor="{StaticResource PageBg}">

	<Grid RowDefinitions="Auto,*">

		<!-- ── SEARCH + SORT BAR ── -->
		<VerticalStackLayout Grid.Row="0"
                             BackgroundColor="{StaticResource PrimaryGreen}"
                             Padding="16,0,16,14">
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
				<Border Grid.Column="0"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        HeightRequest="40">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="20"/>
					</Border.StrokeShape>
					<Grid ColumnDefinitions="Auto,*" Padding="12,0" ColumnSpacing="8">
						<Label Grid.Column="0"
                               FontFamily="MaterialSymbolsRounded"
                               Text="&#xe8b6;"
                               FontSize="17"
                               TextColor="{StaticResource TextMuted}"
                               VerticalOptions="Center"/>
						<Entry Grid.Column="1"
                               Text="{Binding SearchText}"
                               Placeholder="Search services..."
                               PlaceholderColor="{StaticResource TextMuted}"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="13"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"/>
					</Grid>
				</Border>

				<Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        StrokeThickness="0"
                        HeightRequest="40" WidthRequest="40"
                        VerticalOptions="Center">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding ShowSortOptionsCommand}"/>
					</Border.GestureRecognizers>
					<Label FontFamily="MaterialSymbolsRounded"
                           Text="&#xe152;"
                           FontSize="24"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
				</Border>
			</Grid>
		</VerticalStackLayout>

		<!-- ── SERVICE LIST ── -->
		<RefreshView Grid.Row="1"
                     Command="{Binding LoadServicesCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
			<CollectionView ItemsSource="{Binding FilteredCards}"
                    SelectionMode="None"
                    Margin="28,12,28,0"
                    IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">

				<CollectionView.Footer>
					<BoxView HeightRequest="50" Color="Transparent"/>
				</CollectionView.Footer>

				<CollectionView.EmptyView>
					<Grid HorizontalOptions="Fill" VerticalOptions="Fill">
						<VerticalStackLayout Spacing="8"
								 HorizontalOptions="Center"
								 VerticalOptions="Center">
							<Label Text="{Binding EmptyStateTitle}"
							   Style="{StaticResource EmptyStateTitleStyle}"
							   HorizontalTextAlignment="Center"/>
							<Label Text="{Binding EmptyStateMessage}"
							   Style="{StaticResource EmptyStateSubtitleStyle}"
							   HorizontalTextAlignment="Center"/>
						</VerticalStackLayout>
					</Grid>
				</CollectionView.EmptyView>

				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="vm:ServiceCardViewModel">
						<Border Style="{StaticResource ElevatedCardStyle}"
                                Padding="16,14"
                                Margin="10,10,10,0">
							<Border.GestureRecognizers>
								<TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                              Path=BindingContext.ShowActionSheetCommand}"
                                    CommandParameter="{Binding .}"/>
							</Border.GestureRecognizers>

							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
								<Label Grid.Column="0"
                                       Text="{Binding ServiceName}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="Center"/>
								<Label Grid.Column="1"
                                       Text="{Binding PriceDisplay}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource PrimaryGreen}"
                                       VerticalOptions="Center"/>
							</Grid>
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</RefreshView>

		<!-- Loading -->
		<VerticalStackLayout Grid.Row="1"
                             IsVisible="{Binding IsBusy}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="8">
			<ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{StaticResource PrimaryGreen}"
                               HeightRequest="36" WidthRequest="36"/>
			<Label Text="Loading services..."
                   Style="{StaticResource MutedCaptionStyle}"
                   HorizontalTextAlignment="Center"/>
		</VerticalStackLayout>

		<!-- FAB — pill-shaped add button, floats over the list content -->
		<Button Grid.Row="1"
                Text="+ Add Service"
                Command="{Binding GoToAddServiceCommand}"
                Style="{StaticResource FabStyle}"
                VerticalOptions="End"
                HorizontalOptions="End"
                Margin="0,0,20,24">
			<Button.Shadow>
				<Shadow Brush="Black" Opacity="0.3" Radius="8" Offset="0,3"/>
			</Button.Shadow>
		</Button>

	</Grid>
</ContentPage>
