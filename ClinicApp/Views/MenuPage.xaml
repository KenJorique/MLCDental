<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClinicApp.Views.MenuPage"
             Title="Menu"
             BackgroundColor="{StaticResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- ── PROFILE HEADER ── -->
            <Border Padding="16" BackgroundColor="White" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="Google Account" FontSize="14"
                               FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="{Binding GoogleEmail}"
                               FontSize="12" TextColor="{StaticResource TextMuted}"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="2"
                            Text="{Binding GoogleButtonText}"
                            BackgroundColor="{StaticResource PrimaryGreen}"
                            TextColor="White" CornerRadius="8"
                            FontSize="12" HeightRequest="36" VerticalOptions="Center"
                            Command="{Binding GoogleSignInCommand}"/>
                </Grid>
            </Border>

            <!-- ── MENU ITEMS ── -->
            <Border Padding="4" BackgroundColor="White" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="0">

                    <!-- Service and Pricing -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,14" ColumnSpacing="14">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToServicesCommand}"/>
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" WidthRequest="44" HeightRequest="44"
                                BackgroundColor="#E8F5E9" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Label FontFamily="MaterialSymbolsRounded" Text="&#xe3f4;"
                                   FontSize="22" TextColor="{StaticResource PrimaryGreen}"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Service and Pricing" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Manage dental services and pricing" FontSize="12"
                                   TextColor="{StaticResource TextMuted}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" FontFamily="MaterialSymbolsRounded" Text="&#xe5cc;"
                               FontSize="18" TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" Margin="14,0"/>

                    <!-- Medical Supply -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,14" ColumnSpacing="14">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToSupplyCommand}"/>
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" WidthRequest="44" HeightRequest="44"
                                BackgroundColor="#E8F5E9" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Label FontFamily="MaterialSymbolsRounded" Text="&#xe8b8;"
                                   FontSize="22" TextColor="{StaticResource PrimaryGreen}"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Medical Supply" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Track supplies and monitor stock levels" FontSize="12"
                                   TextColor="{StaticResource TextMuted}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" FontFamily="MaterialSymbolsRounded" Text="&#xe5cc;"
                               FontSize="18" TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" Margin="14,0"/>

                    <!-- Payment Management (NEW) -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,14" ColumnSpacing="14">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToPaymentManagementCommand}"/>
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" WidthRequest="44" HeightRequest="44"
                                BackgroundColor="#E8F5E9" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Label FontFamily="MaterialSymbolsRounded" Text="&#xe8e1;"
                                   FontSize="22" TextColor="{StaticResource PrimaryGreen}"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Payment Management" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Track payments and outstanding balances" FontSize="12"
                                   TextColor="{StaticResource TextMuted}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" FontFamily="MaterialSymbolsRounded" Text="&#xe5cc;"
                               FontSize="18" TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" Margin="14,0"/>

                    <!-- User Management -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="14,14" ColumnSpacing="14">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToUsersCommand}"/>
                        </Grid.GestureRecognizers>
                        <Border Grid.Column="0" WidthRequest="44" HeightRequest="44"
                                BackgroundColor="#E8F5E9" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Label FontFamily="MaterialSymbolsRounded" Text="&#xe7fd;"
                                   FontSize="22" TextColor="{StaticResource PrimaryGreen}"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="User Management" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Manage staff accounts and access" FontSize="12"
                                   TextColor="{StaticResource TextMuted}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" FontFamily="MaterialSymbolsRounded" Text="&#xe5cc;"
                               FontSize="18" TextColor="{StaticResource TextMuted}" VerticalOptions="Center"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>