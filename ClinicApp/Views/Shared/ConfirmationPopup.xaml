<?xml version="1.0" encoding="utf-8" ?>
<!-- Reusable Yes/No confirmation dialog: dimmed backdrop, centered rounded card that sizes to its content. -->
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="ClinicApp.Views.Shared.ConfirmationPopup"
    Color="Transparent">

	<!-- No WidthRequest, so it shrinks/grows with the title + message.
         Min/Max keep it from looking too skinny or too wide. -->
	<Border BackgroundColor="White"
            MinimumWidthRequest="240"
            MaximumWidthRequest="340"
            Padding="24,22"
            StrokeThickness="0">
		<Border.StrokeShape>
			<RoundRectangle CornerRadius="20"/>
		</Border.StrokeShape>

		<VerticalStackLayout Spacing="18">

			<!-- Bold headline, set from code-behind. -->
			<Label x:Name="TitleLabel"
                   FontSize="19" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   LineBreakMode="WordWrap"/>

			<!-- Explanation text, set from code-behind. -->
			<Label x:Name="MessageLabel"
                   FontSize="14"
                   TextColor="{StaticResource TextSecondary}"
                   LineBreakMode="WordWrap"/>

			<!-- Cancel / Confirm buttons. -->
			<Grid ColumnDefinitions="*,*" ColumnSpacing="12">
				<Button Grid.Column="0" Text="Cancel" Clicked="OnCancelClicked"
                        BackgroundColor="{StaticResource Gray100}" TextColor="Black"/>
				<Button Grid.Column="1" x:Name="ConfirmButton" Text="Delete" Clicked="OnConfirmClicked"
                        BackgroundColor="Crimson" TextColor="White"/>
			</Grid>

		</VerticalStackLayout>
	</Border>

</toolkit:Popup>
