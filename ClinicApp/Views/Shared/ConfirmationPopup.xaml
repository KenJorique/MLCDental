<?xml version="1.0" encoding="utf-8" ?>
<!-- Reusable Yes/No confirmation dialog: dimmed backdrop, centered rounded card that sizes to its content. -->
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="ClinicApp.Views.Shared.ConfirmationPopup"
    Color="Transparent">

	<!-- Fixed width so the card looks intentional; height auto-fits the title/message text. -->
	<Border BackgroundColor="{StaticResource White}"
            WidthRequest="320"
            Padding="24,22"
            StrokeThickness="0">
		<Border.StrokeShape>
			<RoundRectangle CornerRadius="20"/>
		</Border.StrokeShape>

		<VerticalStackLayout Spacing="18">

			<!-- Bold headline, set from code-behind. -->
			<Label x:Name="TitleLabel"
                   FontSize="19" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   LineBreakMode="WordWrap"/>

			<!-- Explanation text, set from code-behind. -->
			<Label x:Name="MessageLabel"
                   FontSize="14"
                   TextColor="{StaticResource TextSecondary}"
                   LineBreakMode="WordWrap"/>

			<!-- Cancel / Confirm buttons — ConfirmButton's color is always set explicitly from code-behind, never left at a default. -->
			<Grid ColumnDefinitions="*,*" ColumnSpacing="12">
				<Button Grid.Column="0" x:Name="CancelButton" Text="Cancel" Clicked="OnCancelClicked"
                        BackgroundColor="{StaticResource Gray100}" TextColor="{StaticResource TextPrimary}"/>
				<Button Grid.Column="1" x:Name="ConfirmButton" Text="Delete" Clicked="OnConfirmClicked"
                        TextColor="{StaticResource White}"/>
			</Grid>

		</VerticalStackLayout>
	</Border>

</toolkit:Popup>
