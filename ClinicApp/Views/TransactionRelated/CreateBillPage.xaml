<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClinicApp.ViewModels.TransactionVM"
             xmlns:models="clr-namespace:ClinicApp.Models"
             xmlns:behaviors="clr-namespace:ClinicApp.Behaviors"
             x:DataType="vm:CreateBillViewModel"
             x:Class="ClinicApp.Views.CreateBillPage"
             Shell.NavBarIsVisible="True"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F5F5F5">

	<ContentPage.Title>
		<x:String>Create Bill</x:String>
	</ContentPage.Title>

	<Grid>
		<ScrollView>
			<ScrollView.Behaviors>
				<behaviors:ScrollToTopBehavior Trigger="{Binding ScrollTrigger}"/>
			</ScrollView.Behaviors>
			<VerticalStackLayout Padding="16,16,16,170" Spacing="14">

				<!-- Available services (bound to FilteredServices: AvailableServiceItem) -->
				<Frame BackgroundColor="White" BorderColor="{StaticResource Gray200}"
   CornerRadius="12" Padding="14" HasShadow="False">
					<VerticalStackLayout Spacing="10">

						<Label Text="Available Services"
		   FontSize="14" FontAttributes="Bold"
		   TextColor="{StaticResource TextPrimary}"/>

						<!-- Search bar -->
						<Border Style="{StaticResource FormInputBox}">
							<Grid ColumnDefinitions="Auto,*">
								<Label Grid.Column="0" Text="🔍"
				   FontSize="14" VerticalOptions="Center"
				   Margin="0,0,6,0"/>
								<Entry Grid.Column="1"
				   Style="{StaticResource FormEntry}"
				   Text="{Binding ServiceSearch}"
				   Placeholder="Search services..."/>
							</Grid>
						</Border>

						<ActivityIndicator IsRunning="{Binding IsBusy}"
					   IsVisible="{Binding IsBusy}"
					   Color="{StaticResource Primary}" HeightRequest="36"/>

						<Label Text="No services found"
		   FontSize="12" TextColor="{StaticResource TextMuted}"
		   IsVisible="{Binding FilteredServices.Count,
                   Converter={StaticResource IntEqualZeroConverter}}"/>

						<!-- Filtered services list -->
						<VerticalStackLayout
		BindableLayout.ItemsSource="{Binding FilteredServices}"
		Spacing="0">
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="vm:AvailableServiceItem">
									<VerticalStackLayout Spacing="0">
										<Grid ColumnDefinitions="*,Auto"
						  Padding="4,8" ColumnSpacing="8">
											<VerticalStackLayout Grid.Column="0" Spacing="2">
												<Label Text="{Binding Name}"
								   FontSize="13" TextColor="{StaticResource TextPrimary}"
								   LineBreakMode="WordWrap"/>
												<Label Text="{Binding PriceDisplay}"
								   FontSize="12" TextColor="{StaticResource Primary}"
								   FontAttributes="Bold"/>
												<Label Text="🦷 Requires tooth numbers"
								   FontSize="10" TextColor="#1565C0"
								   IsVisible="{Binding RequiresTeeth}"/>
												<Label Text="⭐ Installment available"
								   FontSize="10" TextColor="{StaticResource Gold}"
								   IsVisible="{Binding Name,
                                           Converter={StaticResource InstallmentConverter}}"/>
											</VerticalStackLayout>
											<Button Grid.Column="1"
								Text="+"
								FontSize="20" FontAttributes="Bold"
								BackgroundColor="{StaticResource Primary}"
								TextColor="White"
								CornerRadius="8"
								HeightRequest="38" WidthRequest="38"
								Padding="0"
								Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                              Path=BindingContext.ToggleServiceCommand}"
								CommandParameter="{Binding .}">
												<Button.Triggers>
													<DataTrigger TargetType="Button" Binding="{Binding IsAddDisabled}" Value="True">
														<Setter Property="Text" Value="−"/>
														<Setter Property="BackgroundColor" Value="#D32F2F"/>
													</DataTrigger>
												</Button.Triggers>
											</Button>
										</Grid>
										<BoxView HeightRequest="0.5" Color="{StaticResource Gray100}"/>
									</VerticalStackLayout>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</VerticalStackLayout>

					</VerticalStackLayout>
				</Frame>

				<!-- Notes -->
				<Frame BackgroundColor="White" BorderColor="{StaticResource Gray200}"
				   CornerRadius="12" Padding="14" HasShadow="False">
					<VerticalStackLayout Spacing="6">
						<Label Text="Notes (optional)"
						   FontSize="12" TextColor="{StaticResource TextMuted}"/>
						<Border Style="{StaticResource FormInputBoxTall}">
							<Editor Style="{StaticResource FormEditor}"
								Text="{Binding Notes}"
								Placeholder="Additional notes..."/>
						</Border>
					</VerticalStackLayout>
				</Frame>

				<!-- Error -->
				<Frame BackgroundColor="#FCEAEA" BorderColor="#FFCDD2"
				   CornerRadius="12" Padding="12" HasShadow="False"
				   IsVisible="{Binding HasError}">
					<Label Text="{Binding ErrorMessage}"
					   FontSize="12" TextColor="#D32F2F"/>
				</Frame>

				<Button Text="Cancel"
                    BackgroundColor="Transparent"
                    BorderColor="{StaticResource Gray200}" BorderWidth="1"
                    TextColor="{StaticResource Gray500}" CornerRadius="12"
                    HeightRequest="44" FontSize="13"
                    Command="{Binding CancelCommand}"/>

			</VerticalStackLayout>
		</ScrollView>

		<!-- Loading overlay -->
		<Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000" ZIndex="20">
			<VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12">
				<ActivityIndicator IsRunning="True" Color="White"
                                   WidthRequest="40" HeightRequest="40"/>
				<Label Text="Saving..." TextColor="White"
                       FontSize="14" HorizontalOptions="Center"/>
			</VerticalStackLayout>
		</Grid>

	</Grid>
</ContentPage>
