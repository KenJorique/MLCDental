<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClinicApp.ViewModels.TransactionVM"
             xmlns:models="clr-namespace:ClinicApp.Models"
             xmlns:behaviors="clr-namespace:ClinicApp.Behaviors"
             x:DataType="vm:CreateBillViewModel"
             x:Class="ClinicApp.Views.CreateBillPage"
             Shell.NavBarIsVisible="True"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F5F5F5">

	<ContentPage.Title>
		<x:String>Create Bill</x:String>
	</ContentPage.Title>

	<Grid>
		<ScrollView>
			<VerticalStackLayout Padding="16,16,16,170" Spacing="14">

				<!-- Available services (bound to FilteredServices: AvailableServiceItem) -->
				<Frame BackgroundColor="White" BorderColor="{StaticResource Gray200}"
   CornerRadius="12" Padding="14" HasShadow="False">
					<VerticalStackLayout Spacing="10">

						<Label Text="Available Services"
		   FontSize="14" FontAttributes="Bold"
		   TextColor="{StaticResource TextPrimary}"/>

						<!-- Search bar -->
						<Border Style="{StaticResource FormInputBox}">
							<Grid ColumnDefinitions="Auto,*">
								<Label Grid.Column="0" Text="&#xe8b6;"
				   FontFamily="MaterialSymbolsRounded" FontSize="16"
				   TextColor="{StaticResource Gray500}"
				   VerticalOptions="Center"
				   Margin="0,0,6,0"/>
								<Entry Grid.Column="1"
				   Style="{StaticResource FormEntry}"
				   Text="{Binding ServiceSearch}"
				   Placeholder="Search services..."/>
							</Grid>
						</Border>

						<ActivityIndicator IsRunning="{Binding IsLoadingServices}"
					   IsVisible="{Binding IsLoadingServices}"
					   Color="{StaticResource Primary}" HeightRequest="36"/>

						<Label Text="No services found"
		   FontSize="12" TextColor="{StaticResource TextMuted}"
		   IsVisible="{Binding FilteredServices.Count,
                   Converter={StaticResource IntEqualZeroConverter}}"/>

						<!-- Filtered services list -->
						<VerticalStackLayout
		BindableLayout.ItemsSource="{Binding FilteredServices}"
		Spacing="0">
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="vm:AvailableServiceItem">
									<VerticalStackLayout Spacing="0">
										<Grid ColumnDefinitions="*,Auto"
						  Padding="4,8" ColumnSpacing="8">
											<VerticalStackLayout Grid.Column="0" Spacing="2">
												<Label Text="{Binding Name}"
								   FontSize="13" TextColor="{StaticResource TextPrimary}"
								   LineBreakMode="WordWrap"/>
												<Label Text="{Binding PriceDisplay}"
								   FontSize="12" TextColor="{StaticResource Primary}"
								   FontAttributes="Bold"/>
												<HorizontalStackLayout Spacing="3"
													IsVisible="{Binding RequiresTeeth}">
													<Label Text="&#xe0a6;" FontFamily="MaterialSymbolsRounded"
									   FontSize="12" TextColor="#1565C0" VerticalOptions="Center"/>
													<Label Text="Requires tooth numbers"
									   FontSize="10" TextColor="#1565C0" VerticalOptions="Center"/>
												</HorizontalStackLayout>
												<HorizontalStackLayout Spacing="3"
													IsVisible="{Binding Name,
                                            Converter={StaticResource InstallmentConverter}}">
													<Label Text="&#xe838;" FontFamily="MaterialSymbolsRoundedFilled"
									   FontSize="12" TextColor="{StaticResource Gold}" VerticalOptions="Center"/>
													<Label Text="Installment available"
									   FontSize="10" TextColor="{StaticResource Gold}" VerticalOptions="Center"/>
												</HorizontalStackLayout>
											</VerticalStackLayout>
											<Button Grid.Column="1"
								Text="&#xe145;"
								FontFamily="MaterialSymbolsRoundedFilled"
								FontSize="20"
								BackgroundColor="{StaticResource Primary}"
								TextColor="White"
								CornerRadius="8"
								HeightRequest="38" WidthRequest="38"
								Padding="0"
								Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                              Path=BindingContext.ToggleServiceCommand}"
								CommandParameter="{Binding .}">
												<Button.Triggers>
													<DataTrigger TargetType="Button" Binding="{Binding IsAddDisabled}" Value="True">
														<Setter Property="Text" Value="&#xe15b;"/>
														<Setter Property="BackgroundColor" Value="#D32F2F"/>
													</DataTrigger>
												</Button.Triggers>
											</Button>
										</Grid>
										<BoxView HeightRequest="0.5" Color="{StaticResource Gray100}"/>
									</VerticalStackLayout>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</VerticalStackLayout>

					</VerticalStackLayout>
				</Frame>

				<!-- Error -->
				<Frame BackgroundColor="#FCEAEA" BorderColor="#FFCDD2"
				   CornerRadius="12" Padding="12" HasShadow="False"
				   IsVisible="{Binding HasError}">
					<Label Text="{Binding ErrorMessage}"
					   FontSize="12" TextColor="#D32F2F"/>
				</Frame>

			</VerticalStackLayout>
		</ScrollView>

		<!-- Loading overlay -->
		<Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000" ZIndex="20">
			<VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12">
				<ActivityIndicator IsRunning="True" Color="White"
                                   WidthRequest="40" HeightRequest="40"/>
				<Label Text="Saving..." TextColor="White"
                       FontSize="14" HorizontalOptions="Center"/>
			</VerticalStackLayout>
		</Grid>

		<!-- Bottom summary panel — plain page content (not a third-party BottomSheet).
             Total/Proceed are ordinary elements in this Border, so nothing about the
             services list's expand/collapse state or size can ever hide them; there's no
             detent/overlay layer involved that could misbehave. Tap the handle row to
             toggle the services list; Total/Proceed stay put either way. -->
		<Border VerticalOptions="End"
                BackgroundColor="White"
                Stroke="{StaticResource Gray300}"
                StrokeThickness="1.5"
                StrokeShape="RoundRectangle 20,20,0,0"
                Padding="0"
                ZIndex="10">
			<VerticalStackLayout Spacing="0">

				<!-- Handle / toggle row -->
				<Grid Padding="16,10,16,8" ColumnDefinitions="*,Auto"
                      IsVisible="{Binding HasSelectedServices}">
					<Grid.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding ToggleServicesExpandedCommand}"/>
					</Grid.GestureRecognizers>

					<Label Grid.Column="0"
                           Text="{Binding ServicesCountLabel}"
                           FontSize="12" TextColor="{StaticResource TextMuted}"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"/>

					<HorizontalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
						<Label Text="{Binding ToggleLabelText}"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"/>
						<Label Text="{Binding ToggleIconGlyph}"
                               FontFamily="MaterialSymbolsRounded" FontSize="16"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"/>
					</HorizontalStackLayout>
				</Grid>

				<!-- Services list — only rendered/visible when expanded, and always
                     capped so it never grows past a comfortable height -->
				<ScrollView IsVisible="{Binding IsServicesExpanded}"
                            MaximumHeightRequest="340">
					<VerticalStackLayout Padding="16,0,16,10"
                                         BindableLayout.ItemsSource="{Binding SelectedServices}"
                                         Spacing="0">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="vm:ServiceLineItem">
								<VerticalStackLayout Spacing="0" Margin="0,0,0,14">

									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
										<Label Grid.Column="0" Text="{Binding ServiceName}"
                                               FontSize="14" TextColor="{StaticResource TextPrimary}"
                                               VerticalOptions="Center"
                                               LineBreakMode="WordWrap"/>
										<Label Grid.Column="1" Text="{Binding SubtotalDisplay}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"
                                               VerticalOptions="Center"/>
									</Grid>

									<!-- Tooth number entry + quantity, tooth-required services only -->
									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,6,0,0"
                                          IsVisible="{Binding ShowTeethInput}">
										<Border Grid.Column="0" Style="{StaticResource FormInputBox}">
											<Entry Style="{StaticResource FormEntry}"
                                                   Text="{Binding ToothNumbers}"
                                                   Placeholder="e.g 12, 13, 14"/>
										</Border>

										<HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
											<Button Text="&#xe15b;"
                                                    FontFamily="MaterialSymbolsRoundedFilled" FontSize="16"
                                                    BackgroundColor="{StaticResource Gray200}"
                                                    TextColor="{StaticResource TextPrimary}" CornerRadius="6"
                                                    HeightRequest="34" WidthRequest="34" Padding="0"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                              Path=BindingContext.DecreaseQtyCommand}"
                                                    CommandParameter="{Binding .}"/>
											<Label Text="{Binding Quantity}"
                                                   FontSize="14" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   VerticalOptions="Center" WidthRequest="20"
                                                   HorizontalTextAlignment="Center"/>
											<Button Text="&#xe145;"
                                                    FontFamily="MaterialSymbolsRoundedFilled" FontSize="16"
                                                    BackgroundColor="{StaticResource Primary}"
                                                    TextColor="White" CornerRadius="6"
                                                    HeightRequest="34" WidthRequest="34" Padding="0"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                              Path=BindingContext.IncreaseQtyCommand}"
                                                    CommandParameter="{Binding .}"/>
										</HorizontalStackLayout>
									</Grid>

									<!-- Tooth number validation — count must match Quantity, and
                                         each number must be a real adult tooth number (1-32) -->
									<Label Text="{Binding ToothValidationMessage}"
                                           FontSize="11" TextColor="#D32F2F"
                                           Margin="0,4,0,0"
                                           IsVisible="{Binding HasToothValidationMessage}"/>

									<!-- Installment note lives in the Available Services list
                                         only — no need to repeat it once a service is added. -->

									<BoxView HeightRequest="0.5" Color="{StaticResource Gray200}" Margin="0,10,0,0"/>

								</VerticalStackLayout>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
				</ScrollView>

				<!-- Total + Proceed — ordinary content in this VerticalStackLayout, always
                     rendered regardless of IsServicesExpanded. Nothing here depends on any
                     third-party sizing logic, so it can't be hidden or pushed off-screen. -->
				<Border BackgroundColor="White"
                        Stroke="{StaticResource Gray200}"
                        Padding="16,10,16,16">
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
						<VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="0">
							<Label Text="Total" FontSize="12" TextColor="{StaticResource TextMuted}"/>
							<Label Text="{Binding TotalAmount, StringFormat='₱{0:N2}'}"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"/>
						</VerticalStackLayout>

						<Button Grid.Column="1"
                                Text="Proceed"
                                BackgroundColor="{Binding CanCreateBill,
                                    Converter={StaticResource BoolToColorConverter},
                                    ConverterParameter='#2E7D32|#ACACAC'}"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="50"
                                WidthRequest="150"
                                FontSize="15"
                                FontAttributes="Bold"
                                IsEnabled="{Binding CanCreateBill}"
                                Command="{Binding CreateBillCommand}"/>
					</Grid>
				</Border>

			</VerticalStackLayout>
		</Border>

	</Grid>
</ContentPage>
