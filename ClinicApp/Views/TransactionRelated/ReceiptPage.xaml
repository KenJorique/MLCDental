<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClinicApp.ViewModels.TransactionVM"
             xmlns:models="clr-namespace:ClinicApp.Models"
             x:Class="ClinicApp.Views.TransactionRelated.ReceiptPage"
             Title="Receipt"
             BackgroundColor="#F5F5F5"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False">

    <!-- No way out except Done — this page represents a payment that's
         already been recorded; back navigation (arrow, swipe, hardware
         button) would let staff land back on Bill Summary and pay again. -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="0">

                <!-- Receipt card -->
                <Frame BackgroundColor="{StaticResource White}"
                       BorderColor="{StaticResource Gray100}"
                       CornerRadius="14"
                       Padding="20"
                       HasShadow="False">
                    <VerticalStackLayout Spacing="0">

                        <!-- Checkmark -->
                        <Border BackgroundColor="{StaticResource Secondary}"
                                StrokeShape="RoundRectangle 24"
                                Stroke="Transparent"
                                WidthRequest="48" HeightRequest="48"
                                HorizontalOptions="Center">
                            <Label Text="&#xe5ca;"
                                   FontFamily="MaterialSymbolsRounded"
                                   FontSize="24"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <Label Text="Payment Recorded"
                               FontSize="13"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0"/>

                        <Label Text="{Binding LatestPaymentAmountDisplay}"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Black}"
                               HorizontalOptions="Center"
                               Margin="0,2,0,10"/>

                        <!-- Status: just the word, colored per Bill.StatusColor -->
                        <Border BackgroundColor="{Binding Bill.StatusBgColor}"
                                StrokeShape="RoundRectangle 10"
                                Stroke="Transparent"
                                Padding="10,4"
                                HorizontalOptions="Center"
                                Margin="0,0,0,18">
                            <Label Text="{Binding Bill.StatusDisplay}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{Binding Bill.StatusColor}"/>
                        </Border>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="0,0,0,14"/>

                        <!-- Date / Patient -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
                            <Label Text="Date" FontSize="12" TextColor="{StaticResource Gray500}"/>
                            <Label Grid.Column="1" Text="{Binding Bill.DateDisplay}" FontSize="12" TextColor="{StaticResource Gray700}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                            <Label Text="Patient" FontSize="12" TextColor="{StaticResource Gray500}"/>
                            <Label Grid.Column="1" Text="{Binding PatientName}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Black}"/>
                        </Grid>

                        <Label Text="SERVICES" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource Gray400}" Margin="0,0,0,8"/>

                        <CollectionView ItemsSource="{Binding Items}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:SupabaseBillItem">
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,3">
                                        <Label Text="{Binding ServiceName}" FontSize="13" TextColor="{StaticResource Gray700}" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="{Binding SubtotalDisplay}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Black}" VerticalOptions="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Per-item installment details — labeled key-value
                             pairs (Down Payment / Monthly / Next Due), the
                             convention real installment agreements use,
                             rather than a run-on sentence. Service name
                             omitted since these sit directly under their
                             service in the list above. -->
                        <VerticalStackLayout IsVisible="{Binding HasInstallmentItems}" Margin="0,12,0,0" Spacing="8">
                            <CollectionView ItemsSource="{Binding InstallmentItems}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SupabaseBillItem">
                                        <Frame BackgroundColor="#FFF8E1"
                                               BorderColor="#FFE082"
                                               CornerRadius="10"
                                               Padding="12"
                                               HasShadow="False"
                                               Margin="0,0,0,8">
                                            <VerticalStackLayout Spacing="5">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="Down Payment" FontSize="12" TextColor="#8D6E00"/>
                                                    <Label Grid.Column="1" Text="{Binding DownpaymentDisplay}" FontSize="12" FontAttributes="Bold" TextColor="#8D6E00"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label FontSize="12" TextColor="#8D6E00">
                                                        <Label.Text>
                                                            <MultiBinding StringFormat="Monthly ({0} mo)">
                                                                <Binding Path="InstallmentMonths"/>
                                                            </MultiBinding>
                                                        </Label.Text>
                                                    </Label>
                                                    <Label Grid.Column="1" Text="{Binding MonthlyPaymentDisplay}" FontSize="12" FontAttributes="Bold" TextColor="#8D6E00"/>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="Next Due" FontSize="12" TextColor="#8D6E00"/>
                                                    <Label Grid.Column="1" Text="{Binding DueDateDisplay}" FontSize="12" FontAttributes="Bold" TextColor="#C62828"/>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="0,16"/>

                        <!-- Totals -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
                            <Label Text="Subtotal" FontSize="12" TextColor="{StaticResource Gray500}"/>
                            <Label Grid.Column="1" Text="{Binding Bill.SubtotalDisplay}" FontSize="12" TextColor="{StaticResource Gray500}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                            <Label Text="Discount" FontSize="12" TextColor="{StaticResource Gray500}"/>
                            <Label Grid.Column="1" Text="{Binding Bill.DiscountAmountDisplay}" FontSize="12" TextColor="{StaticResource Gray500}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <Label Text="Total" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Black}"/>
                            <Label Grid.Column="1" Text="{Binding Bill.TotalDisplay}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Black}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                            <Label Text="Paid" FontSize="12" TextColor="{StaticResource Gray500}"/>
                            <Label Grid.Column="1" Text="{Binding Bill.PaidDisplay}" FontSize="12" TextColor="{StaticResource Primary}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Balance" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Black}"/>
                            <Label Grid.Column="1" Text="{Binding Bill.BalanceDisplay}" FontSize="15" FontAttributes="Bold" TextColor="#C62828"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="0,16"/>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
                            <Label Text="Amount Received" FontSize="12" TextColor="{StaticResource Gray500}"/>
                            <Label Grid.Column="1" Text="{Binding AmountReceivedDisplay}" FontSize="12" TextColor="{StaticResource Gray700}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasChange}">
                            <Label Text="Change" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Black}"/>
                            <Label Grid.Column="1" Text="{Binding ChangeDisplay}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="0,16"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Receipt no." FontSize="11" TextColor="{StaticResource Gray400}"/>
                            <Label Grid.Column="1" Text="{Binding Bill.BillNumberDisplay}" FontSize="11" TextColor="{StaticResource Gray400}"/>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <!-- Done -->
                <Grid Margin="0,16,0,0">
                    <Button Text="Done"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}"
                            CornerRadius="12"
                            HeightRequest="48"
                            FontSize="14"
                            FontAttributes="Bold"
                            Command="{Binding DoneCommand}"/>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
