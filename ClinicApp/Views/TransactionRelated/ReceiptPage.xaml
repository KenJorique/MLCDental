<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClinicApp.ViewModels.TransactionVM"
             xmlns:models="clr-namespace:ClinicApp.Models"
             x:Class="ClinicApp.Views.TransactionRelated.ReceiptPage"
             Title="Receipt"
             BackgroundColor="#F5F5F5"
             Shell.TabBarIsVisible="False">

	<Grid>
		<ScrollView>

			<VerticalStackLayout Padding="16" Spacing="14">

				<!-- Receipt header -->

				<Frame BackgroundColor="{StaticResource White}" BorderColor="{StaticResource Gray100}"
                       CornerRadius="12" Padding="16" HasShadow="False">
					<VerticalStackLayout Spacing="4"
                                         HorizontalOptions="Center">
						<Label Text="MLC Dental Clinic"
                               FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center"/>
						<Label Text="Official Receipt"
                               FontSize="13" TextColor="{StaticResource Gray400}"
                               HorizontalOptions="Center"/>
						<BoxView HeightRequest="1" Color="{StaticResource Gray100}"
                                 Margin="0,8"/>
						<Label Text="{Binding PatientName}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource Black}"
                               HorizontalOptions="Center"/>
						<Label Text="{Binding Bill.DateDisplay}"
                               FontSize="12" TextColor="{StaticResource Gray400}"
                               HorizontalOptions="Center"/>

						<!-- Status badge -->
						<Border BackgroundColor="{Binding Bill.StatusColor}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                Padding="12,4"
                                HorizontalOptions="Center"
                                Margin="0,4">
							<Label Text="{Binding Bill.StatusDisplay}"
                                   FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource White}"/>
						</Border>
					</VerticalStackLayout>
				</Frame>

				<Frame BackgroundColor="{StaticResource White}" BorderColor="{StaticResource Gray100}"
       CornerRadius="12" Padding="14" HasShadow="False">
					<VerticalStackLayout Spacing="10">

						<Label Text="Services Rendered"
               FontSize="14" FontAttributes="Bold"
               TextColor="{StaticResource Black}"/>

						<CollectionView ItemsSource="{Binding Items}">
							<CollectionView.ItemTemplate>
								<DataTemplate x:DataType="models:SupabaseBillItem">
									<VerticalStackLayout Spacing="6" Padding="0,4">
										<Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
											<VerticalStackLayout Grid.Column="0" Spacing="2">
												<Label Text="{Binding ServiceName}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Black}"/>
												<Label Text="{Binding UnitPriceDisplay}"
                                       FontSize="11"
                                       TextColor="{StaticResource Gray400}"/>
												<Label Text="{Binding ToothNumbersDisplay}"
                                       FontSize="11"
                                       TextColor="#1565C0"
                                       IsVisible="{Binding HasTeethInfo}"/>
											</VerticalStackLayout>

											<VerticalStackLayout Grid.Column="1"
                                                 HorizontalOptions="End"
                                                 Spacing="2">
												<Label Text="{Binding Quantity, StringFormat='x{0}'}"
                                       FontSize="11"
                                       TextColor="{StaticResource Gray500}"
                                       HorizontalTextAlignment="End"/>
												<Label Text="{Binding SubtotalDisplay}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalTextAlignment="End"/>
											</VerticalStackLayout>
										</Grid>

										<BoxView HeightRequest="0.5" Color="#F0F0F0"/>
									</VerticalStackLayout>
								</DataTemplate>
							</CollectionView.ItemTemplate>
						</CollectionView>

						<Frame BackgroundColor="#FFF8E1"
       BorderColor="#FFE082"
       CornerRadius="12"
       Padding="12"
       HasShadow="False"
       IsVisible="{Binding Bill.IsInstallment}">

							<VerticalStackLayout Spacing="4">
								<Label Text="Installment Plan"
               FontAttributes="Bold"
               TextColor="#F57F17"/>
								<Label Text="{Binding Bill.InstallmentDisplay}"
               FontSize="12"
               TextColor="#F57F17"/>

								<Frame BackgroundColor="{Binding Bill.DueStatusColor}"
       CornerRadius="20"
       Padding="8,4"
       HasShadow="False"
       IsVisible="{Binding Bill.IsInstallment}">
									<Label Text="{Binding Bill.DueStatusText}"
           FontSize="10"
           TextColor="{StaticResource White}"
           FontAttributes="Bold"/>
								</Frame>


								<Grid ColumnDefinitions="*,Auto">
									<Label Text="Last Payment"
                   FontSize="12"
                   TextColor="{StaticResource Gray500}"/>
									<Label Grid.Column="1"
                   Text="{Binding Bill.LastPaymentDateDisplay}"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Gray700}"/>
								</Grid>

								<Grid ColumnDefinitions="*,Auto">
									<Label Text="Next Due"
                   FontSize="12"
                   TextColor="{StaticResource Gray500}"/>
									<Label Grid.Column="1"
                   Text="{Binding Bill.DueDateDisplay}"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#C62828"/>
								</Grid>
							</VerticalStackLayout>
						</Frame>

						<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Subtotal"
                   FontSize="13"
                   TextColor="{StaticResource Gray500}"/>
							<Label Grid.Column="1"
                   Text="{Binding Bill.SubtotalDisplay}"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Gray500}"/>
						</Grid>

						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Discount"
                   FontSize="13"
                   TextColor="{StaticResource Gray500}"/>
							<Label Grid.Column="1"
                   Text="{Binding Bill.DiscountAmountDisplay}"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#C62828"/>
						</Grid>

						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Total"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Black}"/>
							<Label Grid.Column="1"
                   Text="{Binding Bill.TotalDisplay}"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Black}"/>
						</Grid>

						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Amount Paid"
                   FontSize="13"
                   TextColor="{StaticResource Primary}"/>
							<Label Grid.Column="1"
                   Text="{Binding Bill.PaidDisplay}"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"/>
						</Grid>

						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Balance"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#C62828"/>
							<Label Grid.Column="1"
                   Text="{Binding Bill.BalanceDisplay}"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#C62828"/>
						</Grid>

					</VerticalStackLayout>
				</Frame>

				<!-- Payment history -->
				<Frame BackgroundColor="{StaticResource White}" BorderColor="{StaticResource Gray100}"
                       CornerRadius="12" Padding="14" HasShadow="False"
                       IsVisible="{Binding Payments.Count,
                           Converter={StaticResource IntNotEqualZeroConverter}}">
					<VerticalStackLayout Spacing="8">
						<Label Text="Payment History"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource Black}"/>
						<CollectionView ItemsSource="{Binding Payments}">
							<CollectionView.ItemTemplate>
								<DataTemplate x:DataType="models:SupabasePayment">
									<Grid ColumnDefinitions="*,Auto"
                                          Padding="0,6">
										<VerticalStackLayout Grid.Column="0" Spacing="2">
											<Label Text="{Binding DateDisplay}"
                                                   FontSize="12" TextColor="{StaticResource Gray400}"/>
											<Label Text="{Binding Notes}"
                                                   FontSize="11" TextColor="{StaticResource Gray300}"
                                                   IsVisible="{Binding Notes,
                                                       Converter={StaticResource StringNotEmptyConverter}}"/>
										</VerticalStackLayout>
										<Label Grid.Column="1"
                                               Text="{Binding AmountDisplay}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}"
                                               VerticalOptions="Center"/>
									</Grid>
								</DataTemplate>
							</CollectionView.ItemTemplate>
						</CollectionView>
					</VerticalStackLayout>
				</Frame>

				<!-- Add payment button — only if balance > 0 -->
				<Button Text="+ Record Additional Payment"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}"
                        CornerRadius="12"
                        HeightRequest="46"
                        FontSize="14"
                        IsVisible="{Binding Bill.Balance,
                            Converter={StaticResource DecimalNotZeroConverter}}"
                        Command="{Binding OpenAddPaymentCommand}"/>

				<Button Text="Done"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}"
                        CornerRadius="12"
                        HeightRequest="50"
                        FontSize="15"
                        FontAttributes="Bold"
                        Command="{Binding DoneCommand}"/>

				<BoxView HeightRequest="40" Color="Transparent"/>

			</VerticalStackLayout>
		</ScrollView>

		<!-- Add payment overlay -->
		<Grid IsVisible="{Binding ShowAddPayment}"
              BackgroundColor="#80000000" ZIndex="10">
			<Frame Margin="16,160,16,160" CornerRadius="16"
                   Padding="0" BackgroundColor="{StaticResource White}" HasShadow="False">
				<Grid RowDefinitions="Auto,*,Auto">
					<Grid Grid.Row="0" BackgroundColor="{StaticResource Primary}"
                          Padding="14,10" ColumnDefinitions="*,Auto">
						<Label Grid.Column="0" Text="Add Payment"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource White}" VerticalOptions="Center"/>
						<Button Grid.Column="1" Text="✕"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource White}" FontSize="16"
                                WidthRequest="36" HeightRequest="36" Padding="0"
                                Command="{Binding CloseAddPaymentCommand}"/>
					</Grid>
					<VerticalStackLayout Grid.Row="1" Padding="16" Spacing="12">
						<Label Text="{Binding Bill.BalanceDisplay,
                                   StringFormat='Outstanding Balance: {0}'}"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="#C62828"/>
						<Label Text="Amount to Pay (₱)"
                               FontSize="12" TextColor="{StaticResource Gray500}"/>
						<Border Style="{StaticResource FormInputBox}">
							<Entry Style="{StaticResource FormEntry}"
                                   Text="{Binding AdditionalPayment}"
                                   Keyboard="Numeric"
                                   FontSize="18" FontAttributes="Bold"/>
						</Border>
					</VerticalStackLayout>
					<VerticalStackLayout Grid.Row="2" Padding="16,10" Spacing="8">
						<Button Text="✓ Confirm Payment"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10"
                                HeightRequest="46"
                                FontSize="14"
                                Command="{Binding ConfirmAdditionalPaymentCommand}"/>
					</VerticalStackLayout>
				</Grid>
			</Frame>
		</Grid>

	</Grid>
</ContentPage>