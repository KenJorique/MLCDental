<?xml version="1.0" encoding="utf-8" ?>
<the49:BottomSheet
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:the49="https://schemas.the49.com/dotnet/2023/maui"
    xmlns:vm="clr-namespace:ClinicApp.ViewModels.TransactionVM"
    x:DataType="vm:CreateBillViewModel"
    x:Class="ClinicApp.Views.CreateBillSummarySheet"
    x:Name="RootSheet"
    HasHandle="False"
    HasBackdrop="False"
    IsCancelable="False"
    CornerRadius="20"
    BackgroundColor="Transparent">

	<!-- Two fixed detents, not content-driven:
	       - Collapsed (default): just handle + Total/Proceed, nothing else. This is what
	         shows the instant the sheet appears.
	       - Expanded (50% of screen): drag the handle up to reveal the services list,
	         which scrolls within that half-screen space. Footer stays visible in both.
	     A content-driven ContentDetent was tried first, but a Grid's star row doesn't
	     shrink-wrap to its natural content size the way a plain stack does — it fills all
	     available height instead, which is why that approach showed a nearly blank
	     full-screen sheet with 0 services. Fixed detents sidestep that entirely: the Grid
	     only ever has to size itself to a height we've told it explicitly, so its rows
	     size correctly in both states. -->
	<the49:BottomSheet.Detents>
		<the49:HeightDetent Height="110" IsDefault="True"/>
		<the49:RatioDetent Ratio="0.5"/>
	</the49:BottomSheet.Detents>

	<Border BackgroundColor="White"
	        Stroke="{StaticResource Gray300}"
	        StrokeThickness="1.5"
	        StrokeShape="RoundRectangle 20">
		<Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

			<!-- Drag handle -->
			<BoxView Grid.Row="0"
					 WidthRequest="40" HeightRequest="4" CornerRadius="2"
					 BackgroundColor="{StaticResource Gray300}"
					 HorizontalOptions="Center" Margin="0,10,0,4"/>

			<!-- Services list — sits in the Grid's star row, so at the expanded (50%-screen)
		     detent it fills whatever space is left after the handle and footer take
		     theirs, and scrolls internally if the list is longer than that. At the
		     collapsed detent this row has effectively no room, so it's hidden. -->
			<ScrollView Grid.Row="1" x:Name="ServicesScroll">
				<VerticalStackLayout Padding="16,4,16,10"
									 BindableLayout.ItemsSource="{Binding SelectedServices}"
									 Spacing="0">

					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="vm:ServiceLineItem">
							<VerticalStackLayout Spacing="0" Margin="0,0,0,14">

								<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
									<Label Grid.Column="0" Text="{Binding ServiceName}"
										   FontSize="14" TextColor="{StaticResource TextPrimary}"
										   VerticalOptions="Center"
										   LineBreakMode="WordWrap"/>
									<Label Grid.Column="1" Text="{Binding SubtotalDisplay}"
										   FontSize="14" FontAttributes="Bold"
										   TextColor="{StaticResource TextPrimary}"
										   VerticalOptions="Center"/>
								</Grid>

								<!-- Tooth number entry + quantity, tooth-required services only -->
								<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,6,0,0"
									  IsVisible="{Binding ShowTeethInput}">
									<Border Grid.Column="0" Style="{StaticResource FormInputBox}">
										<Entry Style="{StaticResource FormEntry}"
											   Text="{Binding ToothNumbers}"
											   Placeholder="e.g 12, 13, 14"/>
									</Border>

									<HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
										<Button Text="−"
												FontSize="14" BackgroundColor="{StaticResource Gray200}"
												TextColor="{StaticResource TextPrimary}" CornerRadius="6"
												HeightRequest="34" WidthRequest="34" Padding="0"
												Command="{Binding Source={x:Reference RootSheet},
                                                  Path=BindingContext.DecreaseQtyCommand}"
												CommandParameter="{Binding .}"/>
										<Label Text="{Binding Quantity}"
											   FontSize="14" FontAttributes="Bold"
											   TextColor="{StaticResource TextPrimary}"
											   VerticalOptions="Center" WidthRequest="20"
											   HorizontalTextAlignment="Center"/>
										<Button Text="+"
												FontSize="14" BackgroundColor="{StaticResource Primary}"
												TextColor="White" CornerRadius="6"
												HeightRequest="34" WidthRequest="34" Padding="0"
												Command="{Binding Source={x:Reference RootSheet},
                                                  Path=BindingContext.IncreaseQtyCommand}"
												CommandParameter="{Binding .}"/>
									</HorizontalStackLayout>
								</Grid>

								<!-- Installment badge -->
								<Label Text="⭐ Supports flexible installment payments"
									   FontSize="10" TextColor="{StaticResource Gold}"
									   Margin="0,4,0,0"
									   IsVisible="{Binding IsInstallmentEligible}"/>

								<BoxView HeightRequest="0.5" Color="{StaticResource Gray200}" Margin="0,10,0,0"/>

							</VerticalStackLayout>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>
			</ScrollView>

			<!-- Total + Proceed — its own Auto row in the Grid above, so it always renders at
		     full size and stays visible/reachable whether the sheet is at its full grown
		     height or dragged down to the collapsed detent -->
			<Border Grid.Row="2"
					BackgroundColor="White"
					Stroke="{StaticResource Gray200}"
					Padding="16,10,16,16">
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
					<VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="0">
						<Label Text="Total" FontSize="12" TextColor="{StaticResource TextMuted}"/>
						<Label Text="{Binding TotalAmount, StringFormat='₱{0:N2}'}"
							   FontSize="20" FontAttributes="Bold"
							   TextColor="{StaticResource Primary}"/>
					</VerticalStackLayout>

					<Button Grid.Column="1"
							Text="Proceed"
							BackgroundColor="{Binding CanCreateBill,
                            Converter={StaticResource BoolToColorConverter},
                            ConverterParameter='#2E7D32|#ACACAC'}"
							TextColor="White"
							CornerRadius="12"
							HeightRequest="50"
							WidthRequest="150"
							FontSize="15"
							FontAttributes="Bold"
							IsEnabled="{Binding CanCreateBill}"
							Command="{Binding CreateBillCommand}"/>
				</Grid>
			</Border>

		</Grid>
	</Border>

</the49:BottomSheet>
