<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ClinicApp.Models"
    xmlns:vm="clr-namespace:ClinicApp.ViewModels.TransactionVM"
    x:Class="ClinicApp.Views.TransactionRelated.ServiceSummaryPage"
    Title="Service Summary"
    Shell.TabBarIsVisible="False"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="*,Auto">

        <!-- Scrollable content -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- Header: back + patient info + item count -->
                <Frame BackgroundColor="White" BorderColor="#E0E0E0" CornerRadius="12" Padding="14" HasShadow="False">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0"
                                Text="←"
                                FontSize="18"
                                BackgroundColor="Transparent"
                                TextColor="#4A4A8A"
                                Padding="0"
                                WidthRequest="36"
                                HeightRequest="36"
                                Command="{Binding BackCommand}"/>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="Service Summary" FontSize="18" FontAttributes="Bold" TextColor="#222"/>
                            <Label Text="{Binding PatientName}" FontSize="14" TextColor="#666"/>
                        </VerticalStackLayout>

                        <Frame Grid.Column="2"
                               BackgroundColor="#EEEEFA"
                               BorderColor="Transparent"
                               CornerRadius="10"
                               Padding="8,4"
                               HasShadow="False"
                               VerticalOptions="Center"
                               IsVisible="{Binding HasServices}">
                            <Label Text="{Binding TotalItems, StringFormat='{0} item(s)'}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#4A4A8A"/>
                        </Frame>
                    </Grid>
                </Frame>

                <!-- Empty state -->
                <Frame BackgroundColor="White" BorderColor="#E0E0E0" CornerRadius="12" Padding="24" HasShadow="False"
                       IsVisible="{Binding HasServices, Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="🦷" FontSize="34" HorizontalOptions="Center"/>
                        <Label Text="No services added yet"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#444"
                               HorizontalOptions="Center"/>
                        <Label Text="Go back and add a service to build this bill."
                               FontSize="12"
                               TextColor="#888"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Services list -->
                <Frame BackgroundColor="White" BorderColor="#E0E0E0" CornerRadius="12" Padding="14" HasShadow="False"
                       IsVisible="{Binding HasServices}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Added Services" FontSize="14" FontAttributes="Bold" TextColor="#222"/>

                        <CollectionView ItemsSource="{Binding Services}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ServiceLineItem">
                                    <SwipeView>
                                        <SwipeView.RightItems>
                                            <SwipeItems>
                                                <SwipeItem Text="Remove"
                                                           BackgroundColor="#C62828"
                                                           Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveServiceCommand}"
                                                           CommandParameter="{Binding .}"/>
                                            </SwipeItems>
                                        </SwipeView.RightItems>

                                        <VerticalStackLayout Spacing="6" Margin="0,0,0,10" BackgroundColor="White">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label Text="{Binding ServiceName}" FontSize="13" FontAttributes="Bold" TextColor="#222"/>
                                                    <Label Text="{Binding UnitPriceDisplay}" FontSize="11" TextColor="#4A4A8A"/>
                                                    <Label Text="{Binding TeethDisplay}" FontSize="11" TextColor="#2E7D32"
                                                           IsVisible="{Binding TeethDisplay, Converter={StaticResource StringNotEmptyConverter}}"/>
                                                </VerticalStackLayout>

                                                <Label Grid.Column="1"
                                                       Text="{Binding Quantity, StringFormat='Qty: {0}'}"
                                                       VerticalOptions="Center"
                                                       TextColor="#555"/>
                                            </Grid>

                                            <Label Text="{Binding SubtotalDisplay}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="#4A4A8A"
                                                   HorizontalOptions="End"/>
                                            <BoxView HeightRequest="0.5" Color="#E0E0E0"/>
                                        </VerticalStackLayout>
                                    </SwipeView>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label Text="Swipe left on a service to remove it"
                               FontSize="10"
                               TextColor="#AAA"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Sticky bottom bar: subtotal + Continue -->
        <Frame Grid.Row="1"
               BackgroundColor="White"
               BorderColor="#E0E0E0"
               CornerRadius="0"
               Padding="16,12"
               HasShadow="True">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Subtotal" FontSize="16" FontAttributes="Bold" TextColor="#222"/>
                    <Label Grid.Column="1" Text="{Binding Subtotal, StringFormat='₱{0:N2}'}" FontSize="18" FontAttributes="Bold" TextColor="#4A4A8A"/>
                </Grid>

                <Button Text="Continue"
                        BackgroundColor="#4A4A8A"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="48"
                        Command="{Binding ContinueCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding HasServices}" Value="False">
                            <Setter Property="BackgroundColor" Value="#CCCCCC"/>
                            <Setter Property="TextColor" Value="#888888"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </VerticalStackLayout>
        </Frame>

    </Grid>
</ContentPage>