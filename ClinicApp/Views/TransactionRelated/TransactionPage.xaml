<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClinicApp.ViewModels.TransactionVM"
             xmlns:models="clr-namespace:ClinicApp.Models"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="True"
             Shell.BackgroundColor="{StaticResource Primary}"
             Shell.ForegroundColor="{StaticResource White}"
             Shell.TitleColor="{StaticResource White}"
             Title="Ledger"
             x:Class="ClinicApp.Views.TransactionPage"
             x:DataType="vm:TransactionViewModel"
             BackgroundColor="#F5F5F5">

	<ContentPage.Resources>

		<DataTemplate x:Key="PaymentRowTemplate" x:DataType="models:PaymentRowItem">
			<Border BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="0,10">

				<Border.GestureRecognizers>
					<TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                          Path=BindingContext.OpenPaymentCommand}"
                        CommandParameter="{Binding .}"/>
				</Border.GestureRecognizers>

				<Grid ColumnDefinitions="*,*,*"
                      ColumnSpacing="6">

					<Label Text="{Binding DateDisplay}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Black}"
                           VerticalOptions="Center"/>

					<Label Grid.Column="1"
                           Text="{Binding AmountDisplay}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"/>

					<Label Grid.Column="2"
                           Text="{Binding BalanceDisplay}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Black}"
                           HorizontalTextAlignment="End"
                           VerticalOptions="Center"/>
				</Grid>
			</Border>
		</DataTemplate>

		<!-- One card per bill: left accent strip (color = status) + a
             single header row (Date / Amount / status pill / chevron),
             then an expandable area with the payment table and the
             Current Balance + Add Payment row. -->
		<DataTemplate x:Key="BillCardTemplate" x:DataType="vm:BillCardItem">
			<Border BackgroundColor="{StaticResource White}"
                    StrokeThickness="0"
                    Padding="0"
                    Margin="0,0,0,12">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="14"/>
				</Border.StrokeShape>

				<Grid ColumnDefinitions="5,*">

					<!-- Accent strip: green/orange/red for Paid/Partially Paid/Unpaid -->
					<Border Grid.Column="0"
                            BackgroundColor="{Binding AccentColor}"
                            StrokeThickness="0"/>

					<VerticalStackLayout Grid.Column="1" Spacing="0" Padding="16">

						<!-- Header — tapping anywhere toggles expand/collapse. -->
						<Border BackgroundColor="Transparent" StrokeThickness="0">
							<Border.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding ToggleExpandCommand}"/>
							</Border.GestureRecognizers>

							<!-- Date + Amount + status pill + chevron, all in one row -->
							<Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                                  ColumnSpacing="10">

								<Label Text="{Binding Bill.DateDisplay}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Black}"
                                       VerticalOptions="Center"
									   Margin="0,0,30,0"/>

								<Label Grid.Column="1"
                                       Text="{Binding Bill.TotalDisplay}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Black}"
                                       VerticalOptions="Center"/>

								<!-- column 2 left empty as a flexible spacer -->

								<Frame Grid.Column="3"
                                       BackgroundColor="{Binding StatusBgColor}"
                                       BorderColor="Transparent"
                                       CornerRadius="20"
                                       Padding="10,4"
                                       HasShadow="False"
                                       VerticalOptions="Center">
									<Label Text="{Binding StatusLabel}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{Binding AccentColor}"/>
								</Frame>

								<Label Grid.Column="4"
                                       FontFamily="MaterialSymbolsRounded"
                                       Text="{Binding ToggleIcon}"
                                       FontSize="22"
                                       TextColor="{StaticResource Gray500}"
                                       VerticalOptions="Center"/>
							</Grid>
						</Border>

						<!-- Expandable area: payment table + current balance -->
						<VerticalStackLayout Spacing="0"
                                             IsVisible="{Binding IsExpanded}"
                                             Margin="0,14,0,0">

							<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>

							<!-- Payment table -->
							<VerticalStackLayout Spacing="0" Margin="0,10,0,0">

								<Label Text="No payments recorded yet"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray400}"
                                       Margin="0,4,0,4"
                                       IsVisible="{Binding HasNoPayments}"/>

								<!-- Table header -->
								<Grid ColumnDefinitions="*,*,*"
                                      ColumnSpacing="6"
                                      IsVisible="{Binding HasPayments}">
									<Label Text="Date"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Gray400}"/>
									<Label Grid.Column="1"
                                           Text="Payment"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Gray400}"
                                           HorizontalTextAlignment="Center"/>
									<Label Grid.Column="2"
                                           Text="Balance"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Gray400}"
                                           HorizontalTextAlignment="End"/>
								</Grid>

								<CollectionView ItemsSource="{Binding Payments}"
                                                ItemTemplate="{StaticResource PaymentRowTemplate}"
                                                SelectionMode="None"
                                                IsVisible="{Binding HasPayments}">
									<CollectionView.ItemsLayout>
										<LinearItemsLayout Orientation="Vertical" ItemSpacing="0"/>
									</CollectionView.ItemsLayout>
								</CollectionView>

								<BoxView HeightRequest="1"
                                         Color="{StaticResource Gray100}"
                                         Margin="0,6,0,0"
                                         IsVisible="{Binding HasPayments}"/>
							</VerticalStackLayout>

							<!-- Current Balance + scoped Add Payment button -->
							<Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
								<VerticalStackLayout Spacing="2">
									<Label Text="Current Balance"
                                           FontSize="11"
                                           TextColor="{StaticResource Gray500}"/>
									<Label Text="{Binding CurrentBalanceDisplay}"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Black}"/>
								</VerticalStackLayout>

								<Button Grid.Column="1"
                                        Text="Add Payment"
                                        CornerRadius="8"
                                        Padding="14,0"
                                        HeightRequest="36"
                                        FontSize="12"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding ShowAddPayment}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                          Path=BindingContext.AddPaymentForBillCommand}"
                                        CommandParameter="{Binding Bill}"/>
							</Grid>

						</VerticalStackLayout>
					</VerticalStackLayout>
				</Grid>
			</Border>
		</DataTemplate>

	</ContentPage.Resources>

	<Grid>
		<RefreshView Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
			<ScrollView>
				<VerticalStackLayout Padding="16" Spacing="14">

					<!-- Patient summary -->
					<Border BackgroundColor="{StaticResource White}"
                            StrokeThickness="0"
                            Padding="18"
                            Margin="0,0,0,4">
						<Border.StrokeShape>
							<RoundRectangle CornerRadius="16"/>
						</Border.StrokeShape>

						<VerticalStackLayout Spacing="14">
							<Label Text="{Binding PatientName}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Black}"/>

							<BoxView HeightRequest="1"
                                     Color="{StaticResource Gray100}"/>

							<Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
								<Label Grid.Row="0"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Text="Outstanding Balance"
                                       FontSize="12"
                                       TextColor="Gray"/>

								<Label Grid.Row="1"
                                       Grid.Column="0"
                                       Text="{Binding OutstandingDisplay}"
                                       FontSize="30"
                                       FontAttributes="Bold"
                                       TextColor="#1A6B2F"
                                       VerticalOptions="Center"/>

								<!-- Status pill — Paid / Partially Paid / Unpaid,
                                     sits right beside the balance figure. -->
								<Frame Grid.Row="1"
                                       Grid.Column="1"
                                       BackgroundColor="{Binding PaymentStatusBgColor}"
                                       BorderColor="Transparent"
                                       CornerRadius="20"
                                       Padding="10,4"
                                       HasShadow="False"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End">
									<Label Text="{Binding PaymentStatus}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{Binding PaymentStatusColor}"/>
								</Frame>
							</Grid>

							<Frame BackgroundColor="#FFF1F2"
                                   BorderColor="#FECACA"
                                   CornerRadius="12"
                                   Padding="12"
                                   HasShadow="False"
                                   IsVisible="{Binding OverdueBillsCount, Converter={StaticResource IntNotEqualZeroConverter}}">
								<VerticalStackLayout Spacing="2">
									<Label Text="Overdue Installments"
                                           FontAttributes="Bold"
                                           TextColor="#B91C1C"/>
									<Label Text="{Binding OverdueSummary}"
                                           FontSize="12"
                                           TextColor="#B91C1C"/>
								</VerticalStackLayout>
							</Frame>

							<Grid ColumnDefinitions="*,*">
								<VerticalStackLayout Spacing="4">
									<Label Text="Last Payment"
                                           FontSize="12"
                                           TextColor="Gray"/>
									<Label Text="{Binding LastPaymentDisplay}"
                                           FontAttributes="Bold"/>
								</VerticalStackLayout>

								<VerticalStackLayout Grid.Column="1"
                                                     Spacing="4">
									<Label Text="Next Due Date"
                                           FontSize="12"
                                           TextColor="Gray"/>
									<Label Text="{Binding DueDateDisplay}"
                                           FontAttributes="Bold"/>
								</VerticalStackLayout>
							</Grid>
						</VerticalStackLayout>
					</Border>

					<!-- Transaction History label + sort icon on the right -->
					<Grid ColumnDefinitions="*,Auto"
                          Margin="0,-5,0,-5">

						<Label Text="Transaction History"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center"/>

						<Border Grid.Column="1"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                Padding="6">
							<Border.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding SortOptionsCommand}"/>
							</Border.GestureRecognizers>

							<Label FontFamily="MaterialSymbolsRoundedFilled"
                                   Text="&#xe152;"
                                   FontSize="20" 
                                   TextColor="{StaticResource Black}"
                                   VerticalOptions="Center"/>
						</Border>
					</Grid>

					<Label Text="No billing records yet"
                           FontSize="12"
                           TextColor="{StaticResource TextMuted}"
                           IsVisible="{Binding BillCards.Count, Converter={StaticResource IntEqualZeroConverter}}"/>

					<CollectionView ItemsSource="{Binding BillCards}"
                                    ItemTemplate="{StaticResource BillCardTemplate}"
                                    SelectionMode="None">
						<CollectionView.ItemsLayout>
							<LinearItemsLayout Orientation="Vertical" ItemSpacing="0"/>
						</CollectionView.ItemsLayout>
					</CollectionView>

				</VerticalStackLayout>
			</ScrollView>
		</RefreshView>
	</Grid>
</ContentPage>
