<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClinicApp.ViewModels.TransactionVM"
             xmlns:models="clr-namespace:ClinicApp.Models"
             x:Class="ClinicApp.Views.TransactionPage"
             x:DataType="vm:TransactionViewModel"
             BackgroundColor="#F5F5F5">

    <ContentPage.Title>
        <Binding Path="PatientName" StringFormat="Patient Ledger — {0}"/>
    </ContentPage.Title>

    <Grid>
        <RefreshView Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="14">

                    <!-- Summary -->
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="18"
                            Margin="0,0,0,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="14">
                            <Label Text="{Binding PatientName}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="#222"/>

                            <Label Text="{Binding LedgerSummary}"
                                   FontSize="13"
                                   TextColor="Gray"/>

                            <BoxView HeightRequest="1"
                                     Color="#EEEEEE"/>

                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="8">
                                <Label Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Outstanding Balance"
                                       FontSize="12"
                                       TextColor="Gray"/>

                                <Border Grid.Row="0"
                                        Grid.Column="1"
                                        BackgroundColor="#FFF4E5"
                                        Stroke="#FFA726"
                                        Padding="12,6"
                                        VerticalOptions="Center"
                                        HorizontalOptions="End">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18"/>
                                    </Border.StrokeShape>
                                    <!--<Label Text="{Binding PaymentStatus}"
                                           TextColor="#E65100"
                                           FontAttributes="Bold"/>-->
                                </Border>

                                <Label Grid.Row="1"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding OutstandingDisplay}"
                                       FontSize="30"
                                       FontAttributes="Bold"
                                       TextColor="#1A6B2F"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Next Due"
                                       FontSize="12"
                                       TextColor="Gray"/>
                                <Label Grid.Column="1"
                                       Text="{Binding NextDueDisplay}"
                                       FontAttributes="Bold"/>
                            </Grid>

                            <Frame BackgroundColor="#FFF1F2"
                                   BorderColor="#FECACA"
                                   CornerRadius="12"
                                   Padding="12"
                                   HasShadow="False"
                                   IsVisible="{Binding OverdueBillsCount, Converter={StaticResource IntNotEqualZeroConverter}}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Overdue Installments"
                                           FontAttributes="Bold"
                                           TextColor="#B91C1C"/>
                                    <Label Text="{Binding OverdueSummary}"
                                           FontSize="12"
                                           TextColor="#B91C1C"/>
                                </VerticalStackLayout>
                            </Frame>

                            <Grid ColumnDefinitions="*,*">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Last Payment"
                                           FontSize="12"
                                           TextColor="Gray"/>
                                    <Label Text="{Binding LastPaymentDisplay}"
                                           FontAttributes="Bold"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="4">
                                    <Label Text="Due Date"
                                           FontSize="12"
                                           TextColor="Gray"/>
                                    <Label Text="{Binding DueDateDisplay}"
                                           FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Add bill button -->
                    <Button Text="+ Create New Bill"
                            BackgroundColor="#4A4A8A"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="44"
                            FontSize="13"
                            Command="{Binding CreateNewBillCommand}"/>

                    <!-- Billing history header -->
                    <Label Text="Billing History"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#333"
                           Margin="0,8,0,0"/>

                    <Label Text="No billing records yet"
                           FontSize="12"
                           TextColor="#999"
                           IsVisible="{Binding Ledger.Count, Converter={StaticResource IntEqualZeroConverter}}"/>

                    <!-- Ledger timeline -->
                    <CollectionView ItemsSource="{Binding Ledger}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:LedgerItem">
                                <Grid Padding="0,0,0,16"
                                      ColumnDefinitions="40,*">

                                    <!-- Timeline / Icon -->
                                    <Grid>
                                        <BoxView WidthRequest="2"
                                                 BackgroundColor="#DDDDDD"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Fill"/>

                                        <Border WidthRequest="36"
                                                HeightRequest="36"
                                                BackgroundColor="{Binding IconBackground}"
                                                StrokeThickness="0"
                                                HorizontalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="18"/>
                                            </Border.StrokeShape>

                                            <Label Text="{Binding Icon}"
                                                   FontFamily="MaterialSymbolsRounded"
                                                   TextColor="{Binding IconColor}"
                                                   FontSize="20"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- Card -->
                                    <Border Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Padding="16"
                                            BackgroundColor="White"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14"/>
                                        </Border.StrokeShape>

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                                  Path=BindingContext.OpenLedgerItemCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>

                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                              ColumnSpacing="12">

                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding EntryKind}"
                                                       FontAttributes="Bold"
                                                       FontSize="14"
                                                       TextColor="#222"/>
                                                <Label Text="{Binding Subtitle}"
                                                       FontSize="12"
                                                       TextColor="Gray"/>
                                                <Label Text="{Binding Reference}"
                                                       FontSize="12"
                                                       TextColor="#555"/>

                                                <Frame BackgroundColor="#FFF1F2"
                                                       BorderColor="#FECACA"
                                                       CornerRadius="20"
                                                       Padding="6,2"
                                                       HasShadow="False"
                                                       IsVisible="{Binding IsOverdue}">
                                                    <Label Text="{Binding DueStatusText}"
                                                           FontSize="10"
                                                           TextColor="#B91C1C"
                                                           FontAttributes="Bold"/>
                                                </Frame>
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="2"
                                                                 HorizontalOptions="End">
                                                <Label Text="{Binding AmountDisplay}"
                                                       FontAttributes="Bold"
                                                       HorizontalTextAlignment="End"
                                                       TextColor="{Binding AmountColor}"/>
                                                <Label Text="{Binding RemainingDisplay}"
                                                       FontSize="12"
                                                       HorizontalTextAlignment="End"
                                                       TextColor="Gray"/>
                                            </VerticalStackLayout>

                                            <Label Grid.Column="2"
                                                   FontFamily="MaterialSymbolsRounded"
                                                   Text="&#xe5cc;"
                                                   FontSize="20"
                                                   TextColor="#9CA3AF"
                                                   VerticalOptions="Center"
                                                   Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView HeightRequest="20" Color="Transparent"/>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>