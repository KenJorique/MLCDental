<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ClinicApp.Models.SupabaseModels"
    x:Class="ClinicApp.Views.TransactionRelated.BillDetailsPage"
    Title="Bill Details"
    Shell.TabBarIsVisible="False"
    Shell.BackgroundColor="{StaticResource PrimaryGreen}"
    Shell.ForegroundColor="{StaticResource White}"
    Shell.TitleColor="{StaticResource White}"
    BackgroundColor="#F5F5F5">

	<Grid>

		<ScrollView>
			<VerticalStackLayout
                Padding="16"
                Spacing="14">

				<!-- HEADER -->

				<Frame
                    CornerRadius="12"
                    BackgroundColor="{StaticResource White}"
                    BorderColor="{StaticResource Gray100}"
                    Padding="16"
                    HasShadow="False">

					<VerticalStackLayout Spacing="4">

						<Grid ColumnDefinitions="*,Auto">
							<Label
                                Text="{Binding PatientName}"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{StaticResource TextPrimary}"
                                VerticalOptions="Center"/>

							<!-- Status pill — was its own card below; now sits
                                 right beside the patient name instead. -->
							<Frame Grid.Column="1"
                                   BackgroundColor="{Binding Bill.StatusBgColor}"
                                   BorderColor="Transparent"
                                   CornerRadius="20"
                                   Padding="10,4"
                                   HasShadow="False"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End">
								<Label Text="{Binding Status}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{Binding Bill.StatusColor}"/>
							</Frame>
						</Grid>

						<Label
                            Text="{Binding BillNumber,StringFormat='Receipt #: {0}'}"
                            FontSize="13"
                            TextColor="{StaticResource TextSecondary}"/>

					</VerticalStackLayout>

				</Frame>


				<!-- SERVICES -->
				<Frame
                    CornerRadius="10"
                    BackgroundColor="{StaticResource White}"
                    BorderColor="{StaticResource Gray100}"
                    Padding="14"
                    HasShadow="False">

					<VerticalStackLayout Spacing="10">

						<Label
                            Text="Services Rendered"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Black}"/>

						<Label
    Text="No services recorded for this bill."
    FontSize="12"
    TextColor="{StaticResource Gray400}"
    IsVisible="{Binding Items.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=invert}"/>

						<CollectionView
                            ItemsSource="{Binding Items}">

							<CollectionView.ItemTemplate>

								<DataTemplate x:DataType="models:SupabaseBillItem">

									<Frame
                                        Margin="0,0,0,8"
                                        Padding="12"
                                        CornerRadius="10"
                                        BackgroundColor="#FAFAFC"
                                        BorderColor="{StaticResource Gray100}"
                                        HasShadow="False">

										<!-- Service name + subtotal only — the old "Details" toggle and its expand panel were removed (button was non-functional). -->
										<VerticalStackLayout Spacing="2">

											<Label
                                                Text="{Binding ServiceName}"
                                                FontSize="15"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Black}"/>

											<Label
                                                Text="{Binding SubtotalDisplay}"
                                                FontSize="13"
                                                TextColor="{StaticResource Primary}"/>

										</VerticalStackLayout>

									</Frame>

								</DataTemplate>

							</CollectionView.ItemTemplate>

						</CollectionView>

					</VerticalStackLayout>

				</Frame>


				<!-- PAYMENT HISTORY -->

				<Frame
                    CornerRadius="10"
                    BackgroundColor="{StaticResource White}"
                    BorderColor="{StaticResource Gray100}"
                    Padding="14"
                    HasShadow="False">

					<VerticalStackLayout Spacing="10">

						<Label
                            Text="Payment History"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Black}"/>

						<Label
    Text="No payments recorded yet."
    FontSize="12"
    TextColor="{StaticResource Gray400}"
    IsVisible="{Binding Payments.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=invert}"/>

						<CollectionView
                            ItemsSource="{Binding Payments}">

							<CollectionView.ItemTemplate>

								<DataTemplate
                                    x:DataType="models:SupabasePayment">

									<Grid
                                        Padding="0,8"
                                        ColumnDefinitions="*,Auto">

										<VerticalStackLayout Spacing="2">

											<Label
                                                Text="{Binding DateDisplay}"
                                                FontSize="13"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Gray700}"/>

										</VerticalStackLayout>

										<Label
                                            Grid.Column="1"
                                            VerticalOptions="Center"
                                            Text="{Binding AmountDisplay}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource Primary}"/>

									</Grid>

								</DataTemplate>

							</CollectionView.ItemTemplate>

						</CollectionView>

					</VerticalStackLayout>

				</Frame>


				<!-- INSTALLMENT INFO -->

				<Frame BackgroundColor="#FFF8E1"
                       BorderColor="#FFE082"
                       CornerRadius="12"
                       Padding="12"
                       HasShadow="False"
                       IsVisible="{Binding Bill.IsInstallment}">

					<VerticalStackLayout Spacing="4">
						<Label Text="Installment Plan"
                               FontAttributes="Bold"
                               TextColor="#F57F17"/>
						<Label Text="{Binding Bill.InstallmentDisplay}"
                               FontSize="12"
                               TextColor="#F57F17"/>

						<Frame BackgroundColor="{Binding Bill.DueStatusColor}"
                               CornerRadius="20"
                               Padding="8,4"
                               HasShadow="False"
                               HorizontalOptions="Start"
                               IsVisible="{Binding Bill.IsInstallment}">
							<Label Text="{Binding Bill.DueStatusText}"
                                   FontSize="10"
                                   TextColor="{StaticResource White}"
                                   FontAttributes="Bold"/>
						</Frame>

						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Last Payment"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray500}"/>
							<Label Grid.Column="1"
                                   Text="{Binding LastPaymentDateDisplay}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Gray700}"/>
						</Grid>

						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Next Due"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray500}"/>
							<Label Grid.Column="1"
                                   Text="{Binding DueDateDisplay}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#C62828"/>
						</Grid>
					</VerticalStackLayout>
				</Frame>


				<!-- BILL SUMMARY -->

				<Frame
                    CornerRadius="10"
                    BackgroundColor="{StaticResource White}"
                    BorderColor="{StaticResource Gray100}"
                    Padding="14"
                    HasShadow="False">

					<VerticalStackLayout
                        Spacing="10">

						<Label
                            Text="Bill Summary"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Black}"/>

						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Subtotal" FontSize="13" TextColor="{StaticResource Gray500}"/>
							<Label
                                Grid.Column="1"
                                Text="{Binding SubtotalDisplay}"
                                FontSize="13"
                                TextColor="{StaticResource Gray500}"/>
						</Grid>

						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Discount" FontSize="13" TextColor="{StaticResource Gray500}"/>
							<Label
                                Grid.Column="1"
                                Text="{Binding DiscountDisplay}"
                                FontSize="13"
                                TextColor="#C62828"/>
						</Grid>

						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Paid" FontSize="13" TextColor="{StaticResource Primary}"/>
							<Label
                                Grid.Column="1"
                                Text="{Binding PaidDisplay}"
                                FontSize="13"
                                TextColor="{StaticResource Primary}"/>
						</Grid>

						<Grid ColumnDefinitions="*,Auto">
							<Label
                                Text="Balance"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#C62828"/>

							<Label
                                Grid.Column="1"
                                FontSize="13"
                                FontAttributes="Bold"
                                Text="{Binding BalanceDisplay}"
                                TextColor="#C62828"/>
						</Grid>

						<BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray100}" Margin="0,2"/>

						<Grid ColumnDefinitions="*,Auto">

							<Label
                                Text="TOTAL"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Black}"/>

							<Label
                                Grid.Column="1"
                                FontSize="17"
                                FontAttributes="Bold"
                                Text="{Binding TotalDisplay}"
                                TextColor="{StaticResource Primary}"/>

						</Grid>

					</VerticalStackLayout>

				</Frame>


				<!-- BUTTONS -->

				<Button
                    Text="Add Payment"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource White}"
                    CornerRadius="12"
                    HeightRequest="48"
                    FontSize="14"
                    IsVisible="{Binding HasBalance}"
                    Command="{Binding AddPaymentCommand}"/>


			</VerticalStackLayout>

		</ScrollView>

		<Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000"
              ZIndex="20">
			<VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12">
				<ActivityIndicator IsRunning="True"
                                   Color="{StaticResource White}"
                                   WidthRequest="40"
                                   HeightRequest="40"/>
				<Label Text="Loading..."
                       TextColor="{StaticResource White}"
                       FontSize="14"
                       HorizontalOptions="Center"/>
			</VerticalStackLayout>
		</Grid>

	</Grid>

</ContentPage>