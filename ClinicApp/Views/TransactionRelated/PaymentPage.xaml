<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ClinicApp.Views.TransactionRelated.PaymentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource PageBg}"
    Title="Payment"
    Shell.TabBarIsVisible="False"
    Shell.NavBarIsVisible="True"
    Shell.BackgroundColor="{StaticResource PrimaryGreen}"
    Shell.ForegroundColor="{StaticResource White}"
    Shell.TitleColor="{StaticResource White}">

	<Grid>
		<ScrollView>
			<VerticalStackLayout Padding="16" Spacing="14">

				<!-- Patient info card: same white card style as BillSummaryPage -->
				<Frame BackgroundColor="{StaticResource White}"
                       BorderColor="{StaticResource Gray100}"
                       CornerRadius="12"
                       Padding="14"
                       HasShadow="False">
					<Label Text="{Binding PatientName}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Black}"
                           VerticalOptions="Center"/>
				</Frame>

				<Frame BackgroundColor="#FFF8E1"
                       BorderColor="#FFE082"
                       CornerRadius="12"
                       Padding="12"
                       HasShadow="False"
                       IsVisible="{Binding IsInstallment}">

					<VerticalStackLayout Spacing="4">
						<Label Text="Installment Plan"
                               FontAttributes="Bold"
                               TextColor="#F57F17"/>
						<Label Text="{Binding InstallmentDisplay}"
                               FontSize="13"
                               TextColor="#F57F17"/>

						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Next Due (est.)"
                                   FontSize="13"
                                   TextColor="{StaticResource Gray500}"/>
							<Label Grid.Column="1"
                                   Text="{Binding DueDateDisplay}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource StatusOut}"/>
						</Grid>
					</VerticalStackLayout>
				</Frame>

				<!-- Bill summary -->
				<Frame BackgroundColor="{StaticResource White}"
                       BorderColor="{StaticResource Gray100}"
                       CornerRadius="12"
                       Padding="14"
                       HasShadow="False">
					<VerticalStackLayout Spacing="10">
						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Subtotal" FontSize="13" TextColor="{StaticResource Gray500}"/>
							<Label Grid.Column="1" Text="{Binding SubtotalDisplay}" FontSize="13" TextColor="{StaticResource Gray500}"/>
						</Grid>

						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Discount" FontSize="13" TextColor="{StaticResource Gray500}"/>
							<Label Grid.Column="1" Text="{Binding DiscountDisplay}" FontSize="13" TextColor="{StaticResource Gray500}"/>
						</Grid>

						<Grid ColumnDefinitions="*,Auto"
                              Margin="0,2,0,0"
                              Padding="0,10,0,0">
							<BoxView Grid.ColumnSpan="2" HeightRequest="0.5" Color="{StaticResource Gray100}" VerticalOptions="Start"/>
							<Label Text="Total" FontSize="13" TextColor="{StaticResource Gray500}" VerticalOptions="Center" Margin="0,4,0,0"/>
							<Label Grid.Column="1" Text="{Binding TotalDisplay}" FontSize="13" TextColor="{StaticResource Gray500}" VerticalOptions="Center" Margin="0,4,0,0"/>
						</Grid>

						<!-- Due Today: biggest, most prominent line, matching Bill Summary's own hero figure -->
						<Grid ColumnDefinitions="*,Auto"
                              Margin="0,2,0,0"
                              Padding="0,10,0,0">
							<BoxView Grid.ColumnSpan="2" HeightRequest="0.5" Color="{StaticResource Gray100}" VerticalOptions="Start"/>
							<Label Text="Due Today" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Black}" VerticalOptions="Center" Margin="0,4,0,0"/>
							<Label Grid.Column="1"
                                   Text="{Binding MinimumDueTodayDisplay}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center"
                                   Margin="0,4,0,0"/>
						</Grid>
					</VerticalStackLayout>
				</Frame>

				<!-- Amount entry -->
				<Frame BackgroundColor="{StaticResource White}"
                       BorderColor="{StaticResource Gray100}"
                       CornerRadius="12"
                       Padding="14"
                       HasShadow="False">
					<VerticalStackLayout Spacing="12">
						<Label Text="Amount Received Today"
                               FontSize="13"
                               TextColor="{StaticResource Gray500}"
                               FontAttributes="Bold"/>

						<Border Style="{StaticResource FormInputBoxTall}">
							<Grid ColumnDefinitions="Auto,*">
								<Label Text="₱"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center"/>
								<Entry x:Name="AmountEntry"
                                       Grid.Column="1"
                                       Style="{StaticResource FormEntry}"
                                       Keyboard="Numeric"
                                       FontSize="26"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="End"
                                       TextChanged="OnAmountTextChanged"/>
							</Grid>
						</Border>
					</VerticalStackLayout>
				</Frame>

				<!-- Amount too large: shown instead of Change when the entered amount exceeds the whole balance -->
				<Frame BackgroundColor="#FFF3E0"
                       BorderColor="#FFCC80"
                       CornerRadius="12"
                       Padding="12"
                       HasShadow="False"
                       IsVisible="{Binding IsAmountTooLarge}">
					<Label Text="{Binding BalanceDisplay, StringFormat='This is more than the total balance ({0}). Please double-check the amount.'}"
                           FontSize="13"
                           TextColor="#E65100"/>
				</Frame>

				<!-- Change: shown when the amount entered exceeds the minimum due but not the whole balance -->
				<Frame BackgroundColor="{StaticResource Secondary}"
                       BorderColor="Transparent"
                       CornerRadius="12"
                       Padding="12"
                       HasShadow="False"
                       IsVisible="{Binding HasChange}">
					<Grid ColumnDefinitions="*,Auto">
						<Label Text="Change"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"/>
						<Label Grid.Column="1"
                               Text="{Binding ChangeDisplay}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"/>
					</Grid>
				</Frame>

				<!-- Error -->
				<Frame BackgroundColor="{StaticResource PageBg}"
                       BorderColor="{StaticResource Gray500}"
                       CornerRadius="12"
                       Padding="12"
                       HasShadow="False"
                       IsVisible="{Binding HasError}">
					<Label Text="{Binding ErrorMessage}"
                           FontSize="13"
                           TextColor="{StaticResource StatusOut}"/>
				</Frame>

				<Button Text="Record Payment"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}"
                        CornerRadius="12"
                        HeightRequest="48"
                        FontSize="14"
                        Command="{Binding RecordPaymentCommand}"/>

				<!--<Button Text="Skip — Pay Later"
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource Gray100}"
                        BorderWidth="1"
                        TextColor="{StaticResource Gray400}"
                        CornerRadius="12"
                        HeightRequest="44"
                        FontSize="13"
                        Command="{Binding SkipPaymentCommand}"/>-->
			</VerticalStackLayout>
		</ScrollView>

		<Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000"
              ZIndex="20">
			<VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12">
				<ActivityIndicator IsRunning="True"
                                   Color="{StaticResource White}"
                                   WidthRequest="40"
                                   HeightRequest="40"/>
				<Label Text="Loading..."
                       TextColor="{StaticResource White}"
                       FontSize="14"
                       HorizontalOptions="Center"/>
			</VerticalStackLayout>
		</Grid>
	</Grid>
</ContentPage>
