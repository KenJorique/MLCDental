<ContentPage
    x:Class="ClinicApp.Views.TransactionRelated.PaymentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F5F5F5"
    Title="Payment"
    Shell.TabBarIsVisible="False">

	<Grid>
		<ScrollView>
			<VerticalStackLayout Padding="16" Spacing="14">

				<!-- Header: brand green, matching BillDetailsPage's header treatment -->
				<Frame BackgroundColor="{StaticResource PrimaryDark}"
                       BorderColor="{StaticResource PrimaryDark}"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="False">
					<VerticalStackLayout Spacing="4">
						<Label Text="{Binding PatientName}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"/>
					</VerticalStackLayout>
				</Frame>

				<Frame BackgroundColor="#FFF8E1"
                       BorderColor="#FFE082"
                       CornerRadius="12"
                       Padding="12"
                       HasShadow="False"
                       IsVisible="{Binding IsInstallment}">

					<VerticalStackLayout Spacing="4">
						<Label Text="Installment Plan"
                               FontAttributes="Bold"
                               TextColor="#F57F17"/>
						<Label Text="{Binding InstallmentDisplay}"
                               FontSize="12"
                               TextColor="#F57F17"/>

						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Next Due (est.)"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray500}"/>
							<Label Grid.Column="1"
                                   Text="{Binding DueDateDisplay}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#C62828"/>
						</Grid>
					</VerticalStackLayout>
				</Frame>

				<!-- Bill summary -->
				<Frame BackgroundColor="{StaticResource White}"
                       BorderColor="{StaticResource Gray100}"
                       CornerRadius="12"
                       Padding="14"
                       HasShadow="False">
					<VerticalStackLayout Spacing="10">
						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Subtotal" FontSize="13" TextColor="{StaticResource Gray500}"/>
							<Label Grid.Column="1" Text="{Binding SubtotalDisplay}" FontSize="13" TextColor="{StaticResource Gray500}"/>
						</Grid>

						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Discount" FontSize="13" TextColor="{StaticResource Gray500}"/>
							<Label Grid.Column="1" Text="{Binding DiscountDisplay}" FontSize="13" TextColor="{StaticResource Gray500}"/>
						</Grid>

						<Grid ColumnDefinitions="*,Auto"
                              Margin="0,2,0,0"
                              Padding="0,10,0,0">
							<BoxView Grid.ColumnSpan="2" HeightRequest="0.5" Color="{StaticResource Gray100}" VerticalOptions="Start"/>
							<Label Text="Total" FontSize="13" TextColor="{StaticResource Gray500}" VerticalOptions="Center" Margin="0,4,0,0"/>
							<Label Grid.Column="1" Text="{Binding TotalDisplay}" FontSize="13" TextColor="{StaticResource Gray500}" VerticalOptions="Center" Margin="0,4,0,0"/>
						</Grid>

						<!-- Due Today: last line, biggest and most prominent —
                             matches Bill Summary's own "Due Today" hero, both
                             in naming and color, for consistency. Previously
                             showed the whole bill's remaining Balance, which
                             was identical to Total on a first payment (hence
                             redundant) and not what's actually being asked
                             for today on later/partial visits. -->
						<Grid ColumnDefinitions="*,Auto"
                              Margin="0,2,0,0"
                              Padding="0,10,0,0">
							<BoxView Grid.ColumnSpan="2" HeightRequest="0.5" Color="{StaticResource Gray100}" VerticalOptions="Start"/>
							<Label Text="Due Today" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Black}" VerticalOptions="Center" Margin="0,4,0,0"/>
							<Label Grid.Column="1"
                                   Text="{Binding MinimumDueTodayDisplay}"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center"
                                   Margin="0,4,0,0"/>
						</Grid>
					</VerticalStackLayout>
				</Frame>

				<!-- Amount entry -->
				<Frame BackgroundColor="{StaticResource White}"
                       BorderColor="{StaticResource Gray100}"
                       CornerRadius="12"
                       Padding="14"
                       HasShadow="False">
					<VerticalStackLayout Spacing="12">
						<Label Text="Amount Received Today"
                               FontSize="13"
                               TextColor="{StaticResource Gray500}"
                               FontAttributes="Bold"/>

						<Border Style="{StaticResource FormInputBoxTall}">
							<Grid ColumnDefinitions="Auto,*">
								<Label Text="₱"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center"/>
								<Entry x:Name="AmountEntry"
                                       Grid.Column="1"
                                       Style="{StaticResource FormEntry}"
                                       Keyboard="Numeric"
                                       FontSize="26"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="End"
                                       TextChanged="OnAmountTextChanged"/>
							</Grid>
						</Border>
					</VerticalStackLayout>
				</Frame>

				<!-- Amount too large: shown instead of Change when the entered
                     amount exceeds the WHOLE bill balance — almost always a
                     typo (e.g. an extra zero), so it's flagged rather than
                     silently computing a huge "change" figure. Record Payment
                     still asks for confirmation before proceeding. -->
				<Frame BackgroundColor="#FFF3E0"
                       BorderColor="#FFCC80"
                       CornerRadius="12"
                       Padding="12"
                       HasShadow="False"
                       IsVisible="{Binding IsAmountTooLarge}">
					<Label Text="{Binding BalanceDisplay, StringFormat='This is more than the total balance ({0}). Please double-check the amount.'}"
                           FontSize="12"
                           TextColor="#E65100"/>
				</Frame>

				<!-- Change: shown when the entered amount exceeds the minimum
                     (but not the whole balance). The excess isn't recorded as
                     extra payment — it's Change, same as a cash register. Use
                     Add Payment elsewhere if the patient wants to pay more
                     toward the balance. -->
				<Frame BackgroundColor="{StaticResource Secondary}"
                       BorderColor="Transparent"
                       CornerRadius="12"
                       Padding="12"
                       HasShadow="False"
                       IsVisible="{Binding HasChange}">
					<Grid ColumnDefinitions="*,Auto">
						<Label Text="Change"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"/>
						<Label Grid.Column="1"
                               Text="{Binding ChangeDisplay}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"/>
					</Grid>
				</Frame>

				<!-- Error -->
				<Frame BackgroundColor="#FCEAEA"
                       BorderColor="#FFCDD2"
                       CornerRadius="12"
                       Padding="12"
                       HasShadow="False"
                       IsVisible="{Binding HasError}">
					<Label Text="{Binding ErrorMessage}"
                           FontSize="12"
                           TextColor="#C62828"/>
				</Frame>

				<Button Text="Record Payment"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}"
                        CornerRadius="12"
                        HeightRequest="48"
                        FontSize="14"
                        Command="{Binding RecordPaymentCommand}"/>

				<!--<Button Text="Skip — Pay Later"
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource Gray100}"
                        BorderWidth="1"
                        TextColor="{StaticResource Gray400}"
                        CornerRadius="12"
                        HeightRequest="44"
                        FontSize="13"
                        Command="{Binding SkipPaymentCommand}"/>-->
			</VerticalStackLayout>
		</ScrollView>

		<Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000"
              ZIndex="20">
			<VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12">
				<ActivityIndicator IsRunning="True"
                                   Color="{StaticResource White}"
                                   WidthRequest="40"
                                   HeightRequest="40"/>
				<Label Text="Loading..."
                       TextColor="{StaticResource White}"
                       FontSize="14"
                       HorizontalOptions="Center"/>
			</VerticalStackLayout>
		</Grid>
	</Grid>
</ContentPage>