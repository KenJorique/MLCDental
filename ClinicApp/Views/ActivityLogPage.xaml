<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClinicApp.Views.ActivityLogPage"
             x:Name="RootPage"
             Title="Activity Log"
             Shell.BackgroundColor="{StaticResource Primary}"
             Shell.TitleColor="White"
             Shell.ForegroundColor="White"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

	<Grid RowDefinitions="Auto,*" Padding="20,12,20,0">

		<!-- Horizontal scrollable filter chips, one per activity module. -->
		<ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,12">
			<HorizontalStackLayout BindableLayout.ItemsSource="{Binding Filters}" Spacing="0">
				<BindableLayout.ItemTemplate>
					<DataTemplate>
						<Border StrokeShape="RoundRectangle 16"
                                Padding="14,6"
                                Margin="0,0,8,0"
                                StrokeThickness="1"
                                Stroke="{StaticResource Gray200}"
                                BackgroundColor="Transparent">
							<Border.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.SelectFilterCommand}"
                                                       CommandParameter="{Binding .}"/>
							</Border.GestureRecognizers>
							<Label Text="{Binding Label}" FontSize="13" TextColor="{StaticResource Gray600}">
								<Label.Triggers>
									<DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
										<Setter Property="TextColor" Value="White"/>
									</DataTrigger>
								</Label.Triggers>
							</Label>
							<Border.Triggers>
								<DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
									<Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
									<Setter Property="Stroke" Value="{StaticResource Primary}"/>
								</DataTrigger>
							</Border.Triggers>
						</Border>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</HorizontalStackLayout>
		</ScrollView>

		<RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
			<CollectionView ItemsSource="{Binding Activities}">
				<CollectionView.EmptyView>
					<Label Text="No activity recorded yet." Style="{StaticResource MutedCaptionStyle}" Margin="0,20" HorizontalTextAlignment="Center"/>
				</CollectionView.EmptyView>
				<CollectionView.ItemTemplate>
					<DataTemplate>
						<VerticalStackLayout>
							<Grid ColumnDefinitions="*,Auto" Padding="0,12">
								<Label Grid.Column="0" Text="{Binding Description}" FontSize="13"
                                       TextColor="{StaticResource Gray900}" VerticalOptions="Center" LineBreakMode="WordWrap"/>
								<Label Grid.Column="1" Text="{Binding TimeAgoDisplay}" FontSize="11"
                                       TextColor="{StaticResource Gray400}" VerticalOptions="Center" Margin="10,0,0,0"/>
							</Grid>
							<BoxView HeightRequest="1" Color="{StaticResource Gray100}"/>
						</VerticalStackLayout>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</RefreshView>

	</Grid>

</ContentPage>
