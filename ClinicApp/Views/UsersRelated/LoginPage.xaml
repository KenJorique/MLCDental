<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:ClinicApp.Converters"
             x:Class="ClinicApp.Views.UsersRelated.LoginPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F5F0D0">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <conv:PasswordToggleTextConverter x:Key="PasswordToggleTextConverter"/>
            <conv:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- NOTE: back-button/hardware-back handling for this page is done in
         LoginPage.xaml.cs (OnBackButtonPressed) so a logged-out user can
         never navigate "back" into the app. -->

    <ScrollView>
        <Grid Padding="28" RowSpacing="0" VerticalOptions="Center"> 
            <VerticalStackLayout Spacing="6" MaximumWidthRequest="420" HorizontalOptions="Center">

                <!-- Clinic branding -->
                <Image Source="clinic_logo.png"
                       HeightRequest="90"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       Margin="0,0,0,8"
                       IsVisible="False"
                       x:Name="ClinicLogo"/>
                <!-- Swap IsVisible to True once clinic_logo.png is added to Resources/Images -->

                <Label Text="MLC Dental Clinic"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#4A3B14"
                       HorizontalOptions="Center"/>

                <Label Text="Dentist Login"
                       FontSize="16"
                       TextColor="#8A7A3E"
                       HorizontalOptions="Center"
                       Margin="0,0,0,20"/>

                <Frame Padding="24"
                       CornerRadius="16"
                       BackgroundColor="White"
                       BorderColor="#E8DFB0"
                       HasShadow="True">

                    <VerticalStackLayout Spacing="14">

                        <Label Text="Email or Username" FontAttributes="Bold" TextColor="#4A3B14"/>
                        <Entry Text="{Binding Identifier}"
                               Placeholder="you@mlcdental.com"
                               Keyboard="Email"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                               ReturnType="Next"/>

                        <Label Text="Password" FontAttributes="Bold" TextColor="#4A3B14"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Grid.Column="0"
                                   Text="{Binding Password}"
                                   Placeholder="Enter password"
                                   IsPassword="{Binding IsPasswordHidden}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                   ReturnType="Done"/>
                            <Button Grid.Column="1"
                                    Text="{Binding IsPasswordHidden, Converter={StaticResource PasswordToggleTextConverter}}"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="#8A7A3E"
                                    FontSize="12"
                                    Padding="8,0"/>
                        </Grid>

                        <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                            <CheckBox IsChecked="{Binding RememberMe}"
                                      Color="#C8A84B"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>
                            <Label Text="Remember me on this device for 30 days"
                                   FontSize="13"
                                   TextColor="#4A3B14"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <!-- Tapping the label toggles it too, not just the tiny checkbox hit-target -->
                                    <TapGestureRecognizer Tapped="OnRememberMeLabelTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                        <!-- Generic error — deliberately never says "no such account" vs "wrong password" -->
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="Crimson"
                               FontSize="13"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"/>

                        <Grid Margin="0,10,0,0">
                            <Button Text="Log In"
                                    Command="{Binding LoginCommand}"
                                    IsEnabled="{Binding CanLogin}"
                                    BackgroundColor="#C8A84B"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    HeightRequest="48"
                                    CornerRadius="10"
                                    IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>

                            <ActivityIndicator IsRunning="{Binding IsBusy}"
                                                IsVisible="{Binding IsBusy}"
                                                Color="#C8A84B"
                                                HeightRequest="48"/>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <Label Text="Dentist and Secretary accounts are created by clinic administration."
                       FontSize="11"
                       TextColor="#8A7A3E"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="0,16,0,0"/>
                <!-- Deliberately no "Register" link/button here — see spec: no self-service dentist signup. -->

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
