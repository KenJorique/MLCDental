<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:ClinicApp.Converters"
             x:Class="ClinicApp.Views.UsersRelated.LoginPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

	<ContentPage.Resources>
		<ResourceDictionary>
			<conv:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
			<conv:PasswordToggleIconConverter x:Key="PasswordToggleIconConverter"/>
		</ResourceDictionary>
	</ContentPage.Resources>

	<!-- Page background: soft white-to-green wash instead of a flat fill -->
	<ContentPage.Background>
		<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="{StaticResource White}" Offset="0.0"/>
			<GradientStop Color="{StaticResource Secondary}" Offset="1.0"/>
		</LinearGradientBrush>
	</ContentPage.Background>

	<!-- NOTE: back-button/hardware-back handling for this page is done in
         LoginPage.xaml.cs (OnBackButtonPressed) so a logged-out user can
         never navigate "back" into the app. -->

	<ScrollView>
		<Grid Padding="24,20" RowSpacing="0" VerticalOptions="Center">
			<VerticalStackLayout Spacing="6" MaximumWidthRequest="420" HorizontalOptions="Center">

				<!-- MLC brand logo (replaces the old text wordmark) -->
				<Image Source="logo.png"
                       HeightRequest="140"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       Margin="0,-20,0,10"/>

				<!-- Was a Frame — switched to Border to match every other card in the app; kept its
                     larger padding/radius/shadow since this is the one "hero" card on an auth screen,
                     not a compact list-item card like ElevatedCardStyle is meant for. -->
				<Border Padding="28" Margin="0,20,0,0"
                        BackgroundColor="{StaticResource White}"
                        Stroke="{StaticResource Secondary}"
                        StrokeThickness="1">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="22"/>
					</Border.StrokeShape>
					<Border.Shadow>
						<Shadow Brush="{StaticResource PrimaryDark}"
                                Opacity="0.12"
                                Radius="20"
                                Offset="0,8"/>
					</Border.Shadow>

					<VerticalStackLayout Spacing="16">

						<!-- Label color/size now matches FormFieldLabel (dark TextPrimary, not brand green) —
                             Margin overridden to 0 since spacing here already comes from this stack's
                             own Spacing="16", not from the style's built-in margin. -->
						<Label Text="Email or Username" Style="{StaticResource FormFieldLabel}" Margin="0"/>
						<!-- Entry left exactly as-is per Yang's request — same colors, sizing, placeholder. -->
						<Entry TextColor="{StaticResource Gray600}"
                               PlaceholderColor="{StaticResource Gray300}"
                               FontSize="15"
                               Text="{Binding Identifier}"
                               Placeholder="you@mlcdental.com"
                               Keyboard="Email"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                               ReturnType="Next"/>

						<Label Text="Password" Style="{StaticResource FormFieldLabel}" Margin="0"/>
						<Grid>
							<!-- Entry fills the full width so its underline matches the email field's length; the eye icon sits on top of it, not beside it. -->
							<Entry TextColor="{StaticResource Gray600}"
                                   PlaceholderColor="{StaticResource Gray300}"
                                   FontSize="15"
                                   Text="{Binding Password}"
                                   Placeholder="Enter password"
                                   IsPassword="{Binding IsPasswordHidden}"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                   ReturnType="Done"/>
							<Label Text="{Binding IsPasswordHidden, Converter={StaticResource PasswordToggleIconConverter}}"
                                   FontFamily="MaterialSymbolsRounded"
                                   FontSize="22"
                                   TextColor="{StaticResource Gray400}"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   Margin="0,0,4,0"
                                   InputTransparent="False">
								<Label.GestureRecognizers>
									<TapGestureRecognizer Command="{Binding TogglePasswordVisibilityCommand}"/>
								</Label.GestureRecognizers>
							</Label>
						</Grid>

						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,4,0,0">
							<CheckBox Grid.Column="0"
                                      WidthRequest="22"
                                      HeightRequest="22"
                                      IsChecked="{Binding RememberMe}"
                                      Color="{StaticResource Primary}"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>
							<Label Grid.Column="1"
                                   Text="Remember me on this device for 30 days"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray500}"
                                   LineBreakMode="NoWrap"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <!-- Tapping the label toggles it too, not just the tiny checkbox hit-target -->
                                    <TapGestureRecognizer Tapped="OnRememberMeLabelTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8" Margin="24,0,0,0"
                        IsVisible="{Binding IsBiometricAvailable}">
                            <CheckBox IsChecked="{Binding UseBiometricLock}"
              IsEnabled="{Binding RememberMe}"
              Color="#C8A84B"/>
                            <Label Text="Require fingerprint / Face ID to unlock"
           FontSize="12"
           TextColor="#8A7A3E"
           VerticalOptions="Center"/>
                        </HorizontalStackLayout>


                        <!-- Generic error — deliberately never says "no such account" vs "wrong password" -->
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="Crimson"
                               FontSize="13"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"/>
								<Label.GestureRecognizers>
									<!-- Tapping the label toggles it too, not just the tiny checkbox hit-target -->
									<TapGestureRecognizer Tapped="OnRememberMeLabelTapped"/>
								</Label.GestureRecognizers>
							</Label>
						</Grid>

						<Grid Margin="0,10,0,0">
							<!-- Was custom BackgroundColor/TextColor/FontAttributes/HeightRequest/CornerRadius — now just PrimaryActionButtonStyle, same as every Save/primary button elsewhere.
                                 No IsEnabled binding anymore — the button stays green and tappable even with empty/invalid fields; Login() validates and shows the popup instead. -->
							<Button Text="Log In"
                                    Command="{Binding LoginCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>

							<ActivityIndicator IsRunning="{Binding IsBusy}"
                                                IsVisible="{Binding IsBusy}"
                                                Color="{StaticResource Primary}"
                                                HeightRequest="52"/>
						</Grid>

					</VerticalStackLayout>
				</Border>

				<Label Text="Dentist and Secretary accounts are created by clinic administration."
                       FontSize="11"
                       TextColor="{StaticResource Gray500}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="0,16,0,0"/>
				<!-- Deliberately no "Register" link/button here — see spec: no self-service dentist signup. -->

			</VerticalStackLayout>
		</Grid>
	</ScrollView>
</ContentPage>
