<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ClinicApp.ViewModels.UsersRelated"
    x:Class="ClinicApp.Views.UsersRelated.UserListPage"
    x:DataType="vm:UserViewModel"
    Title="Clinic Staff"
    Shell.NavBarIsVisible="True"
    Shell.BackgroundColor="{StaticResource PrimaryGreen}"
    Shell.TitleColor="White"
    Shell.ForegroundColor="White"
    Shell.TabBarIsVisible="False"
    BackgroundColor="{StaticResource PageBg}">

	<Grid RowDefinitions="*">

		<!-- ── STAFF LIST ── -->
		<RefreshView Grid.Row="0"
                     Command="{Binding LoadUsersCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
			<CollectionView ItemsSource="{Binding Users}"
                    SelectionMode="None"
                    Margin="28,16,28,0"
                    IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">

				<CollectionView.Footer>
					<BoxView HeightRequest="50" Color="Transparent"/>
				</CollectionView.Footer>

				<CollectionView.EmptyView>
					<Grid HorizontalOptions="Fill" VerticalOptions="Fill">
						<VerticalStackLayout Spacing="8"
								 HorizontalOptions="Center"
								 VerticalOptions="Center">
							<Label Text="No staff yet"
							   Style="{StaticResource EmptyStateTitleStyle}"
							   HorizontalTextAlignment="Center"/>
							<Label Text="Tap &quot;+ Add Staff&quot; to create your first one."
							   Style="{StaticResource EmptyStateSubtitleStyle}"
							   HorizontalTextAlignment="Center"/>
						</VerticalStackLayout>
					</Grid>
				</CollectionView.EmptyView>

				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="vm:UserCardViewModel">
						<Border Style="{StaticResource ElevatedCardStyle}"
                                Padding="16,14"
                                Margin="10,10,10,0">
							<Border.GestureRecognizers>
								<TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                              Path=BindingContext.ShowActionSheetCommand}"
                                    CommandParameter="{Binding .}"/>
							</Border.GestureRecognizers>

							<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">

								<!-- Left: full name and role -->
								<VerticalStackLayout Grid.Column="0" Spacing="3">
									<Label Text="{Binding User.FullName}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"
                                           LineBreakMode="TailTruncation"/>
									<Label Text="{Binding User.Role}"
                                           FontSize="13"
                                           TextColor="{StaticResource TextMuted}"/>
								</VerticalStackLayout>

								<!-- Right: status dot + label -->
								<HorizontalStackLayout Grid.Column="1"
                                                       Spacing="6"
                                                       VerticalOptions="Center">
									<Ellipse WidthRequest="10"
                                             HeightRequest="10"
                                             Fill="{Binding StatusColor}"
                                             VerticalOptions="Center"/>
									<Label Text="{Binding StatusText}"
                                           FontSize="13"
                                           TextColor="{StaticResource TextMuted}"
                                           VerticalOptions="Center"/>
								</HorizontalStackLayout>

							</Grid>
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</RefreshView>

		<!-- Loading -->
		<VerticalStackLayout Grid.Row="0"
                             IsVisible="{Binding IsBusy}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="8">
			<ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{StaticResource PrimaryGreen}"
                               HeightRequest="36" WidthRequest="36"/>
			<Label Text="Loading staff..."
                   Style="{StaticResource MutedCaptionStyle}"
                   HorizontalTextAlignment="Center"/>
		</VerticalStackLayout>

		<!-- FAB -->
		<Button Grid.Row="0"
                Text="+ Add Staff"
                Command="{Binding GoToAddUserCommand}"
                Style="{StaticResource FabStyle}"
                VerticalOptions="End"
                HorizontalOptions="End"
                Margin="0,0,20,24">
			<Button.Shadow>
				<Shadow Brush="Black" Opacity="0.3" Radius="8" Offset="0,3"/>
			</Button.Shadow>
		</Button>

	</Grid>
</ContentPage>
