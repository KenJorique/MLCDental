<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClinicApp.ViewModels"
             x:Class="ClinicApp.Views.AppointmentRelated.ReschedulePage"
             Title="Reschedule"
             Shell.NavBarIsVisible="True"
             Shell.BackgroundColor="{StaticResource PrimaryGreen}"
             Shell.TitleColor="White"
             Shell.ForegroundColor="White"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

	<ScrollView>
		<VerticalStackLayout Padding="16" Spacing="0">

			<!-- ── Header banner ── -->
			<Border BackgroundColor="{StaticResource PrimaryGreen}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,12"
                    Margin="0,0,0,16">
				<VerticalStackLayout Spacing="2">
					<Label Text="Reschedule Appointment"
                           FontSize="15" FontAttributes="Bold"
                           TextColor="White"/>
					<Label Text="Pick a new date and time slot"
                           FontSize="11" TextColor="{StaticResource MediumGreen}"/>
				</VerticalStackLayout>
			</Border>

			<!-- ── Patient Info card ── -->
			<Border BackgroundColor="White"
                    Stroke="{StaticResource BorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    Margin="0,0,0,14">
				<VerticalStackLayout Spacing="6">
					<Label Text="Patient Information"
                           FontSize="17" FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryGreen}"
                           Margin="0,0,0,4"/>
					<Label Text="{Binding PatientName}"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"/>
					<Label FontSize="13" TextColor="{StaticResource TextSecondary}">
						<Label.FormattedText>
							<FormattedString>
								<Span Text="Current appointment: "/>
								<Span Text="{Binding CurrentDateTime}"
                                      FontAttributes="Bold"/>
							</FormattedString>
						</Label.FormattedText>
					</Label>
				</VerticalStackLayout>
			</Border>

			<!-- ── Appointment Details card ── -->
			<Border BackgroundColor="White"
                    Stroke="{StaticResource BorderColor}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    Margin="0,0,0,14">
				<VerticalStackLayout Spacing="0">

					<Label Text="New Schedule"
                           FontSize="17" FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryGreen}"
                           Margin="0,0,0,8"/>

					<!-- Date -->
					<Label Text="Select New Date"
                           Style="{StaticResource FormFieldLabel}"
                           Margin="0,4,0,4"/>
					<Border Style="{StaticResource FormInputBox}">
						<DatePicker x:Name="NewDatePicker"
                                    MinimumDate="{Binding MinDate}"
                                    MaximumDate="{Binding MaxDate}"
                                    Date="{Binding SelectedDate}"
                                    DateSelected="OnDateSelected"
                                    Format="MMMM dd, yyyy"
                                    TextColor="{StaticResource TextPrimary}"/>
					</Border>

					<Label Text="Clinic is open Monday – Saturday only."
                           FontSize="11"
                           TextColor="{StaticResource TextMuted}"
                           Margin="0,4,0,0"/>

					<!-- Sunday warning -->
					<Border BackgroundColor="#FCEAEA"
                            Stroke="#FFCDD2"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="10,8"
                            Margin="0,8,0,0"
                            IsVisible="{Binding HasError}">
						<Label Text="{Binding ErrorMessage}"
                               FontSize="12" TextColor="#C62828"/>
					</Border>

					<!-- Time slots label -->
					<Label Text="Select New Time Slot"
                           Style="{StaticResource FormFieldLabel}"
                           Margin="0,12,0,8"/>

					<ActivityIndicator IsRunning="{Binding IsLoadingSlots}"
                                       IsVisible="{Binding IsLoadingSlots}"
                                       Color="{StaticResource PrimaryGreen}"
                                       HeightRequest="30"/>

					<Label Text="No available slots for this date."
                           FontSize="12" TextColor="{StaticResource TextMuted}"
                           IsVisible="{Binding HasNoSlots}"/>

					<!-- 3-column slot grid -->
					<CollectionView ItemsSource="{Binding TimeSlots}"
                                    SelectionMode="None"
                                    IsVisible="{Binding IsLoadingSlots,
                                        Converter={StaticResource InvertedBoolConverter}}">
						<CollectionView.ItemsLayout>
							<GridItemsLayout Orientation="Vertical"
                                             Span="3"
                                             HorizontalItemSpacing="8"
                                             VerticalItemSpacing="8"/>
						</CollectionView.ItemsLayout>
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="vm:TimeSlotItem">
								<Border BackgroundColor="{Binding BackgroundColor}"
                                        Stroke="{Binding BorderColor}"
                                        StrokeThickness="1.5"
                                        StrokeShape="RoundRectangle 10"
                                        HeightRequest="56"
                                        Margin="0">
									<Border.GestureRecognizers>
										<TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                      Path=BindingContext.SelectSlotCommand}"
                                            CommandParameter="{Binding .}"
                                            NumberOfTapsRequired="1"/>
									</Border.GestureRecognizers>
									<VerticalStackLayout VerticalOptions="Center"
                                                         HorizontalOptions="Center"
                                                         Spacing="2">
										<Label Text="{Binding Display}"
                                               FontSize="13" FontAttributes="Bold"
                                               TextColor="{Binding TextColor}"
                                               HorizontalOptions="Center"/>
										<Label Text="{Binding StatusText}"
                                               FontSize="10"
                                               TextColor="{Binding StatusColor}"
                                               HorizontalOptions="Center"/>
									</VerticalStackLayout>
								</Border>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>

				</VerticalStackLayout>
			</Border>

			<!-- ── Selected summary ── -->
			<Border BackgroundColor="#E8F5E9"
                    Stroke="#C8E6C9"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="14"
                    Margin="0,0,0,14"
                    IsVisible="{Binding HasSelection}">
				<VerticalStackLayout Spacing="6">
					<Label Text="New Schedule"
                           FontSize="14" FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryGreen}"/>
					<Label Text="{Binding SelectedSummary}"
                           FontSize="14" TextColor="Black"
                           FontAttributes="Bold"/>
				</VerticalStackLayout>
			</Border>

			<!-- ── Confirm button ── -->
			<Button Text="Confirm Reschedule"
                    BackgroundColor="{StaticResource PrimaryGreen}"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="14"
                    HeightRequest="52"
                    HorizontalOptions="Fill"
                    IsEnabled="{Binding HasSelection}"
                    Command="{Binding ConfirmRescheduleCommand}"
                    Margin="0,0,0,32"/>

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
