<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClinicApp.ViewModels"
             Title="Pending"
             x:Class="ClinicApp.Views.AppointmentRelated.AppointmentPage"
             BackgroundColor="#F5F5F5">

	<Shell.TitleView>
		<Grid ColumnDefinitions="*,Auto" Padding="0,0,20,0">
			<Label Text="Pending" FontSize="20" FontAttributes="Bold"
                   TextColor="Black" VerticalOptions="Center"/>
			<Border Grid.Column="1"
                    BackgroundColor="#E65100"
                    StrokeShape="RoundRectangle 12"
                    Padding="9,3"
                    VerticalOptions="Center">
				<Label Text="{Binding PendingCount}"
                       TextColor="White" FontSize="13"
                       FontAttributes="Bold"/>
			</Border>
		</Grid>
	</Shell.TitleView>

	<RefreshView Command="{Binding RefreshCommand}"
             IsRefreshing="{Binding IsRefreshing}">
		<ScrollView>
			<VerticalStackLayout Padding="16" Spacing="16">

				<!-- ── PENDING LIST ── -->
				<VerticalStackLayout Spacing="8">
					<Label Text="No pending bookings"
                           TextColor="Gray" FontSize="13">
						<Label.Triggers>
							<DataTrigger TargetType="Label"
                                         Binding="{Binding HasPending}"
                                         Value="True">
								<Setter Property="IsVisible" Value="False"/>
							</DataTrigger>
						</Label.Triggers>
					</Label>

					<CollectionView ItemsSource="{Binding PendingBookings}"
                                    IsVisible="{Binding HasPending}">
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="vm:BookingCardViewModel">
								<Frame Margin="0,4" Padding="14" CornerRadius="12"
                                       BorderColor="#FFE0B2" BackgroundColor="White"
                                       HasShadow="True">
									<Frame.GestureRecognizers>
										<TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AppointmentViewModel}},
                                                      Path=ShowBookingDetailCommand}"
                                            CommandParameter="{Binding .}"/>
									</Frame.GestureRecognizers>
									<VerticalStackLayout Spacing="6">

										<!-- Always visible: name, date, time, contact -->
										<Label Text="{Binding FullName}"
                                               FontSize="18" FontAttributes="Bold"
                                               TextColor="#1A1A2E"/>

										<Label Text="{Binding AppointmentDate, StringFormat='{0:MMM dd, yyyy  h:mm tt}'}"
                                               FontSize="14" TextColor="#1A1A2E"/>
										<Label Text="{Binding Phone}"
                                               FontSize="14" TextColor="#1A1A2E"/>
										<Label Text="{Binding Notes}"
                                               FontSize="12" TextColor="Gray"
                                               IsVisible="{Binding Notes, Converter={StaticResource StringToBoolConverter}}"/>

									</VerticalStackLayout>
								</Frame>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>
				</VerticalStackLayout>

			</VerticalStackLayout>
		</ScrollView>
	</RefreshView>
</ContentPage>
