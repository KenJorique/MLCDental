<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClinicApp.ViewModels"
             Title="Pending"
             x:Class="ClinicApp.Views.AppointmentRelated.AppointmentPage"
             Shell.BackgroundColor="{StaticResource Primary}"
             Shell.TitleColor="White"
             Shell.ForegroundColor="White"
             BackgroundColor="{StaticResource PageBg}">

	<RefreshView Command="{Binding RefreshCommand}"
             IsRefreshing="{Binding IsRefreshing}">
		<ScrollView>
			<VerticalStackLayout Padding="16" Spacing="16">

				<!-- ── PENDING LIST ── -->
				<CollectionView ItemsSource="{Binding PendingBookings}">

					<CollectionView.EmptyView>
						<VerticalStackLayout Spacing="4" Margin="0,40">
							<Label Text="No pending bookings" Style="{StaticResource EmptyStateTitleStyle}"/>
						</VerticalStackLayout>
					</CollectionView.EmptyView>

					<CollectionView.ItemTemplate>
						<DataTemplate x:DataType="vm:BookingCardViewModel">
							<Border Margin="0,4" Style="{StaticResource ElevatedCardStyle}">
								<Border.GestureRecognizers>
									<TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AppointmentViewModel}},
                                                  Path=ShowBookingDetailCommand}"
                                        CommandParameter="{Binding .}"/>
								</Border.GestureRecognizers>
								<VerticalStackLayout Spacing="6">

									<Label Text="{Binding FullName}"
                                           FontSize="18" FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"/>

									<Label Text="{Binding AppointmentDate, StringFormat='{0:MMM dd, yyyy  h:mm tt}'}"
                                           FontSize="14" TextColor="{StaticResource TextPrimary}"/>
									<Label Text="{Binding Phone}"
                                           FontSize="14" TextColor="{StaticResource TextPrimary}"/>
									<Label Text="{Binding Notes}"
                                           Style="{StaticResource MutedCaptionStyle}"
                                           IsVisible="{Binding Notes, Converter={StaticResource StringToBoolConverter}}"/>

								</VerticalStackLayout>
							</Border>
						</DataTemplate>
					</CollectionView.ItemTemplate>
				</CollectionView>

			</VerticalStackLayout>
		</ScrollView>
	</RefreshView>
</ContentPage>
