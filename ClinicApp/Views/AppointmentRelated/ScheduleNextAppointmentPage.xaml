<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClinicApp.ViewModels"
             x:Class="ClinicApp.Views.AppointmentRelated.ScheduleNextAppointmentPage"
             x:DataType="vm:ScheduleNextAppointmentViewModel"
             Title="Schedule Next Session"
             Shell.NavBarIsVisible="True"
             Shell.TabBarIsVisible="False"
             Shell.BackgroundColor="{StaticResource PrimaryGreen}"
             Shell.TitleColor="White"
             BackgroundColor="{StaticResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Border BackgroundColor="White" StrokeThickness="1" Stroke="{StaticResource Gray200}"
                    Padding="16" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding PatientName}" FontSize="17" FontAttributes="Bold"
                           TextColor="{StaticResource Gray800}"/>
                    <Label Text="{Binding ServiceName}" FontSize="14" TextColor="{StaticResource Gray700}"/>
                    <Label Text="{Binding SessionLabel}" FontSize="13" TextColor="{StaticResource Primary}"
                           FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Select Date" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Gray700}"/>
            <DatePicker Date="{Binding AppointmentDate}"
                        MinimumDate="{Binding MinDate}"
                        MaximumDate="{Binding MaxDate}"
                        DateSelected="OnDateSelected"/>

            <Label Text="{Binding ErrorMessage}" TextColor="Crimson" FontSize="12"
                   IsVisible="{Binding HasError}"/>

            <Label Text="Available Time Slots" FontSize="13" FontAttributes="Bold"
                   TextColor="{StaticResource Gray700}" Margin="0,8,0,0"/>

            <ActivityIndicator IsRunning="{Binding IsLoadingSlots}" IsVisible="{Binding IsLoadingSlots}"
                               Color="{StaticResource Primary}"/>

            <Label Text="No slots available for this day." FontSize="13"
                   TextColor="{StaticResource Gray400}"
                   IsVisible="{Binding HasNoSlots}"/>

            <FlexLayout BindableLayout.ItemsSource="{Binding TimeSlots}"
                        Wrap="Wrap" JustifyContent="Start">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:TimeSlotItem">
                        <Border BackgroundColor="{Binding BackgroundColor}"
                                Stroke="{Binding BorderColor}" StrokeThickness="1.5"
                                Padding="14,10" Margin="0,0,8,8" StrokeShape="RoundRectangle 10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ScheduleNextAppointmentViewModel}},
                                              Path=SelectSlotCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Display}" TextColor="{Binding TextColor}"
                                   FontSize="13" FontAttributes="Bold"/>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Label Text="{Binding SelectedSummary}" FontSize="13" TextColor="{StaticResource Primary}"
                   FontAttributes="Bold" IsVisible="{Binding HasSelection}" Margin="0,8,0,0"/>

            <Button Text="Confirm Follow-up Appointment"
                    BackgroundColor="{StaticResource Primary}" TextColor="White"
                    CornerRadius="12" HeightRequest="48" Margin="0,12,0,0"
                    IsEnabled="{Binding HasSelection}"
                    Command="{Binding ConfirmCommand}"/>

            <Button Text="Cancel" BackgroundColor="Transparent" TextColor="{StaticResource Gray400}"
                    Command="{Binding CancelCommand}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>