<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClinicApp.ViewModels"
             xmlns:models="clr-namespace:ClinicApp.Models.AppointmentModels"
             x:Class="ClinicApp.Views.AppointmentRelated.InProcedurePage"
             x:DataType="vm:InProcedureViewModel"
             Shell.TabBarIsVisible="False"
             Shell.BackgroundColor="{StaticResource Primary}"
             Shell.TitleColor="White"
             Shell.ForegroundColor="White"
             BackgroundColor="{StaticResource PageBg}"
             Title="Procedure Queue">

	<Grid RowDefinitions="*" Padding="16">

		<!-- Initial load skeleton -->
		<ActivityIndicator IsRunning="{Binding IsInitialLoading}"
                           IsVisible="{Binding IsInitialLoading}"
                           Color="{StaticResource Primary}"
                           VerticalOptions="Center" />

		<!-- Global empty state -->
		<VerticalStackLayout IsVisible="{Binding HasNone}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="4">
			<Label Text="🪑" FontSize="48" HorizontalOptions="Center" Margin="0,0,0,8"/>
			<Label Text="No active patients right now" Style="{StaticResource EmptyStateTitleStyle}"/>
		</VerticalStackLayout>

		<!-- In Procedure list -->
		<RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     IsVisible="{Binding IsInProcedureTabActive}">
			<CollectionView ItemsSource="{Binding InProcedureList}"
                             SelectionMode="None">
				<CollectionView.ItemsLayout>
					<LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
				</CollectionView.ItemsLayout>
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="models:AppointmentEntry">
						<Border Margin="0,4" Style="{StaticResource ElevatedCardStyle}">
							<Border.GestureRecognizers>
								<TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InProcedureViewModel}}, Path=SelectEntryCommand}"
                                    CommandParameter="{Binding .}" />
							</Border.GestureRecognizers>
							<VerticalStackLayout Spacing="6">
								<Label Text="{Binding PatientName}"
                                       FontSize="18" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"/>
								<Label Text="{Binding AppointmentDateTimeParsed, StringFormat='{0:MMM dd, yyyy  h:mm tt}'}"
                                       FontSize="14" TextColor="{StaticResource TextPrimary}"/>
							</VerticalStackLayout>
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</RefreshView>

		<!-- Billing list -->
