<?xml version="1.0" encoding="utf-8" ?>
<the49:BottomSheet
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:the49="https://schemas.the49.com/dotnet/2023/maui"
    xmlns:sm="clr-namespace:ClinicApp.Models.SupabaseModels"
    x:Class="ClinicApp.Views.AppointmentRelated.FollowUpRequiredSheet"
    Shell.TabBarIsVisible="True"
    HasHandle="False"
    HasBackdrop="True"
    CornerRadius="20"
    IsCancelable="False"
    BackgroundColor="White">

    <the49:BottomSheet.Detents>
        <the49:ContentDetent />
    </the49:BottomSheet.Detents>

    <VerticalStackLayout Spacing="0" Padding="0,12,0,20">

        <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2"
                 BackgroundColor="#CCCCCC"
                 HorizontalOptions="Center" Margin="0,0,0,16"/>

        <Grid Padding="20,0" ColumnDefinitions="Auto,*" Margin="0,0,0,4">
            <Label Grid.Column="0" FontFamily="MaterialSymbolsRoundedFilled" Text="&#xe5d5;"
                   FontSize="22" TextColor="{StaticResource Gold}" VerticalOptions="Center" Margin="0,0,8,0"/>
            <Label Grid.Column="1" Text="Follow-up Required"
                   FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Gray800}"
                   VerticalOptions="Center"/>
        </Grid>

        <Label Padding="20,0" Margin="0,0,0,16"
               Text="One or more services on this bill need another session."
               FontSize="13" TextColor="{StaticResource Gray400}"/>

        <CollectionView ItemsSource="{Binding PendingFollowUps}" Margin="20,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="sm:SupabaseTreatmentSequence">
                    <Border BackgroundColor="{StaticResource PageBg}" StrokeThickness="1"
                            Stroke="{StaticResource Gray200}" Padding="14,12" Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding ServiceName}" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource Gray800}"/>
                            <Label Text="{Binding SessionDisplay}" FontSize="12"
                                   TextColor="{StaticResource Gray400}"/>
                            <Label FontSize="12" TextColor="{StaticResource Gray700}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Recommended: " />
                                        <Span Text="{Binding RecommendedDateDisplay}" FontAttributes="Bold"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Button Text="Schedule Next Appointment"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White" CornerRadius="10"
                                    FontSize="13" HeightRequest="40" Margin="0,4,0,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type the49:BottomSheet}},
                                              Path=BindingContext.ScheduleFollowUpNowCommand}"
                                    CommandParameter="{Binding .}"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Continue to Payment (schedule later)"
                BackgroundColor="Transparent"
                TextColor="{StaticResource Gray400}"
                FontSize="13" Margin="20,10,20,0"
                Command="{Binding ContinueToPaymentCommand}"/>

    </VerticalStackLayout>

</the49:BottomSheet>