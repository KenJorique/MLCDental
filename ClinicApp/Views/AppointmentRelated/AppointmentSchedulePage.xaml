<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClinicApp.ViewModels"
             xmlns:models="clr-namespace:ClinicApp.Models"
             x:Class="ClinicApp.Views.AppointmentRelated.AppointmentSchedulePage"
             Title="Appointment"
             Shell.NavBarIsVisible="True"
             Shell.BackgroundColor="{StaticResource PrimaryGreen}"
             Shell.TitleColor="White"
             Shell.ForegroundColor="White"
             BackgroundColor="{StaticResource PageBg}">

	<Shell.TitleView>
		<Grid ColumnDefinitions="*,Auto" Padding="0,0,16,0">
			<Label Grid.Column="0"
                   Text="Appointment"
                   FontSize="18" FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"
                   Margin="16,0,0,0"/>

			<!-- Notification bell with badge -->
			<Grid Grid.Column="1"
                  WidthRequest="44" HeightRequest="44"
                  VerticalOptions="Center"
                  Margin="0,0,5,0">
				<Grid.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding GoToPendingCommand}"/>
				</Grid.GestureRecognizers>

				<!-- Bell icon -->
				<Label FontFamily="MaterialSymbolsRounded"
                       Text="&#xe7f4;"
                       FontSize="26"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>

				<!-- Red badge with count -->
				<Border BackgroundColor="#DC143C"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        HeightRequest="16"
                        MinimumWidthRequest="16"
                        Padding="3,0"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,6,4,0"
                        IsVisible="{Binding HasPendingBookings}">
					<Label Text="{Binding PendingBookingsCount}"
                           FontSize="10" FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
				</Border>
			</Grid>
		</Grid>
	</Shell.TitleView>

	<Grid RowDefinitions="Auto,Auto,Auto,*">

		<!-- ══ ROW 0: LIST / CALENDAR TAB TOGGLE ══
             Green underline when active, gray when inactive
             Same pattern as PatientDetailsPage tabs -->
		<Grid Grid.Row="0" ColumnDefinitions="*,*" BackgroundColor="{StaticResource PageBg}">

			<!-- List View tab -->
			<VerticalStackLayout Grid.Column="0" Spacing="0">
				<VerticalStackLayout.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding ShowListCommand}"/>
				</VerticalStackLayout.GestureRecognizers>
				<Label Text="List" Padding="0,12"
                       HorizontalTextAlignment="Center" FontSize="14"
                       FontAttributes="{Binding IsListView, Converter={StaticResource BoolToFontAttrConverter}}"
                       TextColor="{Binding IsListView, Converter={StaticResource BoolToTabTextConverter}}"/>
				<BoxView HeightRequest="3" Color="{StaticResource Primary}"
                         IsVisible="{Binding IsListView}"/>
				<BoxView HeightRequest="3" Color="{StaticResource Gray200}"
                         IsVisible="{Binding IsCalendarView}"/>
			</VerticalStackLayout>

			<!-- Calendar tab -->
			<VerticalStackLayout Grid.Column="1" Spacing="0">
				<VerticalStackLayout.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding ShowCalendarCommand}"/>
				</VerticalStackLayout.GestureRecognizers>
				<Label Text="Calendar" Padding="0,12"
                       HorizontalTextAlignment="Center" FontSize="14"
                       FontAttributes="{Binding IsCalendarView, Converter={StaticResource BoolToFontAttrConverter}}"
                       TextColor="{Binding IsCalendarView, Converter={StaticResource BoolToTabTextConverter}}"/>
				<BoxView HeightRequest="2.5" Color="{StaticResource Primary}"
                         IsVisible="{Binding IsCalendarView}"/>
				<BoxView HeightRequest="2.5" Color="{StaticResource Gray200}"
                         IsVisible="{Binding IsListView}"/>
			</VerticalStackLayout>

		</Grid>

		<!-- ══ ROW 1: BANNERS (pending review + active queue) ══ -->
		<VerticalStackLayout Grid.Row="1" Spacing="1">

			<!-- Active queue banner: in-procedure + billing -->
			<Border BackgroundColor="#2563EB"
            IsVisible="{Binding HasInProcedureQueue}"
            Padding="12,8">
				<Border.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding GoToInProcedureCommand}"/>
				</Border.GestureRecognizers>
				<Grid ColumnDefinitions="Auto,*,Auto">
					<Label Grid.Column="0"
                   FontFamily="MaterialSymbolsRounded"
                   Text="&#xe425;"
                   FontSize="16" TextColor="White"
                   VerticalOptions="Center" Margin="0,0,6,0"/>
					<Label Grid.Column="1"
                   TextColor="White" FontSize="13"
                   VerticalOptions="Center">
						<Label.FormattedText>
							<FormattedString>
								<Span Text="{Binding InProcedureQueueCount}" TextColor="White" FontAttributes="Bold"/>
								<Span Text=" patient(s) in procedure" TextColor="White" FontAttributes="Bold"/>
							</FormattedString>
						</Label.FormattedText>
					</Label>
					<HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
						<Label Text="View"
                       TextColor="White"
                       FontSize="13" FontAttributes="Bold"
                       VerticalOptions="Center"/>
						<Label FontFamily="MaterialSymbolsRoundedFilled"
                       Text="&#xe941;"
                       FontSize="16" TextColor="White"
                       VerticalOptions="Center"/>
					</HorizontalStackLayout>
				</Grid>
			</Border>

		</VerticalStackLayout>


		<!-- ══ ROW 2: WEEK NAVIGATION ══
             Arrow buttons go gray when disabled (CanGoPrevious = false) -->
		<Grid Grid.Row="2" ColumnDefinitions="36,*,36"
              BackgroundColor="{StaticResource Secondary}"
              Padding="4,4" HeightRequest="38">

			<!-- Previous arrow — gray when disabled -->
			<Label Grid.Column="0"
                   FontFamily="MaterialSymbolsRounded"
                   Text="&#xe5cb;"
                   FontSize="22"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="{Binding CanGoPrevious,
                       Converter={StaticResource BoolToColorConverter},
                       ConverterParameter='#2E7D32|#C8C8C8'}">
				<Label.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding PreviousWeekCommand}"/>
				</Label.GestureRecognizers>
			</Label>

			<!-- Date range label -->
			<Label Grid.Column="1"
                   Text="{Binding DateRangeLabel}"
                   FontSize="15" FontAttributes="Bold"
                   HorizontalOptions="Center" VerticalOptions="Center"
                   TextColor="{StaticResource Gray700}"/>

			<!-- Next arrow — always green -->
			<Label Grid.Column="2"
                   FontFamily="MaterialSymbolsRounded"
                   Text="&#xe5cc;"
                   FontSize="22"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="{StaticResource Primary}">
				<Label.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding NextWeekCommand}"/>
				</Label.GestureRecognizers>
			</Label>

		</Grid>

		<!-- ══ ROW 3: MAIN CONTENT ══ -->
		<Grid Grid.Row="3">

			<!-- LIST VIEW -->
			<RefreshView Command="{Binding RefreshCommand}"
                         IsRefreshing="{Binding IsRefreshing}"
                         IsVisible="{Binding ShowListContent}">
				<ScrollView>
					<VerticalStackLayout Padding="12" Spacing="0">

						<!-- WEEK LIST — one chronological section per day (Mon–Sat), Today included in its
                             normal weekday position with a "Today, <date>" header -->
						<Label Text="No appointments this week"
                               FontSize="12" TextColor="{StaticResource Gray400}"
                               Margin="4,0,0,8"
                               IsVisible="{Binding HasNoWeekAppointments}"/>

						<CollectionView ItemsSource="{Binding GroupedWeekAppointments}">
							<CollectionView.ItemTemplate>
								<DataTemplate x:DataType="vm:AppointmentDateGroup">
									<VerticalStackLayout Spacing="0" Margin="0,5,0,0">

										<!-- Date section header, e.g. "Monday, July 20" or "Today, July 21" -->
										<Label Text="{Binding Header}" FontSize="13" FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}" Margin="4,0,0,10"/>

										<!-- Only shown for today's own (otherwise-empty) section -->
										<Label Text="No appointments today"
                                               FontSize="12" TextColor="{StaticResource Gray400}"
                                               Margin="4,0,0,8"
                                               IsVisible="{Binding IsEmptyToday}"/>

										<CollectionView ItemsSource="{Binding Items}">
											<CollectionView.ItemTemplate>
												<DataTemplate x:DataType="models:AppointmentEntry">
													<Grid ColumnDefinitions="46,*" Margin="0,0,0,12">
														<VerticalStackLayout Grid.Column="0"
                                                            HorizontalOptions="End"
                                                            VerticalOptions="Start"
                                                            Margin="0,10,8,0" Spacing="0">
															<Label Text="{Binding TimeDisplay}"
                                                                   FontSize="12" FontAttributes="Bold"
                                                                   TextColor="{StaticResource Gray700}"
                                                                   HorizontalOptions="End"/>
															<Label Text="{Binding AmPm}"
                                                                   FontSize="9" TextColor="{StaticResource Gray400}"
                                                                   HorizontalOptions="End"/>
														</VerticalStackLayout>
														<Frame Grid.Column="1" Padding="14,12"
                                                               CornerRadius="10" HasShadow="False"
                                                               BackgroundColor="{StaticResource AppointmentCardBg}"
                                                               BorderColor="{StaticResource Gold}">
															<Frame.GestureRecognizers>
																<TapGestureRecognizer
                                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                                              Path=BindingContext.SelectWeekAppointmentCommand}"
                                                                    CommandParameter="{Binding .}"/>
															</Frame.GestureRecognizers>
															<Label Text="{Binding PatientName}"
															   FontSize="15" FontAttributes="Bold"
															   TextColor="{StaticResource Gray800}" Padding="5, 0"
															   VerticalOptions="Center"/>
														</Frame>
													</Grid>
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</VerticalStackLayout>
								</DataTemplate>
							</CollectionView.ItemTemplate>
						</CollectionView>

						<!-- Spacer for FAB (48 height + 24 margin + clearance buffer) -->
						<BoxView HeightRequest="50" Color="White"/>

					</VerticalStackLayout>
				</ScrollView>
			</RefreshView>

			<!-- Loading — shown only on first load, so the empty-state message never flashes
                 on screen before data actually arrives. Doesn't re-trigger on refresh/week-nav. -->
			<VerticalStackLayout IsVisible="{Binding IsInitialLoading}"
                                 HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
				<ActivityIndicator IsRunning="{Binding IsInitialLoading}"
                                   Color="{StaticResource Primary}"
                                   HeightRequest="36" WidthRequest="36"/>
				<Label Text="Loading appointments..." FontSize="12"
                       TextColor="{StaticResource Gray400}"
                       HorizontalTextAlignment="Center"/>
			</VerticalStackLayout>

			<!-- CALENDAR VIEW -->
			<GraphicsView x:Name="CalendarGraphics"
                          IsVisible="{Binding IsCalendarView}"
                          Drawable="{Binding CalendarDrawable}"
                          HeightRequest="420"
                          VerticalOptions="Start"
                          BackgroundColor="White">
				<GraphicsView.GestureRecognizers>
					<TapGestureRecognizer Tapped="OnCalendarTapped"/>
				</GraphicsView.GestureRecognizers>
			</GraphicsView>

			<!-- FAB — Book Appointment (green, same style as Patient page) -->
			<Button Text="+ Book Appointment"
                    Command="{Binding GoToWalkInCommand}"
					Style="{StaticResource FabStyle}"
					VerticalOptions="End"
                    HorizontalOptions="End"
                    Margin="0,0,16,24"
                    ZIndex="5"
                    IsVisible="{Binding ShowDetail,
                        Converter={StaticResource InvertedBoolConverter}}"/>

		</Grid>

	</Grid>
</ContentPage>
