@{
    ViewData["Title"] = "Welcome";
}

<section style="background: linear-gradient(135deg, #2E7D32, #1B5E20); color: white; padding: 80px 0;">
    <div class="container text-center">
        <i class="bi bi-heart-pulse" style="font-size: 3rem;"></i>
        <h1 class="fw-bold mt-3">Welcome to MLC Dental Clinic</h1>
        <p class="lead mt-3 mb-4">Professional dental care you can trust. Book your appointment online in minutes.</p>
        <a href="/Booking" class="btn btn-light btn-lg px-5 fw-semibold">
            <i class="bi bi-calendar-plus me-2"></i>Book an Appointment
        </a>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <h2 class="text-center fw-bold mb-2">Our Services</h2>
        <div class="mx-auto mb-5 bg-gold-light"
             style="height: 4px; width: 60px; border-radius: 2px; background-color: var(--clinic-gold) !important;"></div>
        <div class="row g-4">
            @foreach (var service in new[] {
                        ("bi-clipboard2-pulse", "Consultation", "Comprehensive oral examination and assessment to evaluate the patient's overall dental health and treatment needs."),
                        ("bi-stars", "Teeth Cleaning", "Professional removal of plaque, tartar, and surface stains to promote optimal oral hygiene and periodontal health."),
                        ("bi-bandaid", "Tooth Extraction", "Clinical removal of teeth that are severely damaged, non-restorable, or otherwise indicated for extraction."),
                        ("bi-circle", "Dental Filling", "Restoration of teeth affected by dental caries or minor structural damage using appropriate restorative materials."),
                        ("bi-gem", "Dental Crown", "Custom-fitted restoration designed to protect, strengthen, and restore the function of damaged or weakened teeth."),
                        ("bi-braces", "Orthodontic Treatment", "Comprehensive treatment focused on correcting tooth alignment and improving dental occlusion through orthodontic appliances.")
                        })
            {
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm text-center p-4">
                        <i class="bi @service.Item1 text-primary mb-3" style="font-size: 2rem;"></i>
                        <h5 class="fw-semibold">@service.Item2</h5>
                        <p class="text-muted small">@service.Item3</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section style="background: var(--clinic-light, #EEF5EE);" class="py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h3 class="fw-bold">Ready to book your appointment?</h3>
                <p class="text-muted">Fill out a quick form and we'll confirm your schedule shortly.</p>
            </div>
            <div class="col-md-4 text-md-end">
                <a href="/Booking" class="btn btn-clinic btn-lg px-4">
                    <i class="bi bi-calendar-check me-2"></i>Book Now
                </a>
            </div>
        </div>
    </div>
</section>
