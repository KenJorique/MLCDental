@model DentalClinicBooking.ViewModels.BookingViewModel
@{
    ViewData["Title"] = "Book an Appointment";
    var tomorrow = DateTime.Now.AddDays(1).ToString("yyyy-MM-dd");
    var maxDate = DateTime.Now.AddDays(30).ToString("yyyy-MM-dd");
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="text-center mb-4">
                <i class="bi bi-calendar-plus text-primary"
                   style="font-size:2.5rem;"></i>
                <h2 class="fw-bold mt-2">Book an Appointment</h2>
                <p class="text-muted">
                    Fill in your details and we'll confirm your schedule.
                </p>
            </div>

            <div class="card border-0 shadow-sm p-4">
                <form asp-action="Index" method="post" id="bookingForm">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <ul class="mb-0">
                                @foreach (var error in ViewData.ModelState.Values
                                                            .SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <!-- Patient Information -->
                    <h6 class="fw-semibold text-muted text-uppercase mb-3"
                        style="font-size:.75rem;letter-spacing:1px">
                        Patient Information
                    </h6>

                    <div class="mb-3 position-relative">
                        <label asp-for="FullName"
                               class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control"
                               placeholder="e.g. Juan dela Cruz"
                               id="fullNameInput"
                               autocomplete="off" />
                        <span asp-validation-for="FullName"
                              class="text-danger small"></span>

                        <!-- Existing-patient name suggestions. Selecting one
                             only fills this field — phone/email/notes are
                             intentionally left untouched. -->
                        <div id="nameSuggestions"
                             class="list-group position-absolute w-100 shadow-sm d-none"
                             style="z-index:1000; top:100%;">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Phone" class="form-label fw-semibold"></label>
                            <input asp-for="Phone" class="form-control"
                                   placeholder="09XXXXXXXXX"
                                   maxlength="11"
                                   id="phoneInput"
                                   autocomplete="off" />
                            <div class="form-text text-muted">
                                Must start with 09, 11 digits
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                            <div id="phoneError" class="text-danger small d-none">
                                Phone must start with 09 and be 11 digits.
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email"
                                   class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control"
                                   placeholder="optional" />
                            <span asp-validation-for="Email"
                                  class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Appointment Details -->
                    <h6 class="fw-semibold text-muted text-uppercase mb-3"
                        style="font-size:.75rem;letter-spacing:1px">
                        Appointment Details
                    </h6>

                    <!-- Date picker -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Preferred Appointment Date
                        </label>
                        <input id="apptDate" name="apptDate" type="date"
                               class="form-control"
                               min="@tomorrow" max="@maxDate" />
                        <small class="text-muted">
                            Clinic is open Monday – Saturday.
                        </small>
                        <div id="dayFullAlert"
                             class="alert alert-danger mt-2 d-none">
                            <i class="bi bi-x-circle me-2"></i>
                            No time slots are available on this date. Please choose
                            another date.
                        </div>
                    </div>

                    <!-- Time slots -->
                    <div class="mb-4" id="timeSlotSection">
                        <label class="form-label fw-semibold">
                            Preferred Time Slot
                        </label>
                        <div id="timeSlotLoading" class="d-none">
                            <div class="spinner-border spinner-border-sm
                                        text-primary me-2"></div>
                            Checking availability...
                        </div>
                        <div id="timeSlotGrid"
                             class="row g-2 mt-1">
                            <!-- Slots rendered by JS -->
                        </div>
                        <div id="noDateSelected"
                             class="text-muted small">
                            Please select a date first to see
                            available time slots.
                        </div>
                        <div id="timeSlotError"
                             class="text-danger small d-none">
                            Please select a time slot.
                        </div>
                    </div>

                    <!-- Hidden fields -->
                    <input type="hidden" asp-for="AppointmentDate"
                           id="AppointmentDate" />

                    <!-- PH-local date/hour of the selected slot — used by the
                         server for a real-time re-check right before saving,
                         independent of how AppointmentDate above ends up
                         interpreted (UTC vs local) by model binding. -->
                    <input type="hidden" name="selectedDateStr" id="selectedDateStr" />
                    <input type="hidden" name="selectedHour" id="selectedHour" />

                    <div class="mb-4">
                        <label asp-for="Notes"
                               class="form-label fw-semibold"></label>
                        <textarea asp-for="Notes" class="form-control"
                                  rows="3"
                                  placeholder="Any concerns or requests...">
                        </textarea>
                        <span asp-validation-for="Notes"
                              class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" id="submitBtn"
                                class="btn btn-clinic btn-lg">
                            <i class="bi bi-send me-2"></i>Submit Booking
                        </button>
                    </div>

                </form>
            </div>

            <!-- Clinic info -->
            <div class="card border-0 border-start border-gold bg-light mt-3 p-3"
                 style="border-left-width: 4px !important;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-clock text-gold"></i>
                    <div>
                        <div class="fw-semibold small">Clinic Hours</div>
                        <div class="text-muted small">
                            Mon – Sat: 10:00 AM – 5:00 PM
                        </div>
                        <div class="text-muted small">Sunday: Closed</div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScripts")

    <script>
        const dateInput      = document.getElementById('apptDate');
        const hiddenDt       = document.getElementById('AppointmentDate');
        const selectedDateEl = document.getElementById('selectedDateStr');
        const selectedHourEl = document.getElementById('selectedHour');
        const dayFullAlert   = document.getElementById('dayFullAlert');
        const slotGrid       = document.getElementById('timeSlotGrid');
        const slotLoading    = document.getElementById('timeSlotLoading');
        const noDateSel      = document.getElementById('noDateSelected');
        const slotError      = document.getElementById('timeSlotError');
        const submitBtn      = document.getElementById('submitBtn');
        const phoneInput     = document.getElementById('phoneInput');
        const phoneError     = document.getElementById('phoneError');

        let selectedTime   = null;
        let isDayFull      = false;

        // ── Phone: plain input, digits-only formatting only.
        //    No lookup, no autofill — just basic format feedback. ──────
        phoneInput.addEventListener('input', function () {
            this.value = this.value.replace(/\D/g, '');

            if (this.value.length > 0 && !this.value.startsWith('09')) {
                phoneError.classList.remove('d-none');
                phoneError.textContent = 'Phone must start with 09';
            } else if (this.value.length > 0 && this.value.length !== 11) {
                phoneError.classList.remove('d-none');
                phoneError.textContent =
                    `Phone must be 11 digits (currently ${this.value.length})`;
            } else {
                phoneError.classList.add('d-none');
            }
        });

        // ── Date selection ────────────────────────────────────────────
        dateInput.addEventListener('change', async function () {
            const val = this.value;
            if (!val) return;

            // Block Sundays
            const d = new Date(val + 'T00:00:00');
            if (d.getDay() === 0) {
                alert('The clinic is closed on Sundays. Please pick another day.');
                this.value = '';
                resetSlots();
                return;
            }

            await loadAvailability(val);
        });

        async function loadAvailability(dateStr) {
            try {
                slotLoading.classList.remove('d-none');
                slotGrid.innerHTML = '';
                noDateSel.classList.add('d-none');
                dayFullAlert.classList.add('d-none');
                selectedTime = null;
                hiddenDt.value = '';
                selectedDateEl.value = '';
                selectedHourEl.value = '';

                // Pass date as Philippine local date (yyyy-MM-dd)
                const res  = await fetch(
                    `/Booking/GetAvailability?date=${dateStr}`);
                const data = await res.json();

                console.log('Availability:', data); // debug

                if (data.allFull) {
                    dayFullAlert.classList.remove('d-none');
                    slotGrid.innerHTML = '';
                    submitBtn.disabled = true;
                    isDayFull = true;
                } else {
                    dayFullAlert.classList.add('d-none');
                    isDayFull = false;
                    submitBtn.disabled = false;
                    renderSlots(dateStr, data.slots);
                }
            } catch (err) {
                console.error('Availability error:', err);
                slotGrid.innerHTML =
                    '<p class="text-danger small">Failed to load slots.</p>';
            } finally {
                slotLoading.classList.add('d-none');
            }
        }

        function renderSlots(dateStr, slots) {
            slotGrid.innerHTML = '';

            slots.forEach(slot => {
                const col = document.createElement('div');
                col.className = 'col-4';

                const btn = document.createElement('button');
                btn.type = 'button';

                if (slot.full) {
                    // Already booked & approved — unavailable, not clickable
                    btn.className = 'btn w-100 slot-btn disabled-slot';
                    btn.disabled  = true;
                    btn.innerHTML = `
                        <div class="fw-semibold">${slot.display}</div>
                        <div class="small">Unavailable</div>`;
                    btn.style.cursor = 'not-allowed';
                } else {
                    btn.className = 'btn w-100 slot-btn btn-outline-primary';
                    btn.innerHTML = `
                        <div class="fw-semibold">${slot.display}</div>
                        <div class="small text-muted">Available</div>`;

                    btn.addEventListener('click', () => {
                        document.querySelectorAll('.slot-btn').forEach(b => {
                            if (!b.disabled) {
                                b.classList.remove('btn-primary', 'active-slot');
                                b.classList.add('btn-outline-primary');
                            }
                        });

                        btn.classList.remove('btn-outline-primary');
                        btn.classList.add('btn-primary', 'active-slot');

                        selectedTime = slot.time;
                        slotError.classList.add('d-none');

                        const [hours, minutes] = slot.time.split(':');
                        const [year, month, day] = dateStr.split('-');

                        // month index is 0-based in JS Date constructor
                        const localDate = new Date(year, month - 1, day, hours, minutes, 0);

                        // .toISOString() outputs true UTC regardless of local settings
                        hiddenDt.value = localDate.toISOString();

                        // PH-local components, for the server's own recheck —
                        // sidesteps relying on how AppointmentDate's UTC string
                        // ends up interpreted by model binding.
                        selectedDateEl.value = dateStr;
                        selectedHourEl.value = hours;
                    });
                }

                col.appendChild(btn);
                slotGrid.appendChild(col);
            });
        }

        function resetSlots() {
            slotGrid.innerHTML   = '';
            selectedTime         = null;
            hiddenDt.value       = '';
            selectedDateEl.value = '';
            selectedHourEl.value = '';
            isDayFull            = false;
            submitBtn.disabled   = false;
            dayFullAlert.classList.add('d-none');
            noDateSel.classList.remove('d-none');
        }

        // ── Form submit validation ────────────────────────────────────
        document.getElementById('bookingForm')
            .addEventListener('submit', function (e) {

            let valid = true;

            const phone = phoneInput.value;
            if (!phone.startsWith('09') || phone.length !== 11) {
                phoneError.classList.remove('d-none');
                valid = false;
            }

            if (!selectedTime && !isDayFull) {
                slotError.classList.remove('d-none');
                valid = false;
            }

            if (isDayFull) {
                e.preventDefault();
                alert('No time slots are available on this date. Please select another date.');
                return;
            }

            if (!valid) e.preventDefault();
        });

        // Set default date to tomorrow, skip Sunday
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        if (tomorrow.getDay() === 0) tomorrow.setDate(tomorrow.getDate() + 1);
        dateInput.value = tomorrow.toISOString().split('T')[0];
        dateInput.dispatchEvent(new Event('change'));

        // ── Patient Name autocomplete ───────────────────────────────
        // The ONLY patient-suggestion feature on this form. Selecting a
        // suggestion fills FullName ONLY — phone/email/notes are left
        // exactly as the patient typed them.
        const fullNameInput   = document.getElementById('fullNameInput');
        const nameSuggestions = document.getElementById('nameSuggestions');
        let nameSearchTimeout = null;

        fullNameInput.addEventListener('input', function () {
            const query = this.value.trim();

            clearTimeout(nameSearchTimeout);

            if (query.length < 2) {
                hideNameSuggestions();
                return;
            }

            nameSearchTimeout = setTimeout(() => searchPatientNames(query), 300);
        });

        async function searchPatientNames(query) {
            try {
                const res   = await fetch(
                    `/Booking/SearchPatients?query=${encodeURIComponent(query)}`);
                const names = await res.json();

                if (!names || names.length === 0) {
                    hideNameSuggestions();
                    return;
                }

                nameSuggestions.innerHTML = '';
                names.forEach(name => {
                    const item = document.createElement('button');
                    item.type = 'button';
                    item.className = 'list-group-item list-group-item-action';
                    item.textContent = name;
                    item.addEventListener('click', () => {
                        // Name only — nothing else on the form is touched.
                        fullNameInput.value = name;
                        hideNameSuggestions();
                    });
                    nameSuggestions.appendChild(item);
                });

                nameSuggestions.classList.remove('d-none');
            } catch (err) {
                console.error('Name search error:', err);
                hideNameSuggestions();
            }
        }

        function hideNameSuggestions() {
            nameSuggestions.classList.add('d-none');
            nameSuggestions.innerHTML = '';
        }

        document.addEventListener('click', function (e) {
            if (e.target !== fullNameInput && !nameSuggestions.contains(e.target)) {
                hideNameSuggestions();
            }
        });
    </script>

    <style>
        .slot-btn {
            min-height: 60px;
            transition: all .2s;
        }

            .slot-btn:not(:disabled):hover {
                transform: translateY(-2px);
            }

        .disabled-slot {
            background: #C8C8C8 !important;
            border-color: #C8C8C8 !important;
            color: #111111 !important;
        }

            .disabled-slot .small {
                color: #191919 !important;
            }

        .active-slot {
            box-shadow: 0 0 0 3px rgba(46, 125, 50, .3);
        }
    </style>
}
